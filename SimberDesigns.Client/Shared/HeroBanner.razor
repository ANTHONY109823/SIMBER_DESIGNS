@inject SimberApi Api
@inject HttpClient Http
@implements IAsyncDisposable

<section class="hero-stage relative isolate overflow-hidden bg-ink text-cream"
         style="height: calc(100vh - 4.5rem); min-height: 28rem;">
    <div class="hero-bg absolute inset-0">
        <img src="@HeroBgUrl"
             alt="Vectores deportivos Simber Designs para sublimación"
             class="h-full w-full object-cover object-center"
             onerror="this.onerror=null;this.src='images/simber_designs_hero_banner.png';" />
    </div>
    <div class="hero-light-sweep pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-transparent md:via-ink/55"></div>

    <div class="hero-shift relative z-10 flex h-full max-w-6xl items-stretch px-4 py-3 sm:px-6 sm:py-4">
        <div class="hero-v-slot hidden shrink-0 md:block">
            <aside class="hero-v-carousel relative h-full w-full overflow-hidden rounded-2xl border border-gold/40 bg-ink/80 p-2 shadow-[0_0_28px_rgba(255,106,26,0.22)]"
                   aria-label="Carrusel del inicio"
                   aria-live="off">
                <div class="hero-v-glow pointer-events-none absolute inset-0 z-[1] rounded-2xl" aria-hidden="true"></div>
                <div class="relative z-0 h-full overflow-hidden rounded-xl">
                    <div class="hero-v-track flex h-full flex-col @(_noTransition ? "hero-v-track--snap" : null)"
                         style="transform: translate3d(0, -@(Active * 100)%, 0);">
                        @foreach (var url in LoopSlides)
                        {
                            <div class="hero-v-card block h-full w-full shrink-0 overflow-hidden rounded-xl border border-white/15 bg-ink">
                                <img src="@url" alt="" class="h-full w-full object-cover" loading="lazy" />
                            </div>
                        }
                    </div>
                </div>
            </aside>
        </div>

        <div class="flex min-w-0 flex-1 flex-col justify-center pl-5 sm:pl-8 lg:pl-10">
            <div class="max-w-xl lg:max-w-2xl">
                <p class="text-sm font-semibold uppercase tracking-[0.28em] text-gold sm:text-base lg:text-lg">@T("home.hero.eyebrow", "Vectores · Sublimación · Wireframe")</p>
                <h1 class="mt-4 max-w-xl font-serif text-4xl leading-none sm:text-5xl lg:text-6xl">@T("home.hero.title", "Del patrón a la camiseta en menos de tres clics.")</h1>
                <p class="mt-6 max-w-lg text-sm text-cream/80 sm:text-base">@T("home.hero.desc", "Catálogo CDR y programas para CorelDRAW e Illustrator.")</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/catalog" class="rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink hover:bg-orange-400">Ver catálogo</a>
                    <a href="/programas" class="rounded-full border border-white/20 px-6 py-3 text-sm text-cream hover:border-gold/50">Programas</a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int CarouselSlots = 6;
    private const int SlideMs = 3200;
    private const int TransitionMs = 750;

    private Dictionary<string, string> _c = new();
    private List<string> Previews = [];
    private List<string> LoopSlides = [];
    private int Active;
    private bool _noTransition;
    private CancellationTokenSource? _cts;
    private bool _loopStarted;

    private static readonly string[] FallbackUrls =
    [
        "https://images.unsplash.com/photo-1517466787929-bc90951d0974?w=400&h=520&fit=crop&q=70",
        "https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=400&h=520&fit=crop&q=70",
        "https://images.unsplash.com/photo-1556906781-9a412961c28c?w=400&h=520&fit=crop&q=70",
        "https://images.unsplash.com/photo-1461896836934-ffe607ba6851?w=400&h=520&fit=crop&q=70",
        "https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?w=400&h=520&fit=crop&q=70",
        "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=400&h=520&fit=crop&q=70"
    ];

    private string T(string key, string fallback)
        => _c.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;

    private string CmsBust =>
        _c.TryGetValue("cms.bust", out var b) && !string.IsNullOrWhiteSpace(b) ? b : "1";

    private string HeroBgUrl => $"/api/content/asset/hero-banner?v={CmsBust}";

    private string CarouselAsset(int n) => $"/api/content/asset/hero-carousel-{n}?v={CmsBust}";

    protected override async Task OnInitializedAsync()
    {
        try { _c = await Api.GetContentAsync(); } catch { _c = new(); }

        var urls = new List<string>();
        for (var i = 1; i <= CarouselSlots; i++)
        {
            var url = CarouselAsset(i);
            if (await AssetExistsAsync(url))
                urls.Add(url);
        }

        Previews = urls.Count > 0 ? urls : FallbackUrls.ToList();
        // Duplicado: al llegar al final se anima al clon y luego se resetea sin salto
        LoopSlides = Previews.Concat(Previews).ToList();
    }

    private async Task<bool> AssetExistsAsync(string url)
    {
        try
        {
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            using var resp = await Http.SendAsync(req, HttpCompletionOption.ResponseHeadersRead);
            return resp.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_loopStarted || Previews.Count < 2) return;
        _loopStarted = true;
        _ = RunSlideLoopAsync();
    }

    private async Task RunSlideLoopAsync()
    {
        _cts = new CancellationTokenSource();
        var n = Previews.Count;
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                await Task.Delay(SlideMs, _cts.Token);
                Active++;
                await InvokeAsync(StateHasChanged);

                // Llegó al clon del primer slide → reset invisible al índice 0
                if (Active >= n)
                {
                    await Task.Delay(TransitionMs, _cts.Token);
                    _noTransition = true;
                    Active = 0;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(40, _cts.Token);
                    _noTransition = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is null) return;
        await _cts.CancelAsync();
        _cts.Dispose();
        _cts = null;
    }
}
