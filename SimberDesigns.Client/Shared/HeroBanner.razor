@inject SimberApi Api

<section class="relative isolate min-h-[78vh] overflow-hidden bg-ink text-cream">
    <img src="images/simber_designs_hero_banner.png"
         alt="Vectores deportivos Simber Designs para sublimación"
         class="absolute inset-0 h-full w-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/75 to-ink/10"></div>
    <div class="relative mx-auto flex min-h-[78vh] max-w-6xl flex-col justify-end px-6 py-16 sm:justify-center sm:py-24">
        <p class="text-xs uppercase tracking-[0.35em] text-gold">Vectores · Sublimación · Wireframe</p>
        <h1 class="mt-4 max-w-xl font-serif text-4xl leading-none sm:text-6xl">Del patrón a la camiseta en menos de tres clics.</h1>
        <p class="mt-6 max-w-lg text-sm text-cream/80 sm:text-base">Catálogo de vectores para sublimación y el programa que arma uniformes en CorelDRAW e Illustrator. Paga el mes, actívalo en tu PC y lee listas con IA ilimitada.</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/recargar" class="rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink hover:bg-orange-400">Suscríbete — S/@(PricePen.ToString("0"))/mes · IA incluida</a>
            <a href="/catalog" class="rounded-full border border-white/20 px-6 py-3 text-sm text-cream hover:border-gold/50">Ver catálogo</a>
        </div>
    </div>
</section>

@code {
    private decimal PricePen = 56;

    protected override async Task OnInitializedAsync()
    {
        var store = await Api.GetStorefrontAsync();
        if (store is not null && store.PluginMonthPricePen > 0)
            PricePen = store.PluginMonthPricePen;
    }
}
