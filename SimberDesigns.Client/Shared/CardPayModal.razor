@implements IDisposable
@inject SimberApi Api
@inject IJSRuntime JS

@* Pago en la misma web (Mercado Pago). Tarjeta con Brick (tokeniza en el navegador) o
   Yape con celular + código OTP. Los datos sensibles nunca pasan por nuestro servidor. *@
@if (_show)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/70 p-4 backdrop-blur-sm" @onclick="Close">
        <div class="mt-10 w-full max-w-md rounded-3xl border border-white/10 bg-ink p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-wider text-gold">Pago seguro</p>
                    <h3 class="mt-1 font-serif text-xl text-white">@_label</h3>
                    <p class="mt-1 text-2xl font-bold text-emerald-300">S/ @_amount.ToString("0.00")</p>
                </div>
                @if (!MustCopy)
                {
                    <button type="button" @onclick="Close" class="rounded-full p-2 text-cream/60 hover:bg-white/10 hover:text-white">✕</button>
                }
            </div>

            @if (_status == "approved" && _kind.StartsWith("plugin"))
            {
                <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5">
                    <p class="text-center text-lg font-semibold text-emerald-300">¡Pago aprobado!</p>

                    @if (string.IsNullOrEmpty(_chosenProgram))
                    {
                        <p class="mt-3 text-center text-sm text-cream/80">¿Para qué programa quieres tu serial?</p>
                        <div class="mt-3 grid grid-cols-2 gap-2">
                            <button type="button" disabled="@_assignBusy" @onclick='() => ChooseProgram("Corel")'
                                    class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 py-3 text-sm font-semibold text-white hover:bg-emerald-500/15 disabled:opacity-50">CorelDRAW</button>
                            <button type="button" disabled="@_assignBusy" @onclick='() => ChooseProgram("Illustrator")'
                                    class="rounded-xl border border-orange-500/30 bg-orange-500/5 py-3 text-sm font-semibold text-white hover:bg-orange-500/15 disabled:opacity-50">Illustrator</button>
                        </div>
                        <p class="mt-2 text-center text-xs text-cream/50">Elige bien: el serial quedará amarrado a ese programa.</p>
                        @if (!string.IsNullOrWhiteSpace(_msg2))
                        {
                            <p class="mt-2 text-center text-sm text-rose-400">@_msg2</p>
                        }
                    }
                    else
                    {
                        <p class="mt-3 text-center text-xs uppercase tracking-wider text-cream/45">Tu serial · @_chosenProgram</p>
                        <p class="mt-1 select-all text-center font-mono text-xl tracking-widest text-emerald-300">@_serial</p>
                        <div class="mt-3 grid gap-2">
                            <button type="button" @onclick="CopySerial" class="rounded-xl bg-gold py-2.5 text-sm font-semibold text-ink hover:bg-orange-400">
                                @(_copied ? "✓ Serial copiado" : "Copiar serial")
                            </button>
                            <a href="@DownloadHref" target="_blank" rel="noopener" download data-enhance-nav="false"
                               class="rounded-xl border border-white/15 py-2.5 text-center text-sm font-semibold text-white hover:bg-white/10">
                                Descargar @_chosenProgram
                            </a>
                        </div>
                        <p class="mt-3 text-xs text-cream/60">1) Copia tu serial · 2) Descarga y abre @_chosenProgram · 3) Inicia sesión con tu cuenta · 4) Pega el serial cuando el programa te lo pida.</p>
                        @if (_copied)
                        {
                            <button type="button" @onclick="Close" class="mt-3 w-full rounded-full border border-white/15 py-2.5 text-sm text-white hover:bg-white/10">Cerrar</button>
                        }
                        else
                        {
                            <p class="mt-3 text-center text-xs text-amber-300">Copia tu serial antes de cerrar.</p>
                        }
                    }
                </div>
            }
            else if (_status == "approved")
            {
                <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5 text-center">
                    <p class="text-lg font-semibold text-emerald-300">¡Pago aprobado!</p>
                    <p class="mt-2 text-sm text-cream/80">@_msg</p>
                    <button type="button" @onclick="Close" class="mt-4 inline-flex rounded-full bg-gold px-6 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400">Cerrar</button>
                </div>
            }
            else if (_status == "pending")
            {
                <div class="mt-6 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-5 text-center">
                    <p class="text-lg font-semibold text-amber-300">Pago en revisión</p>
                    <p class="mt-2 text-sm text-cream/80">@_msg</p>
                    <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                        <button type="button" disabled="@_checkBusy" @onclick="VerifyPending"
                                class="inline-flex rounded-full bg-gold px-6 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                            @(_checkBusy ? "Verificando…" : "Verificar pago")
                        </button>
                        <button type="button" @onclick="Close"
                                class="inline-flex rounded-full border border-white/15 px-6 py-2.5 text-sm text-white hover:bg-white/10">Cerrar</button>
                    </div>
                    <p class="mt-3 text-[11px] text-cream/50">No generes otro código Yape mientras esté en revisión.</p>
                </div>
            }
            else if (_status == "rejected")
            {
                <div class="mt-6 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-5 text-center">
                    <p class="text-lg font-semibold text-rose-300">Pago rechazado</p>
                    <p class="mt-2 text-sm text-cream/80">@_msg</p>
                    <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                        <button type="button" @onclick='() => RetryWith("tarjeta")'
                                class="inline-flex rounded-full bg-gold px-6 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400">Pagar con tarjeta</button>
                        <button type="button" @onclick="Close"
                                class="inline-flex rounded-full border border-white/15 px-6 py-2.5 text-sm text-white hover:bg-white/10">Cerrar</button>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-5 grid grid-cols-2 gap-2">
                    <button type="button" @onclick='() => SetMethod("tarjeta")' class="@MethodClass("tarjeta")">💳 Tarjeta</button>
                    <button type="button" @onclick='() => SetMethod("yape")' class="@MethodClass("yape")">📱 Yape</button>
                </div>

                @if (_method == "tarjeta")
                {
                    <div id="mp-brick" class="mt-4"></div>
                }
                else
                {
                    <div class="mt-4 space-y-3">
                        <div class="rounded-2xl border border-fuchsia-500/25 bg-fuchsia-500/5 px-4 py-3 text-xs text-cream/75">
                            Abre tu app <span class="font-semibold text-fuchsia-300">Yape</span> → menú <span class="font-semibold">“Yape en Web” / “Aprobar compras por internet”</span> y copia el <span class="font-semibold">código de aprobación de 6 dígitos</span>.
                        </div>
                        <label class="block text-sm">
                            <span class="text-cream/70">Celular Yape</span>
                            <input @bind="_yapePhone" inputmode="numeric" maxlength="9" placeholder="9XXXXXXXX"
                                   class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2.5 text-white outline-none focus:border-fuchsia-400/60" />
                        </label>
                        <label class="block text-sm">
                            <span class="text-cream/70">Código de aprobación (6 dígitos)</span>
                            <input @bind="_yapeOtp" inputmode="numeric" maxlength="6" placeholder="123456"
                                   class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2.5 font-mono tracking-widest text-white outline-none focus:border-fuchsia-400/60" />
                        </label>
                        <button type="button" disabled="@_yapeBusy" @onclick="PayYape"
                                class="w-full rounded-xl bg-fuchsia-500 py-3 text-sm font-semibold text-white hover:bg-fuchsia-400 disabled:opacity-60">
                            @(_yapeBusy ? "Procesando…" : $"Pagar S/ {_amount:0.00} con Yape")
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_msg))
                {
                    <p class="mt-3 text-center text-sm text-rose-400">@_msg</p>
                }
                <p class="mt-3 text-center text-[11px] text-cream/50">Tus datos los procesa Mercado Pago de forma segura. No los guardamos.</p>
            }
        </div>
    </div>
}

@code {
    private DotNetObjectReference<CardPayModal>? _selfRef;
    private string _publicKey = "";
    public bool CardEnabled { get; private set; }

    private bool _show;
    private bool _rendered;
    private string _method = "tarjeta";
    private string _kind = "";
    private int? _months;
    private Guid? _packageId;
    private decimal _amount;
    private string _label = "";
    private string _status = "";
    private string? _msg;

    private string _yapePhone = "";
    private string _yapeOtp = "";
    private bool _yapeBusy;
    private Guid _pendingTxId;
    private bool _checkBusy;
    private CancellationTokenSource? _pollCts;

    // Post-pago de un plan: elegir programa (fija la edición del serial) + copiar serial obligado.
    private string? _serial;
    private string _chosenProgram = "";
    private bool _copied;
    private bool _assignBusy;
    private string? _msg2;

    private bool MustCopy =>
        _status == "approved" && _kind.StartsWith("plugin") && !string.IsNullOrEmpty(_chosenProgram) && !_copied;

    private string DownloadHref =>
        _chosenProgram == "Corel" ? "/api/plugin/download/corel" : "/api/plugin/download/illustrator";

    /// <summary>Callback opcional que la página escucha cuando el pago se aprueba (p. ej. refrescar saldo).</summary>
    [Parameter] public EventCallback OnApproved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            var cfg = await Api.GetPaymentConfigAsync();
            _publicKey = cfg?.PublicKey ?? "";
            CardEnabled = cfg?.CardEnabled == true && !string.IsNullOrWhiteSpace(_publicKey);
        }
        catch { CardEnabled = false; }
    }

    public void Open(string kind, int? months, Guid? packageId, decimal amount, string label)
    {
        _kind = kind;
        _months = months;
        _packageId = packageId;
        _amount = amount;
        _label = label;
        _status = "";
        _msg = null;
        _method = "tarjeta";
        _yapePhone = "";
        _yapeOtp = "";
        _pendingTxId = Guid.Empty;
        _checkBusy = false;
        StopPoll();
        _serial = null;
        _chosenProgram = "";
        _copied = false;
        _assignBusy = false;
        _msg2 = null;
        _rendered = false;
        _show = true;
        StateHasChanged();
    }

    // Post-pago (plan): fija el programa del serial y muestra el serial para copiar.
    private async Task ChooseProgram(string prog)
    {
        _msg2 = null;
        _assignBusy = true;
        StateHasChanged();
        try
        {
            if (!string.IsNullOrWhiteSpace(_serial))
            {
                await Api.AssignSerialEditionAsync(_serial, prog);
            }
            _chosenProgram = prog;
        }
        catch (Exception ex)
        {
            _msg2 = ex.Message;
        }
        finally
        {
            _assignBusy = false;
            StateHasChanged();
        }
    }

    private async Task CopySerial()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _serial ?? ""); }
        catch { /* si el navegador bloquea el portapapeles, el serial está visible y es seleccionable */ }
        _copied = true;
        StateHasChanged();
    }

    private async Task SetMethod(string m)
    {
        if (_method == m) return;
        _method = m;
        _msg = null;
        _rendered = false;
        // Al salir de tarjeta desmontamos el Brick; al volver, OnAfterRender lo re-crea.
        try { await JS.InvokeVoidAsync("simberMp.destroy"); } catch { }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_show && _method == "tarjeta" && !_rendered && _status == "")
        {
            _rendered = true;
            try
            {
                await JS.InvokeVoidAsync("simberMp.render", _publicKey, (double)_amount, "mp-brick", _selfRef);
            }
            catch (Exception ex)
            {
                _msg = ex.Message;
                StateHasChanged();
            }
        }
    }

    private async Task Close()
    {
        // Obliga a copiar el serial antes de cerrar (para que no lo pierda).
        if (MustCopy)
        {
            return;
        }
        StopPoll();
        _show = false;
        _rendered = false;
        _status = "";
        _msg = null;
        try { await JS.InvokeVoidAsync("simberMp.destroy"); } catch { }
        StateHasChanged();
    }

    // ——— Tarjeta (Brick) ———
    [JSInvokable]
    public async Task<string> OnBrickSubmit(string formDataJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(formDataJson);
            var root = doc.RootElement;
            var token = root.TryGetProperty("token", out var t) ? t.GetString() ?? "" : "";
            var pmId = root.TryGetProperty("payment_method_id", out var pm) ? pm.GetString() ?? "" : "";
            string? issuer = root.TryGetProperty("issuer_id", out var iss) && iss.ValueKind is not System.Text.Json.JsonValueKind.Null
                ? iss.ToString()
                : null;
            var installments = root.TryGetProperty("installments", out var ins) && ins.ValueKind == System.Text.Json.JsonValueKind.Number
                ? ins.GetInt32()
                : 1;
            string? email = null;
            if (root.TryGetProperty("payer", out var payer)
                && payer.ValueKind == System.Text.Json.JsonValueKind.Object
                && payer.TryGetProperty("email", out var em))
            {
                email = em.GetString();
            }

            return await CompletePayment(token, pmId, issuer, installments, email);
        }
        catch (Exception ex)
        {
            _status = "error";
            _msg = ex.Message;
            StateHasChanged();
            return System.Text.Json.JsonSerializer.Serialize(new { status = "error" });
        }
    }

    [JSInvokable]
    public void OnBrickError(string message)
    {
        _msg = message;
        StateHasChanged();
    }

    // ——— Yape ———
    private async Task PayYape()
    {
        _msg = null;
        var phone = (_yapePhone ?? "").Trim();
        var otp = (_yapeOtp ?? "").Trim();
        if (phone.Length < 9 || otp.Length < 6)
        {
            _msg = "Ingresa tu celular Yape (9 dígitos) y el código de aprobación (6 dígitos).";
            StateHasChanged();
            return;
        }

        _yapeBusy = true;
        StateHasChanged();
        try
        {
            var token = await JS.InvokeAsync<string>("simberMp.yape", _publicKey, phone, otp);
            if (string.IsNullOrWhiteSpace(token))
            {
                _msg = "No se pudo validar Yape. Revisa el celular y genera un código nuevo en la app.";
                return;
            }

            await CompletePayment(token, "yape", null, 1, null);
        }
        catch (Exception ex)
        {
            _msg = CleanYapeError(ex.Message);
        }
        finally
        {
            _yapeBusy = false;
            StateHasChanged();
        }
    }

    private static string CleanYapeError(string raw)
    {
        if (raw.Contains("otp", StringComparison.OrdinalIgnoreCase))
            return "El código de aprobación no es válido o venció. Genera uno nuevo en tu app Yape.";
        return "No se pudo procesar Yape. Verifica el celular y el código, e inténtalo de nuevo.";
    }

    // Común a tarjeta y Yape: crea el pago en el servidor y actualiza el estado del modal.
    private async Task<string> CompletePayment(string token, string paymentMethodId, string? issuerId, int installments, string? email)
    {
        var res = await Api.PayWithCardAsync(_kind, _months, _packageId, token, paymentMethodId, issuerId, installments, email);
        _status = res.Status;
        _msg = res.Message;
        _serial = res.Serial;
        _pendingTxId = res.TransactionId;
        StateHasChanged();
        if (res.Status == "approved" && OnApproved.HasDelegate)
        {
            await OnApproved.InvokeAsync();
        }
        else if (res.Status == "pending" && res.TransactionId != Guid.Empty)
        {
            _ = PollPendingAsync(res.TransactionId);
        }
        return System.Text.Json.JsonSerializer.Serialize(new { status = res.Status });
    }

    private async Task VerifyPending()
    {
        if (_pendingTxId == Guid.Empty || _checkBusy) return;
        _checkBusy = true;
        _msg = "Consultando Mercado Pago…";
        StateHasChanged();
        try
        {
            var res = await Api.CheckPaymentStatusAsync(_pendingTxId);
            ApplyStatus(res);
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _checkBusy = false;
            StateHasChanged();
        }
    }

    private void RetryWith(string method)
    {
        StopPoll();
        _status = "";
        _msg = null;
        _serial = null;
        _pendingTxId = Guid.Empty;
        _method = method;
        _yapeOtp = "";
        _rendered = false;
        StateHasChanged();
        _ = ResetBrickAsync();
    }

    private async Task ResetBrickAsync()
    {
        try { await JS.InvokeVoidAsync("simberMp.destroy"); } catch { }
        StateHasChanged();
    }

    private async Task PollPendingAsync(Guid txId)
    {
        StopPoll();
        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;
        try
        {
            // Hasta ~45 s: MP a veces pasa de in_process → rejected/approved sin avisar al modal.
            for (var i = 0; i < 9 && !ct.IsCancellationRequested; i++)
            {
                await Task.Delay(5000, ct);
                if (ct.IsCancellationRequested || _status != "pending") return;
                try
                {
                    var res = await Api.CheckPaymentStatusAsync(txId);
                    if (res.Status is "approved" or "rejected")
                    {
                        ApplyStatus(res);
                        return;
                    }
                    _msg = res.Message;
                    StateHasChanged();
                }
                catch { /* el usuario puede pulsar Verificar */ }
            }
        }
        catch (TaskCanceledException) { }
    }

    private void ApplyStatus(CardPaymentResponse res)
    {
        _status = res.Status;
        _msg = res.Message;
        _serial = res.Serial;
        _pendingTxId = res.TransactionId;
        if (res.Status != "pending") StopPoll();
        if (res.Status == "approved" && OnApproved.HasDelegate)
            _ = OnApproved.InvokeAsync();
        StateHasChanged();
    }

    private void StopPoll()
    {
        try { _pollCts?.Cancel(); } catch { }
        try { _pollCts?.Dispose(); } catch { }
        _pollCts = null;
    }

    private string MethodClass(string m) => _method == m
        ? "rounded-xl border border-gold bg-gold/15 py-2.5 text-sm font-semibold text-white"
        : "rounded-xl border border-white/10 bg-white/[0.02] py-2.5 text-sm text-cream/70 hover:bg-white/[0.06]";

    public void Dispose()
    {
        StopPoll();
        _selfRef?.Dispose();
    }
}
