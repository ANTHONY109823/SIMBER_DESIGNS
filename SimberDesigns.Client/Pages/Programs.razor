@page "/programas"
@inject SimberApi Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Programas · Simber Designs</PageTitle>

<section class="relative overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-orange-600/15 via-ink to-cyan/10"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:py-20">
        <div>
            <p class="inline-flex rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-gold">
                @T("programas.badge", "Herramienta · CorelDRAW e Illustrator")
            </p>
            <h1 class="mt-4 font-serif text-4xl leading-tight text-white sm:text-5xl">
                Simber <span class="text-gold">Designs</span>
            </h1>
            <p class="mt-4 text-lg text-cream/85">
                @T("programas.desc", "Arma mockups, nombres y dorsales en CorelDRAW e Illustrator.")
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                @if (HasCorel)
                {
                    <a href="/api/plugin/download/corel" target="_blank" rel="noopener" download data-enhance-nav="false"
                       class="inline-flex min-h-11 items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-900/40 transition hover:brightness-110"
                       style="background:#00A651;">
                        Descargar para CorelDRAW
                    </a>
                }
                else
                {
                    <span class="inline-flex min-h-11 items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white/50"
                          style="background:#00A65166;" title="Aún no disponible">
                        Descargar para CorelDRAW
                    </span>
                }
                @if (HasIllustrator)
                {
                    <a href="/api/plugin/download/illustrator" target="_blank" rel="noopener" download data-enhance-nav="false"
                       class="inline-flex min-h-11 items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-900/40 transition hover:brightness-110"
                       style="background:#FF9A00;">
                        Descargar para Illustrator
                    </a>
                }
                else
                {
                    <span class="inline-flex min-h-11 items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white/50"
                          style="background:#FF9A0066;" title="Aún no disponible">
                        Descargar para Illustrator
                    </span>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-orange-950/40">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                <span class="ml-2 text-xs text-cream/70">SIMBER DESIGNS · CorelDRAW / Illustrator</span>
            </div>
            @if (_loaded)
            {
                <img src="@HeroMockupSrc" alt="Vista del programa Simber Designs" class="h-72 w-full object-cover sm:h-80" />
            }
            else
            {
                <div class="h-72 w-full animate-pulse bg-white/[0.04] sm:h-80"></div>
            }
        </div>
    </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="mb-8">
        <h2 class="font-serif text-3xl text-white">@T("programas.flow.title", "Cómo se ve trabajando")</h2>
        <p class="mt-2 text-sm text-cream/80">@T("programas.flow.desc", "El flujo real: lees la lista, tomas los moldes y el programa arma y acomoda solo en CorelDRAW o Illustrator, con nombres y dorsales.")</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-5">
        <figure class="relative lg:col-span-3 aspect-video overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-orange-600/25 via-ink to-ink">
            <img src="@Asset("prog-armado")" alt="@(T("programas.armado.title", "Armado automático"))" onerror="this.style.display='none'"
                 class="absolute inset-0 h-full w-full object-cover" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-5 py-4">
                <p class="text-base font-bold text-white">@T("programas.armado.title", "Armado automático en CorelDRAW / Illustrator")</p>
                <p class="text-xs text-cream/80">@T("programas.armado.desc", "Duplica el molde por jugador, pone nombre y dorsal y acomoda en bloques.")</p>
            </figcaption>
        </figure>

        <div class="lg:col-span-2 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
            @if (HasVideo)
            {
                <video class="aspect-video w-full bg-black object-cover" controls preload="none" poster="@VideoPoster">
                    <source src="@DemoVideoSrc" type="video/mp4" />
                </video>
            }
            else
            {
                <div class="flex aspect-video w-full items-center justify-center bg-black/70">
                    <img src="@VideoPoster" alt="" onerror="this.style.display='none'" class="h-full w-full object-cover" />
                </div>
            }
            <p class="px-4 py-3 text-xs text-cream/75">@T("programas.video.caption", "Video del flujo (si está subido en Programas).")</p>
        </div>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var shot in Gallery)
        {
            <figure class="relative h-44 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
                <img src="@shot.Src" alt="@shot.Alt" onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-cover" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-4 py-3 text-xs font-semibold text-white">@shot.Caption</figcaption>
            </figure>
        }
    </div>
</section>

<section id="funciones" class="border-y border-white/10 bg-white/[0.03]">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="font-serif text-3xl text-white">@T("programas.features.title", "Funciones")</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in Features)
            {
                <article class="rounded-2xl border border-white/10 bg-ink/70 p-6">
                    <h3 class="text-lg font-semibold text-white">@feature.Title</h3>
                    <p class="mt-2 text-sm text-cream/80">@feature.Detail</p>
                </article>
            }
        </div>
    </div>
</section>

<section id="planes" class="border-t border-white/10 bg-ink/80">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h2 class="text-center font-serif text-3xl text-white">Planes de programas</h2>
        <p class="mx-auto mt-2 max-w-xl text-center text-sm text-cream/70">
            Desde <span class="font-semibold text-gold">US$12/mes</span>. Mientras más meses, más descuento. Al pagar recibes tu serial para activar CorelDRAW o Illustrator.
        </p>

        <div class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-3">
            @foreach (var plan in ThreePlans)
            {
                var m = plan.Months;
                <article class="relative flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center @(plan.DiscountPercent > 0 ? "ring-1 ring-emerald-500/20" : "")">
                    @if (plan.DiscountPercent > 0)
                    {
                        <span class="absolute right-3 top-3 rounded-full bg-emerald-500/20 px-2.5 py-1 text-[11px] font-bold text-emerald-300">−@plan.DiscountPercent%</span>
                    }
                    <p class="text-sm text-cream/70">@plan.Label</p>
                    <p class="mt-2 font-serif text-4xl text-gold">$@plan.PriceUsd.ToString("0.##")</p>
                    <p class="mt-1 text-xs text-cream/45">S/ @plan.PricePen.ToString("0.00")</p>
                    @if (m > 1)
                    {
                        <p class="mt-1 text-xs font-semibold text-emerald-300">$@((plan.PriceUsd / m).ToString("0.##"))/mes</p>
                    }
                    <button type="button" disabled="@Busy" @onclick="() => StartPay(m)"
                            class="mt-5 w-full rounded-full bg-gold py-2.5 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                        @(isAuthenticated ? "Comprar" : "Regístrate y compra")
                    </button>
                </article>
            }
        </div>
        <p class="mx-auto mt-4 max-w-xl text-center text-xs text-cream/45">Un pago activa 1 PC. CorelDRAW e Illustrator se activan por separado; eliges el programa con tu serial.</p>
        @if (!string.IsNullOrWhiteSpace(PayMsg))
        {
            <p class="mt-4 text-center text-sm @(PayOk ? "text-emerald-300" : "text-rose-400")">@PayMsg</p>
        }
    </div>
</section>

<CardPayModal @ref="_payModal" />

@code {
    private Dictionary<string, string> _c = new();
    private bool HasVideo => _c.ContainsKey("asset.prog-video");
    private string DemoVideoSrc => Asset("prog-video");
    private bool HasCorel;
    private bool HasIllustrator;
    private bool _loaded;
    private bool isAuthenticated;
    private decimal MonthPricePen;
    private List<PluginPlanOptionDto> Plans = [];
    private bool Busy;
    private string? PayMsg;
    private bool PayOk;

    // Pago con tarjeta en la misma web (Bricks)
    private CardPayModal? _payModal;

    private string T(string key, string fallback)
        => _c.TryGetValue(key, out var v) ? v : fallback;

    private string CmsBust =>
        _c.TryGetValue("cms.bust", out var b) && !string.IsNullOrWhiteSpace(b) ? b : "1";

    private string Asset(string key) => $"/api/content/asset/{key}?v={CmsBust}";

    private string VideoPoster => Asset("prog-video-poster");

    // Imagen del mockup del hero: propia ("prog-hero"); si no se subió, usa la del paso 1 como respaldo.
    private string HeroMockupSrc => _c.ContainsKey("asset.prog-hero") ? Asset("prog-hero") : Asset("prog-1");

    protected override async Task OnInitializedAsync()
    {
        try { _c = await Api.GetContentAsync(); } catch { _c = new(); }
        _loaded = true;                       // ya sabemos qué imagen mostrar (sin parpadeo del paso 1)
        StateHasChanged();

        var store = await Api.GetStorefrontAsync();
        HasCorel = store?.HasCorelDownload == true;
        HasIllustrator = store?.HasIllustratorDownload == true;
        MonthPricePen = store?.PluginMonthPricePen ?? 0;
        Plans = store?.PluginPlans ??
        [
            new(1, 30, MonthPricePen, "1 mes (30 días)", 12m, 0),
            new(3, 90, Math.Round(MonthPricePen * 3 * 0.9m, 2), "3 meses (90 días)", 32.40m, 10),
            new(6, 180, Math.Round(MonthPricePen * 6 * 0.8m, 2), "6 meses (180 días)", 57.60m, 20)
        ];

        var auth = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
    }

    private IEnumerable<PluginPlanOptionDto> ThreePlans =>
        Plans.Where(p => p.Months is 1 or 3 or 6).OrderBy(p => p.Months);

    // Sin sesión → a registrarse y pagar. Con sesión → formulario de pago (tarjeta/Yape) en la web.
    private async Task StartPay(int months)
    {
        if (!isAuthenticated)
        {
            Nav.NavigateTo("/register?returnUrl=/programas%23planes");
            return;
        }

        var plan = Plans.FirstOrDefault(p => p.Months == months);
        if (_payModal is { CardEnabled: true })
        {
            var amount = plan?.PricePen ?? MonthPricePen * months;
            var label = $"Plan Simber · {plan?.Label ?? $"{months} mes(es)"}";
            _payModal.Open("plugin", months, null, amount, label);
            return;
        }

        await Pay("plugin", months);
    }

    private async Task Pay(string kind, int months)
    {
        PayMsg = null; PayOk = false; Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, null, null, months);
            if (string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                PayMsg = "No se pudo abrir Mercado Pago. Inténtalo de nuevo.";
                return;
            }
            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex) { PayMsg = ex.Message; }
        finally { Busy = false; }
    }

    private IEnumerable<FeatureItem> Features =>
    [
        new(T("programas.feature1.title", "Armado automático"),
            T("programas.feature1.desc", "Duplica el molde por jugador y acomoda las piezas en bloques, listo para producir.")),
        new(T("programas.feature2.title", "Nombres y dorsales"),
            T("programas.feature2.desc", "Toma la lista y rellena nombre y número conservando la tipografía del molde.")),
        new(T("programas.feature3.title", "Corel e Illustrator"),
            T("programas.feature3.desc", "Trabaja dentro de tu programa; tú solo exportas e imprimes como siempre.")),
        new(T("programas.feature4.title", "Lectura con IA"),
            T("programas.feature4.desc", "Lee la lista de jugadores desde una foto o un archivo, sin teclear.")),
        new(T("programas.feature5.title", "Aprovecha la tela"),
            T("programas.feature5.desc", "Acomoda las piezas al ancho de tu rollo y en bloques para desperdiciar menos.")),
        new(T("programas.feature6.title", "Login + pago"),
            T("programas.feature6.desc", "Descargas gratis; eliges 1, 3 o 6 meses (desde $12/mes), pagas en la web y pegas el serial en el programa."))
    ];

    private IEnumerable<GalleryShot> Gallery =>
    [
        new(Asset("prog-1"), "Paso 1", T("programas.step1.caption", "1 · Pegas o subes la lista (o foto con IA)")),
        new(Asset("prog-2"), "Paso 2", T("programas.step2.caption", "2 · Tomas el molde por género y talla")),
        new(Asset("prog-3"), "Paso 3", T("programas.step3.caption", "3 · Arma con nombres y dorsales, en bloques")),
        new(Asset("prog-4"), "Paso 4", T("programas.step4.caption", "4 · Listo para exportar e imprimir"))
    ];

    private sealed record FeatureItem(string Title, string Detail);
    private sealed record GalleryShot(string Src, string Alt, string Caption);
}
