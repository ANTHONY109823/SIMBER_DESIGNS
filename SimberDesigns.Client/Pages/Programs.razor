@page "/programas"

<PageTitle>Programas · Simber Designs</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100">
    <section class="relative overflow-hidden border-b border-slate-800">
        <div class="absolute inset-0 bg-gradient-to-br from-orange-600/15 via-slate-950 to-cyan-500/10"></div>
        <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:py-20">
            <div>
                <p class="inline-flex rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-orange-400">
                    Herramienta · CorelDRAW e Illustrator
                </p>
                <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-5xl">
                    Simber <span class="text-orange-400">Designs</span>
                </h1>
                <p class="mt-4 text-lg text-slate-300">
                    Herramienta de apoyo para <strong class="text-white">CorelDRAW e Illustrator</strong>: arma mockups, nombres, dorsales y colorways de sublimación en tu PC.
                </p>
                <ul class="mt-6 space-y-2 text-sm text-slate-300">
                    <li>Windows · sin instalar nada; trabaja dentro de tu programa de diseño</li>
                    <li>Funciona en <strong class="text-white">CorelDRAW</strong> y <strong class="text-white">Adobe Illustrator</strong></li>
                    <li>Pago mensual con Mercado Pago · <strong class="text-white">se activa solo</strong> en tu PC</li>
                    <li>Armado automático, nombres y dorsales de la lista, y lectura con IA</li>
                </ul>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/api/plugin/download"
                       class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
                        ⬇ Descargar SIMBER DESIGNS
                    </a>
                    <a href="/recargar" class="rounded-full border border-white/15 px-6 py-3 text-sm text-slate-200 hover:border-white/40">
                        Pagar el mes (Mercado Pago)
                    </a>
                </div>
                <div class="mt-5 flex items-baseline gap-2">
                    <span class="text-4xl font-black text-white">$15</span>
                    <span class="text-slate-400 text-sm">USD / mes · por PC</span>
                </div>
                <p class="mt-2 text-xs text-slate-500">Descarga gratis. Pagas el mes y se activa sola para tu PC (pago automático por la pasarela). Sin WhatsApp.</p>
            </div>

            <div class="overflow-hidden rounded-3xl border border-white/10 bg-slate-900 shadow-2xl shadow-orange-950/40">
                <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                    <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                    <span class="ml-2 text-xs text-slate-500">SIMBER DESIGNS · CorelDRAW / Illustrator</span>
                </div>
                <img src="@Gallery[0].Src" alt="@Gallery[0].Alt" class="h-72 w-full object-cover sm:h-80" />
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="mb-8">
            <h2 class="font-serif text-3xl">Cómo se ve trabajando</h2>
            <p class="mt-2 text-sm text-slate-400">El flujo real: lees la lista, tomas los moldes y el programa arma y acomoda solo en CorelDRAW o Illustrator, con nombres y dorsales.</p>
        </div>

        <div class="grid gap-6 lg:grid-cols-5">
            <!-- Imagen/anim principal del armado -->
            <figure class="relative lg:col-span-3 aspect-video overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-br from-orange-600/25 via-slate-900 to-slate-950">
                <img src="programas/armado-corel.jpg" alt="Armado automático" onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-cover" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 to-transparent px-5 py-4">
                    <p class="text-base font-bold text-white">Armado automático en CorelDRAW / Illustrator</p>
                    <p class="text-xs text-slate-300">Duplica el molde por jugador, pone nombre y dorsal y acomoda en bloques.</p>
                </figcaption>
            </figure>

            <!-- Video demo (opcional) -->
            <div class="lg:col-span-2 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
                <video class="aspect-video w-full bg-black object-cover" controls poster="programas/demo-poster.jpg">
                    <source src="@DemoVideoSrc" type="video/mp4" />
                </video>
                <p class="px-4 py-3 text-xs text-slate-400">Video del flujo (sube tu <code class="text-orange-300">.mp4</code> a <code class="text-orange-300">wwwroot/programas/</code>).</p>
            </div>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var shot in Gallery)
            {
                <figure class="relative h-44 overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-800 to-slate-950">
                    <img src="@shot.Src" alt="@shot.Alt" onerror="this.style.display='none'"
                         class="absolute inset-0 h-full w-full object-cover" />
                    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 to-transparent px-4 py-3 text-xs font-semibold text-slate-100">@shot.Caption</figcaption>
                </figure>
            }
        </div>
    </section>

    <section id="funciones" class="border-y border-slate-800 bg-slate-900/40">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
            <h2 class="font-serif text-3xl">Funciones</h2>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var feature in Features)
                {
                    <article class="rounded-2xl border border-slate-800 bg-slate-950/70 p-6">
                        <h3 class="text-lg font-semibold text-white">@feature.Title</h3>
                        <p class="mt-2 text-sm text-slate-400">@feature.Detail</p>
                    </article>
                }
            </div>
        </div>
    </section>

    <section id="licencia" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="font-serif text-3xl">Precio y activación</h2>
        <p class="mt-2 max-w-2xl text-sm text-slate-400">
            Descargas el programa gratis, pagas el mes con la pasarela y se activa solo para tu PC. Sin WhatsApp.
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
            <article class="rounded-2xl border border-emerald-500/40 bg-emerald-950/20 p-8">
                <span class="rounded-full bg-emerald-500 px-3 py-1 text-xs font-bold uppercase tracking-wide text-slate-950">Plan mensual</span>
                <p class="mt-6 flex items-end gap-2">
                    <span class="text-5xl font-extrabold text-white">$15</span>
                    <span class="pb-1 text-sm text-slate-400">USD / mes · por PC</span>
                </p>
                <ul class="mt-6 space-y-3 text-sm text-slate-300">
                    <li>✓ Funciona en CorelDRAW y Adobe Illustrator</li>
                    <li>✓ Armado automático con nombres y dorsales de tu lista</li>
                    <li>✓ Lectura de listas con IA desde una foto</li>
                    <li>✓ Se activa solo para tu PC (1 licencia por PC)</li>
                    <li>✓ Pago automático por la pasarela; renuevas cuando quieras</li>
                </ul>
                <a href="/recargar"
                   class="mt-8 inline-flex w-full items-center justify-center rounded-xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
                    Pagar el mes
                </a>
            </article>

            <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
                <h3 class="text-xl font-bold text-white">Cómo funciona</h3>
                <ol class="mt-6 list-decimal list-inside space-y-3 text-sm text-slate-300">
                    <li>Descargas el programa gratis (botón de arriba).</li>
                    <li>Creas tu cuenta y pagas el mes con la pasarela.</li>
                    <li>Abres el programa, entras con tu email y se activa solo para esa PC.</li>
                    <li>Al mes: si pagas, se renueva solo; si no, se bloquea al vencer.</li>
                </ol>
                <a href="/api/plugin/download"
                   class="mt-8 inline-flex w-full items-center justify-center rounded-xl border border-white/15 px-4 py-3 text-sm text-slate-200 hover:border-white/40">
                    ⬇ Descargar ahora
                </a>
            </article>
        </div>
    </section>

    <section class="border-t border-slate-800 bg-slate-900/50">
        <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6">
            <h2 class="font-serif text-3xl">Empieza hoy</h2>
            <p class="mt-3 text-slate-400">
                Descarga la herramienta gratis, crea tu cuenta y paga el mes. Se activa sola para tu PC.
            </p>
            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <a href="/api/plugin/download"
                   class="rounded-full bg-emerald-500 px-8 py-3.5 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
                    ⬇ Descargar
                </a>
                <a href="/recargar"
                   class="rounded-full border border-white/15 px-8 py-3.5 text-sm text-slate-200 hover:border-white/40">
                    Pagar el mes
                </a>
            </div>
        </div>
    </section>
</div>

@code {
    private const string DemoVideoSrc = "programas/simber-designs-demo.mp4";

    private static readonly FeatureItem[] Features =
    [
        new("Armado automático", "Duplica el molde por jugador y acomoda las piezas en bloques, listo para producir."),
        new("Nombres y dorsales", "Toma la lista y rellena nombre y número conservando la tipografía del molde."),
        new("Corel e Illustrator", "Trabaja dentro de tu programa; tú solo exportas e imprimes como siempre."),
        new("Lectura con IA", "Lee la lista de jugadores desde una foto o un archivo, sin teclear."),
        new("Aprovecha la tela", "Acomoda las piezas al ancho de tu rollo y en bloques para desperdiciar menos."),
        new("Se activa solo", "Pagas el mes en la web y la herramienta se activa sola para tu PC.")
    ];

    // Las imágenes viven en wwwroot/programas/ (súbelas con estos nombres). Si falta alguna,
    // se ve una tarjeta con degradado y su título — nunca una imagen rota.
    private static readonly GalleryShot[] Gallery =
    [
        new("programas/1-lista.jpg", "Lectura de la lista", "1 · Pegas o subes la lista (o foto con IA)"),
        new("programas/2-molde.jpg", "Tomar molde", "2 · Tomas el molde por género y talla"),
        new("programas/3-armado.jpg", "Armado automático", "3 · Arma con nombres y dorsales, en bloques"),
        new("programas/4-resultado.jpg", "Resultado", "4 · Listo para exportar e imprimir")
    ];

    private sealed record LicenseOption(string Key, string Name, string PriceLabel, string Summary, bool Popular, string[] Includes);
    private sealed record FeatureItem(string Title, string Detail);
    private sealed record GalleryShot(string Src, string Alt, string Caption);
}
