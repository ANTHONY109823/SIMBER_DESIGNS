@page "/programas"
@inject SimberApi Api

<PageTitle>Programas · Simber Designs</PageTitle>

<section class="relative overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-orange-600/15 via-ink to-cyan/10"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:py-20">
        <div>
            <p class="inline-flex rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-gold">
                @T("programas.badge", "Herramienta · CorelDRAW e Illustrator")
            </p>
            <h1 class="mt-4 font-serif text-4xl leading-tight text-white sm:text-5xl">
                Simber <span class="text-gold">Designs</span>
            </h1>
            <p class="mt-4 text-lg text-cream/85">
                @T("programas.desc", "Herramienta de apoyo para CorelDRAW e Illustrator: arma mockups, nombres, dorsales y colorways de sublimación en tu PC.")
            </p>
            <ul class="mt-6 space-y-2 text-sm text-cream/80">
                <li>Windows · dos ejecutables distintos: uno para CorelDRAW y otro para Illustrator</li>
                <li>La descarga es gratis. El mes se activa desde tu cuenta, en 1 PC</li>
                <li>Entras con usuario y contraseña; al pagar aparece la clave del mes en Mi cuenta</li>
                <li>Al abrir, el programa se conecta a internet y comprueba si el mes sigue vigente</li>
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/api/plugin/download/corel" data-enhance-nav="false"
                   class="inline-flex min-h-11 items-center rounded-full bg-emerald-500 px-6 py-3 text-sm font-semibold text-ink hover:bg-emerald-400">
                    Descargar CorelDRAW
                </a>
                <a href="/api/plugin/download/illustrator" data-enhance-nav="false"
                   class="inline-flex min-h-11 items-center rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink hover:bg-orange-400">
                    Descargar Illustrator
                </a>
            </div>
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-orange-950/40">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                <span class="ml-2 text-xs text-cream/70">SIMBER DESIGNS · CorelDRAW / Illustrator</span>
            </div>
            <img src="@Gallery[0].Src" alt="@Gallery[0].Alt" class="h-72 w-full object-cover sm:h-80" />
        </div>
    </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="mb-8">
        <h2 class="font-serif text-3xl text-white">Cómo se ve trabajando</h2>
        <p class="mt-2 text-sm text-cream/80">El flujo real: lees la lista, tomas los moldes y el programa arma y acomoda solo en CorelDRAW o Illustrator, con nombres y dorsales.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-5">
        <figure class="relative lg:col-span-3 aspect-video overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-orange-600/25 via-ink to-ink">
            <img src="/api/content/asset/prog-armado" alt="Armado automático" onerror="this.style.display='none'"
                 class="absolute inset-0 h-full w-full object-cover" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-5 py-4">
                <p class="text-base font-bold text-white">Armado automático en CorelDRAW / Illustrator</p>
                <p class="text-xs text-cream/80">Duplica el molde por jugador, pone nombre y dorsal y acomoda en bloques.</p>
            </figcaption>
        </figure>

        <div class="lg:col-span-2 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
            <video class="aspect-video w-full bg-black object-cover" controls poster="programas/demo-poster.jpg">
                <source src="@DemoVideoSrc" type="video/mp4" />
            </video>
            <p class="px-4 py-3 text-xs text-cream/75">Video del flujo (si está subido en Programas).</p>
        </div>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var shot in Gallery)
        {
            <figure class="relative h-44 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
                <img src="@shot.Src" alt="@shot.Alt" onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-cover" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-4 py-3 text-xs font-semibold text-white">@shot.Caption</figcaption>
            </figure>
        }
    </div>
</section>

<section id="funciones" class="border-y border-white/10 bg-white/[0.03]">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="font-serif text-3xl text-white">Funciones</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in Features)
            {
                <article class="rounded-2xl border border-white/10 bg-ink/70 p-6">
                    <h3 class="text-lg font-semibold text-white">@feature.Title</h3>
                    <p class="mt-2 text-sm text-cream/80">@feature.Detail</p>
                </article>
            }
        </div>
    </div>
</section>

<section id="descargas" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="font-serif text-3xl text-white">Descargas</h2>
    <p class="mt-2 max-w-2xl text-sm text-cream/80">
        Baja el ejecutable de tu programa. El mes se paga después, en Mi cuenta, cuando ya quieras activarlo en tu PC.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-emerald-500/40 bg-emerald-950/20 p-8">
            <span class="rounded-full bg-emerald-500 px-3 py-1 text-xs font-bold uppercase tracking-wide text-ink">CorelDRAW</span>
            <h3 class="mt-6 font-serif text-3xl text-white">SIMBER DESIGNS Corel</h3>
            <p class="mt-4 text-sm text-cream/80">Ejecutable para CorelDRAW. Gratis para bajar. Se activa en 1 PC desde tu cuenta.</p>
            <a href="/api/plugin/download/corel" data-enhance-nav="false"
               class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-ink hover:bg-emerald-400">Descargar CorelDRAW</a>
            <a href="/cuenta" class="mt-3 inline-flex min-h-11 w-full items-center justify-center text-sm text-cream/80 hover:text-gold">Activar desde Mi cuenta</a>
        </article>
        <article class="rounded-2xl border border-cyan/30 bg-cyan/5 p-8">
            <span class="rounded-full bg-cyan px-3 py-1 text-xs font-bold uppercase tracking-wide text-ink">Illustrator</span>
            <h3 class="mt-6 font-serif text-3xl text-white">SIMBER DESIGNS Illustrator</h3>
            <p class="mt-4 text-sm text-cream/80">Ejecutable para Illustrator. Gratis para bajar. Se activa en 1 PC desde tu cuenta.</p>
            <a href="/api/plugin/download/illustrator" data-enhance-nav="false"
               class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-gold px-4 py-3 text-sm font-semibold text-ink hover:bg-orange-400">Descargar Illustrator</a>
            <a href="/cuenta" class="mt-3 inline-flex min-h-11 w-full items-center justify-center text-sm text-cream/80 hover:text-gold">Activar desde Mi cuenta</a>
        </article>
    </div>
</section>

@code {
    private const string DemoVideoSrc = "programas/simber-designs-demo.mp4";
    private Dictionary<string, string> _c = new();
    private string T(string key, string fallback)
        => _c.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;

    protected override async Task OnInitializedAsync()
    {
        try { _c = await Api.GetContentAsync(); } catch { _c = new(); }
    }

    private static readonly FeatureItem[] Features =
    [
        new("Armado automático", "Duplica el molde por jugador y acomoda las piezas en bloques, listo para producir."),
        new("Nombres y dorsales", "Toma la lista y rellena nombre y número conservando la tipografía del molde."),
        new("Corel e Illustrator", "Trabaja dentro de tu programa; tú solo exportas e imprimes como siempre."),
        new("Lectura con IA", "Lee la lista de jugadores desde una foto o un archivo, sin teclear."),
        new("Aprovecha la tela", "Acomoda las piezas al ancho de tu rollo y en bloques para desperdiciar menos."),
        new("Se activa solo", "Pagas el mes en la web y la herramienta se activa sola para tu PC.")
    ];

    private static readonly GalleryShot[] Gallery =
    [
        new("/api/content/asset/prog-1", "Lectura de la lista", "1 · Pegas o subes la lista (o foto con IA)"),
        new("/api/content/asset/prog-2", "Tomar molde", "2 · Tomas el molde por género y talla"),
        new("/api/content/asset/prog-3", "Armado automático", "3 · Arma con nombres y dorsales, en bloques"),
        new("/api/content/asset/prog-4", "Resultado", "4 · Listo para exportar e imprimir")
    ];

    private sealed record FeatureItem(string Title, string Detail);
    private sealed record GalleryShot(string Src, string Alt, string Caption);
}
