@page "/admin/login"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Admin · Simber Designs</PageTitle>

<section class="w-full max-w-sm">
    <h1 class="text-center font-serif text-3xl text-white">Simber <span class="text-orange-400">Admin</span></h1>
    <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
        <InputText autocomplete="off" class="w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-white" placeholder="Usuario" @bind-Value="Email" />
        <InputText type="password" autocomplete="new-password" class="w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-white" placeholder="Contraseña" @bind-Value="Password" />
        <button class="w-full rounded-full bg-orange-600 py-3 text-sm font-semibold text-white hover:bg-orange-500" type="submit">Ingresar</button>
    </EditForm>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mt-4 text-center text-sm text-rose-400">@Error</p>
    }
    <p class="mt-8 text-center text-sm">
        <a href="/" class="text-slate-400 hover:text-white">Ir a la web</a>
    </p>
</section>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string? Error;

    private async Task Submit()
    {
        var result = await Api.LoginAsync(Email, Password);
        if (result is null)
        {
            Error = "Credenciales inválidas.";
            return;
        }

        if (!string.Equals(result.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            Error = "Esta ruta es solo para administradores.";
            return;
        }

        await Auth.SignInAsync(result.Token);
        Nav.NavigateTo("/admin/payments");
    }
}
