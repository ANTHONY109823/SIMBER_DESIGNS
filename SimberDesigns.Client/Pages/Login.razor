@page "/login"
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Entrar · Simber Designs</PageTitle>

<section class="mx-auto max-w-md px-6 py-16">
    <h1 class="font-serif text-4xl text-white">Entrar</h1>
    <p class="mt-2 text-sm text-slate-400">Demo: demo@simber.designs / Demo123! · Admin: admin@simber.designs / Admin123!</p>
    <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
        <InputText class="w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-white" placeholder="Email" @bind-Value="Email" />
        <InputText type="password" class="w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-white" placeholder="Contraseña" @bind-Value="Password" />
        <button class="w-full rounded-full bg-orange-600 py-3 text-sm font-semibold text-white" type="submit">Acceder</button>
    </EditForm>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mt-4 text-sm text-rose-400">@Error</p>
    }
    <p class="mt-6 text-sm text-slate-400">¿No tienes cuenta? <a class="text-cyan-400 underline" href="/register">Créala</a></p>
</section>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string? Error;

    private async Task Submit()
    {
        var result = await Api.LoginAsync(Email, Password);
        if (result is null)
        {
            Error = "Credenciales inválidas.";
            return;
        }

        await Auth.SignInAsync(result.Token);
        Nav.NavigateTo("/");
    }
}
