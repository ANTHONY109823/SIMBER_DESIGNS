@page "/catalog"
@inject SimberApi Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Catálogo · Simber Designs</PageTitle>

<div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(ellipse_at_top,_rgba(255,106,26,0.16),_transparent_58%)]"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs uppercase tracking-[0.28em] text-gold">@T("catalog.eyebrow", "Catálogo CDR")</p>
            <h1 class="mt-3 font-serif text-4xl tracking-tight text-white sm:text-6xl">
                @((MarkupString)CatalogTitleHtml)
            </h1>
            @if (!string.IsNullOrWhiteSpace(T("catalog.desc", "")))
            {
                <p class="mt-3 text-sm text-cream/80">@T("catalog.desc", "")</p>
            }
        </div>

        <div @ref="dropZoneElement"
             @onpointerenter="OnDragEnter"
             @onpointerleave="OnDragLeave"
             class="relative mx-auto mt-10 max-w-2xl">
            <div class="@(isDragging ? "border-gold bg-gold/10 scale-[1.01]" : "border-white/15 bg-white/[0.03] hover:border-gold/40")
                        relative overflow-hidden rounded-3xl border-2 border-dashed p-8 transition-all duration-300 sm:p-10">
                <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp,image/*" class="absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />
                <div class="pointer-events-none flex flex-col items-center text-center">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-ink text-gold">
                        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <p class="mt-4 text-lg font-semibold text-white">Busca por foto</p>
                    <p class="mt-1 text-sm text-cream/75">Arrastra, elige o pega con <kbd class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-xs text-cream">Ctrl+V</kbd></p>
                </div>

                @if (isAnalyzing)
                {
                    <div class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-ink/90 backdrop-blur-sm">
                        <div class="h-12 w-12 animate-spin rounded-full border-2 border-white/10 border-t-gold"></div>
                        <p class="mt-4 text-sm font-medium text-gold">Buscando diseños parecidos...</p>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="mt-4 text-center text-sm text-rose-400" role="alert">@errorMessage</p>
        }

        @if (activeVisualSearchImage != null)
        {
            <div class="mt-6 flex justify-center">
                <div class="inline-flex items-center gap-3 rounded-full border border-gold/30 bg-gold/10 px-4 py-2 text-sm">
                    <img src="@activeVisualSearchImage" alt="" class="h-8 w-8 rounded-lg object-cover" />
                    <span class="text-cream">Búsqueda por imagen</span>
                    <button type="button" @onclick="ClearVisualSearch" class="min-h-11 min-w-11 text-cream/80 hover:text-white" aria-label="Quitar búsqueda por imagen">×</button>
                </div>
            </div>
        }

        @if (!isLoading && FreeDaily.Count > 0)
        {
            <div class="mt-10 overflow-hidden rounded-3xl border border-gold/40 bg-gold/10 p-5 sm:p-6">
                <p class="text-xs uppercase tracking-[0.2em] text-gold">Gratis del día</p>
                <p class="mt-1 text-sm text-cream/85">Hoy no gasta créditos. Regístrate para descargar.</p>
                <div class="mt-4 flex gap-4 overflow-x-auto pb-1">
                    @foreach (var design in FreeDaily)
                    {
                        <a href="@(isAuthenticated || isAdmin ? "#catalogo" : RegisterHref)"
                           class="w-40 shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-ink transition hover:border-gold/40">
                            <img src="@design.PreviewUrl" alt="@design.Title" class="aspect-[4/5] w-full object-cover" loading="lazy" />
                            <p class="truncate px-3 py-2 text-xs text-white">@design.Title</p>
                        </a>
                    }
                </div>
            </div>
        }

        <div id="catalogo" class="mt-12 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <label class="block min-w-0 flex-1 text-sm">
                <span class="sr-only">Buscar por nombre</span>
                <input type="search"
                       value="@searchText"
                       @oninput="OnSearchInput"
                       placeholder="Buscar por nombre…"
                       class="w-full rounded-2xl border border-white/12 bg-white/[0.04] px-4 py-3 text-white placeholder:text-cream/55 outline-none focus:border-gold/60" />
            </label>
            <label class="block text-sm lg:w-56">
                <span class="sr-only">Ordenar</span>
                <select @bind="sortBy" @bind:after="ApplyFilters"
                        disabled="@HasVisualSearch"
                        class="w-full rounded-2xl border border-white/12 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60 disabled:opacity-50">
                    <option value="nuevos">Más nuevos</option>
                    <option value="creditos-asc">Menos créditos</option>
                    <option value="creditos-desc">Más créditos</option>
                </select>
            </label>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
                @foreach (var cat in categories)
                {
                    <button type="button" @onclick="() => SelectCategory(cat)"
                            class="min-h-11 rounded-full px-4 py-2 text-sm transition @(selectedCategory == cat ? "bg-gold font-semibold text-ink" : "border border-white/12 text-cream/80 hover:border-white/30")">
                        @cat <span class="opacity-70">@GetCountForCategory(cat)</span>
                    </button>
                }
            </div>
            <p class="text-sm text-cream/75">@filteredDesigns.Count diseños</p>
        </div>

        <div class="mt-8">
            @if (isLoading)
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="animate-pulse overflow-hidden rounded-3xl border border-white/8 bg-white/[0.03]">
                            <div class="aspect-[4/5] bg-white/5"></div>
                            <div class="space-y-3 p-5">
                                <div class="h-4 w-2/3 rounded bg-white/10"></div>
                                <div class="h-3 w-1/3 rounded bg-white/5"></div>
                                <div class="h-8 w-1/2 rounded bg-white/10"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (filteredDesigns.Count == 0)
            {
                <div class="rounded-3xl border border-dashed border-white/12 px-6 py-20 text-center">
                    <h3 class="font-serif text-2xl text-white">Sin diseños en esta vista</h3>
                    <p class="mx-auto mt-2 max-w-sm text-sm text-cream/80">Prueba otro nombre, cambia de deporte o limpia la búsqueda.</p>
                    <button type="button" @onclick="ResetFilters" class="mt-5 min-h-11 rounded-full border border-white/15 px-4 py-2 text-sm hover:border-gold/50">
                        Ver todo
                    </button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var design in VisibleDesigns)
                    {
                        <article class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] transition hover:border-gold/35">
                            <div class="relative aspect-[4/5] overflow-hidden bg-ink">
                                <img src="@design.PreviewUrl" alt="@design.Title" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                                <span class="absolute left-3 top-3 rounded-full bg-ink/80 px-3 py-1 text-xs text-cream">@design.Category</span>
                                @if (design.IsFreeDaily)
                                {
                                    <span class="absolute left-3 bottom-3 rounded-full bg-gold px-3 py-1 text-xs font-semibold text-ink">Gratis del día</span>
                                }
                                @if (design.Similarity is { } score)
                                {
                                    <span class="absolute right-3 top-3 rounded-full bg-gold px-2.5 py-1 text-xs font-semibold text-ink">@((score * 100).ToString("0"))%</span>
                                }
                            </div>
                            <div class="flex flex-1 flex-col p-5">
                                <h3 class="text-lg font-semibold text-white">@design.Title</h3>
                                <p class="mt-1 text-sm text-cream/80">CDR @design.CdrVersion</p>
                                @if (design.IsFreeDaily)
                                {
                                    <p class="mt-4 font-serif text-3xl text-gold">Gratis</p>
                                }
                                else
                                {
                                    <p class="mt-4 font-serif text-3xl text-gold">@design.CreditsCost.ToString("0") créditos</p>
                                }
                                @if (isAdmin || isAuthenticated)
                                {
                                    <button type="button" @onclick="() => TriggerDownload(design)"
                                            class="mt-5 min-h-11 w-full rounded-2xl bg-white/10 py-3 text-sm font-semibold text-white hover:bg-gold hover:text-ink">
                                        Descargar CDR
                                    </button>
                                }
                                else
                                {
                                    <a href="@RegisterHref" class="mt-5 block min-h-11 w-full rounded-2xl bg-gold py-3 text-center text-sm font-semibold leading-[2.5rem] text-ink hover:bg-orange-400">
                                        Regístrate para descargar
                                    </a>
                                }
                            </div>
                        </article>
                    }
                </div>
                @if (visibleCount < filteredDesigns.Count)
                {
                    <div class="mt-10 text-center">
                        <button type="button" @onclick="LoadMore" class="min-h-11 rounded-full border border-white/20 px-6 py-3 text-sm hover:border-gold/50">
                            Cargar más (@(filteredDesigns.Count - visibleCount) restantes)
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private const int PageSize = 12;
    private ElementReference dropZoneElement;
    private bool isDragging;
    private bool isAnalyzing;
    private bool isLoading = true;
    private bool isAdmin;
    private bool isAuthenticated;
    private string? activeVisualSearchImage;
    private string selectedCategory = "Todos";
    private string searchText = "";
    private string sortBy = "nuevos";
    private int visibleCount = PageSize;
    private List<string> categories = new() { "Todos", "Fútbol", "Vóley" };
    private List<DesignItem> allDesigns = new();
    private List<DesignItem> filteredDesigns = new();
    private string? errorMessage;
    private Dictionary<string, string> _c = new();
    private bool HasVisualSearch => activeVisualSearchImage != null;
    private List<DesignItem> FreeDaily => allDesigns.Where(d => d.IsFreeDaily).ToList();
    private IEnumerable<DesignItem> VisibleDesigns => filteredDesigns.Take(visibleCount);
    private string RegisterHref => "/register?returnUrl=/catalog";

    private void RebuildCategories()
    {
        var preferred = new[] { "Fútbol", "Vóley" };
        var found = allDesigns
            .Select(d => d.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        categories = new List<string> { "Todos" }
            .Concat(preferred.Where(p => found.Any(f => f.Equals(p, StringComparison.OrdinalIgnoreCase))))
            .Concat(found.Where(f => !preferred.Any(p => p.Equals(f, StringComparison.OrdinalIgnoreCase))).OrderBy(f => f))
            .ToList();
    }

    private string T(string key, string fallback)
        => _c.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;

    private string CatalogTitleHtml
    {
        get
        {
            var raw = T("catalog.title", "Fútbol|Vóley");
            var parts = raw.Split('|', 2, StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
                return $"{System.Net.WebUtility.HtmlEncode(parts[0])} y <span class=\"text-gold\">{System.Net.WebUtility.HtmlEncode(parts[1])}</span>";
            return System.Net.WebUtility.HtmlEncode(raw);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        isAdmin = auth.User.IsInRole("Admin");

        try { _c = await Api.GetContentAsync(); } catch { _c = new(); }

        try
        {
            var items = await Api.GetDesignsAsync() ?? [];
            allDesigns = items.Select(ToItem).ToList();
            RebuildCategories();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        ApplyFilters();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeClipboardPaste", DotNetObjectReference.Create(this));
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        ApplyFilters();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void LoadMore() => visibleCount += PageSize;

    private int GetCountForCategory(string cat)
        => cat == "Todos" ? allDesigns.Count : allDesigns.Count(d => d.Category == cat);

    private void ApplyFilters()
    {
        visibleCount = PageSize;
        if (HasVisualSearch)
        {
            filteredDesigns = allDesigns
                .Where(d => d.Similarity.HasValue && MatchesCategory(d) && MatchesSearch(d))
                .OrderByDescending(d => d.Similarity)
                .ToList();
            return;
        }

        var query = allDesigns.Where(MatchesCategory).Where(MatchesSearch);
        filteredDesigns = sortBy switch
        {
            "creditos-asc" => query.OrderBy(d => d.IsFreeDaily ? 0 : d.CreditsCost).ThenByDescending(d => d.CreatedAt).ToList(),
            "creditos-desc" => query.OrderByDescending(d => d.IsFreeDaily ? 0 : d.CreditsCost).ThenByDescending(d => d.CreatedAt).ToList(),
            _ => query.OrderByDescending(d => d.CreatedAt).ToList()
        };
    }

    private bool MatchesCategory(DesignItem d)
        => selectedCategory == "Todos" || d.Category == selectedCategory;

    private bool MatchesSearch(DesignItem d)
        => string.IsNullOrWhiteSpace(searchText)
           || d.Title.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase);

    private void ResetFilters()
    {
        selectedCategory = "Todos";
        searchText = "";
        sortBy = "nuevos";
        activeVisualSearchImage = null;
        foreach (var d in allDesigns)
        {
            d.Similarity = null;
        }

        ApplyFilters();
    }

    private void OnDragEnter() => isDragging = true;
    private void OnDragLeave() => isDragging = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isDragging = false;
        if (e.File is { } file)
        {
            await ProcessVisualSearch(file);
        }
    }

    [JSInvokable]
    public async Task OnPasteImage(string base64Image)
    {
        activeVisualSearchImage = base64Image;
        var comma = base64Image.IndexOf(',');
        var payload = comma >= 0 ? base64Image[(comma + 1)..] : base64Image;
        var bytes = Convert.FromBase64String(payload);
        using var stream = new MemoryStream(bytes);
        await RunVisualSearch(stream, "clipboard.png", "image/png");
    }

    private async Task ProcessVisualSearch(IBrowserFile file)
    {
        var buffers = new byte[file.Size];
        await using var read = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await read.ReadAsync(buffers);
        activeVisualSearchImage = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffers)}";
        using var stream = new MemoryStream(buffers);
        await RunVisualSearch(stream, file.Name, file.ContentType);
    }

    private async Task RunVisualSearch(Stream stream, string fileName, string contentType)
    {
        isAnalyzing = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var results = await Api.SearchByImageAsync(stream, fileName, contentType) ?? [];
            foreach (var design in allDesigns)
            {
                design.Similarity = null;
            }

            foreach (var result in results)
            {
                var match = allDesigns.FirstOrDefault(d => d.Id == result.Id);
                if (match is not null)
                {
                    match.Similarity = result.Similarity;
                    match.IsFreeDaily = result.IsFreeDaily;
                }
                else
                {
                    var extra = ToItem(result);
                    allDesigns.Add(extra);
                    RebuildCategories();
                }
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }

    private void ClearVisualSearch()
    {
        activeVisualSearchImage = null;
        foreach (var d in allDesigns)
        {
            d.Similarity = null;
        }

        ApplyFilters();
    }

    private async Task TriggerDownload(DesignItem design)
    {
        errorMessage = null;
        try
        {
            if (!isAdmin && !design.IsFreeDaily)
            {
                try
                {
                    await Api.UnlockAsync(design.Id);
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("ya está desbloqueado", StringComparison.OrdinalIgnoreCase))
                {
                }
            }

            var response = await Api.DownloadAsync(design.Id);
            if (!string.IsNullOrWhiteSpace(response?.DownloadUrl))
            {
                await JS.InvokeVoidAsync("open", response.DownloadUrl, "_blank");
            }
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("créditos", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "No tienes créditos. Recarga en Mi cuenta.";
            Nav.NavigateTo("/cuenta");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static DesignItem ToItem(DesignDto dto) => new(
        dto.Id,
        dto.Title,
        dto.Slug,
        dto.PreviewUrl,
        ToSportCategory(dto.Category),
        (double)dto.PriceUsd,
        (double)dto.CreditsCost,
        dto.CreatedAt,
        FormatCdrVersion(dto.Description),
        dto.IsFreeDaily)
    {
        Similarity = dto.Similarity
    };

    private static string FormatCdrVersion(string? description)
    {
        var value = (description ?? "").Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length > 16 || value.Contains(' '))
        {
            return "—";
        }

        return value;
    }

    private static string ToSportCategory(string? category)
    {
        var value = (category ?? "").Trim();
        if (value.Equals("Voleibol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Voley", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Vóley", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Volleyball", StringComparison.OrdinalIgnoreCase))
        {
            return "Vóley";
        }

        if (value.Equals("Jersey", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Fútbol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Futbol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Football", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Soccer", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Concept Kits", StringComparison.OrdinalIgnoreCase))
        {
            return "Fútbol";
        }

        return value;
    }

    public sealed class DesignItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string Category { get; set; } = "";
        public double PriceUsd { get; set; }
        public double CreditsCost { get; set; }
        public DateTime CreatedAt { get; set; }
        public string CdrVersion { get; set; } = "—";
        public bool IsFreeDaily { get; set; }
        public double? Similarity { get; set; }

        public DesignItem(Guid id, string title, string slug, string previewUrl, string category, double priceUsd, double creditsCost, DateTime createdAt, string cdrVersion, bool isFreeDaily)
        {
            Id = id;
            Title = title;
            Slug = slug;
            PreviewUrl = previewUrl;
            Category = category;
            PriceUsd = priceUsd;
            CreditsCost = creditsCost;
            CreatedAt = createdAt;
            CdrVersion = cdrVersion;
            IsFreeDaily = isFreeDaily;
        }
    }
}
