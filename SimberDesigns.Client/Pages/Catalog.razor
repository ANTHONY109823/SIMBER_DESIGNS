@page "/catalog"
@inject SimberApi Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@using System.Globalization
@using System.Text

<PageTitle>Catálogo · Simber Designs</PageTitle>

<div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(ellipse_at_top,_rgba(255,106,26,0.16),_transparent_58%)]"></div>

    <div class="relative mx-auto max-w-[1800px] px-4 py-6 sm:px-6 sm:py-8">
        @if (isLoading)
        {
            <div class="mx-auto max-w-2xl animate-pulse text-center">
                <div class="mx-auto h-3 w-28 rounded bg-white/10"></div>
                <div class="mx-auto mt-4 h-10 w-64 rounded bg-white/10 sm:h-14 sm:w-80"></div>
                <div class="mx-auto mt-10 flex max-w-2xl gap-2">
                    <div class="min-h-12 flex-1 rounded-2xl bg-white/5"></div>
                    <div class="min-h-12 w-24 rounded-2xl bg-white/10"></div>
                </div>
            </div>
            <div class="mt-10 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
                <div class="h-3 w-32 animate-pulse rounded bg-white/10"></div>
                <div class="mt-4 flex gap-4">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="h-52 w-40 shrink-0 animate-pulse rounded-2xl bg-white/5"></div>
                    }
                </div>
            </div>
            <div class="mt-10 flex gap-2">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="h-11 w-24 animate-pulse rounded-full bg-white/5"></div>
                }
            </div>
            <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="animate-pulse overflow-hidden rounded-3xl border border-white/8 bg-white/[0.03]">
                        <div class="aspect-[4/5] bg-white/5"></div>
                        <div class="space-y-3 p-5">
                            <div class="h-4 w-2/3 rounded bg-white/10"></div>
                            <div class="h-3 w-1/3 rounded bg-white/5"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <form class="mx-auto flex max-w-3xl gap-2" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
                <label class="min-w-0 flex-1">
                    <span class="sr-only">Buscar por nombre</span>
                    <input type="search"
                           @bind="searchDraft"
                           @bind:event="oninput"
                           placeholder="Ej. zorro, Panamá, Argentina…"
                           class="min-h-12 w-full rounded-2xl border border-white/12 bg-white/[0.04] px-4 py-3 text-white placeholder:text-cream/55 outline-none focus:border-gold/60" />
                </label>
                <button type="submit"
                        class="min-h-12 shrink-0 rounded-2xl bg-gold px-5 text-sm font-semibold text-ink hover:bg-orange-400">
                    Buscar
                </button>
            </form>
            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <p class="mt-3 text-center text-sm text-cream/70">
                    Resultados para “@searchText”
                    <button type="button" class="ml-2 text-gold underline hover:no-underline" @onclick="ClearSearch">Limpiar</button>
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="mt-4 text-center text-sm text-rose-400" role="alert">@errorMessage</p>
            }

            <div class="mt-6 flex gap-2 overflow-x-auto pb-1 lg:hidden">
                @foreach (var f in Filters)
                {
                    <button type="button" @onclick="() => SelectFilter(f)"
                            class="min-h-10 shrink-0 rounded-full px-4 py-2 text-sm transition @(selectedFilter == f ? "bg-gold font-semibold text-ink" : "border border-white/12 text-cream/80 hover:border-white/30")">
                        @f
                    </button>
                }
            </div>

            <div id="catalogo" class="mt-6 grid gap-6 lg:grid-cols-[180px_minmax(0,1fr)_280px]">
                <aside class="hidden lg:block">
                    <p class="mb-3 text-xs uppercase tracking-[0.2em] text-gold">Categorías</p>
                    <div class="flex flex-col gap-2">
                        @foreach (var f in Filters)
                        {
                            <button type="button" @onclick="() => SelectFilter(f)"
                                    class="w-full rounded-xl px-4 py-2.5 text-left text-sm transition @(selectedFilter == f ? "bg-gold font-semibold text-ink" : "border border-white/10 text-cream/80 hover:border-white/30")">
                                @f
                            </button>
                        }
                    </div>
                    <p class="mt-4 text-xs text-cream/55">@filteredDesigns.Count diseños</p>
                </aside>

                <div class="min-w-0">
                    @if (filteredDesigns.Count == 0)
                    {
                        <div class="rounded-3xl border border-dashed border-white/12 px-6 py-20 text-center">
                            <h3 class="font-serif text-2xl text-white">Sin diseños en esta vista</h3>
                            <p class="mx-auto mt-2 max-w-sm text-sm text-cream/80">Prueba otra palabra o limpia la búsqueda.</p>
                            <button type="button" @onclick="ResetFilters" class="mt-5 min-h-11 rounded-full border border-white/15 px-4 py-2 text-sm hover:border-gold/50">
                                Ver todo
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 gap-5 xl:grid-cols-3">
                            @foreach (var design in VisibleDesigns)
                            {
                                <article class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] transition hover:border-gold/35">
                                    <div class="relative aspect-[4/5] overflow-hidden bg-ink">
                                        <img src="@design.PreviewUrl" alt="@design.Title" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                                        <span class="absolute left-3 top-3 rounded-full bg-ink/80 px-3 py-1 text-xs text-cream">@design.DisplayCategory</span>
                                        @if (design.IsFreeDaily)
                                        {
                                            <span class="absolute bottom-3 left-3 rounded-full bg-gold px-3 py-1 text-xs font-semibold text-ink">Gratis</span>
                                        }
                                    </div>
                                    <div class="flex flex-1 flex-col p-5">
                                        <h3 class="text-lg font-semibold text-white">@design.Title</h3>
                                        <p class="mt-1 text-sm text-cream/80">CDR @design.CdrVersion</p>
                                        @if (design.IsFreeDaily)
                                        {
                                            <p class="mt-4 font-serif text-3xl text-gold">Gratis</p>
                                        }
                                        else
                                        {
                                            <p class="mt-4 font-serif text-3xl text-gold">@design.CreditsCost.ToString("0") créditos</p>
                                        }
                                        @if (isAdmin || isAuthenticated)
                                        {
                                            <button type="button" @onclick="() => TriggerDownload(design)"
                                                    class="mt-5 min-h-11 w-full rounded-2xl bg-white/10 py-3 text-sm font-semibold text-white hover:bg-gold hover:text-ink">
                                                Descargar CDR
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@RegisterHref" class="mt-5 block min-h-11 w-full rounded-2xl bg-gold py-3 text-center text-sm font-semibold leading-[2.5rem] text-ink hover:bg-orange-400">
                                                Regístrate para descargar
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                        @if (visibleCount < filteredDesigns.Count)
                        {
                            <div class="mt-10 text-center">
                                <button type="button" @onclick="LoadMore" class="min-h-11 rounded-full border border-white/20 px-6 py-3 text-sm hover:border-gold/50">
                                    Cargar más (@(filteredDesigns.Count - visibleCount) restantes)
                                </button>
                            </div>
                        }
                    }
                </div>

                @if (FreeDaily.Count > 0)
                {
                    <aside class="free-vpanel hidden lg:block">
                        <div class="sticky top-24 rounded-3xl border border-gold/40 bg-gold/10 p-4">
                            <p class="text-xs uppercase tracking-[0.2em] text-gold">Gratis del día</p>
                            <p class="mt-1 text-xs text-cream/80">Hoy no gasta créditos.</p>
                            <div class="mt-3 h-[34rem] overflow-hidden rounded-2xl">
                                <div class="free-vtrack flex flex-col gap-3">
                                    @foreach (var design in FreeDaily.Concat(FreeDaily))
                                    {
                                        <a href="@(isAuthenticated || isAdmin ? "#catalogo" : RegisterHref)"
                                           class="shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-ink transition hover:border-gold/40">
                                            <img src="@design.PreviewUrl" alt="@design.Title" class="aspect-[4/5] w-full object-cover" loading="lazy" />
                                            <p class="truncate px-3 py-2 text-xs text-white">@design.Title</p>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </aside>
                }
            </div>

            @if (FreeDaily.Count > 0)
            {
                <div class="mt-8 overflow-hidden rounded-3xl border border-gold/40 bg-gold/10 p-4 lg:hidden">
                    <p class="text-xs uppercase tracking-[0.2em] text-gold">Gratis del día</p>
                    <div class="mt-3 flex gap-3 overflow-x-auto pb-1">
                        @foreach (var design in FreeDaily)
                        {
                            <a href="@(isAuthenticated || isAdmin ? "#catalogo" : RegisterHref)"
                               class="w-36 shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-ink">
                                <img src="@design.PreviewUrl" alt="@design.Title" class="aspect-[4/5] w-full object-cover" loading="lazy" />
                                <p class="truncate px-3 py-2 text-xs text-white">@design.Title</p>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private const int PageSize = 12;
    private static readonly string[] Filters = ["Todos", "Deportivos", "Gratis", "Recientes"];

    private bool isLoading = true;
    private bool isAdmin;
    private bool isAuthenticated;
    private string selectedFilter = "Todos";
    private string searchDraft = "";
    private string searchText = "";
    private int visibleCount = PageSize;
    private List<DesignItem> allDesigns = new();
    private List<DesignItem> filteredDesigns = new();
    private string? errorMessage;
    private Dictionary<string, string> _c = new();

    private List<DesignItem> FreeDaily => allDesigns.Where(d => d.IsFreeDaily).ToList();
    private IEnumerable<DesignItem> VisibleDesigns => filteredDesigns.Take(visibleCount);
    private string RegisterHref => "/register?returnUrl=/catalog";

    private string T(string key, string fallback)
        => _c.TryGetValue(key, out var v) ? v : fallback;

    private string CatalogTitleHtml
    {
        get
        {
            var raw = T("catalog.title", "Deportivos");
            var parts = raw.Split('|', 2, StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
                return $"{System.Net.WebUtility.HtmlEncode(parts[0])} y <span class=\"text-gold\">{System.Net.WebUtility.HtmlEncode(parts[1])}</span>";
            return System.Net.WebUtility.HtmlEncode(raw);
        }
    }

    /// <summary>Sinónimos y alias: si buscan "zorro" también matchea títulos con esas variantes.</summary>
    private static readonly Dictionary<string, string[]> Synonyms = new(StringComparer.OrdinalIgnoreCase)
    {
        ["zorro"] = ["zorro", "fox", "zoro"],
        ["voley"] = ["voley", "vóley", "voleibol", "volleyball"],
        ["futbol"] = ["futbol", "fútbol", "football", "soccer", "jersey"],
        ["panama"] = ["panama", "panamá"],
        ["argentina"] = ["argentina", "albiceleste"],
        ["brasil"] = ["brasil", "brazil"],
        ["peru"] = ["peru", "perú"],
        ["mexico"] = ["mexico", "méxico"],
        ["real"] = ["real", "madrid"],
        ["barcelona"] = ["barcelona", "barca", "barça"],
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        isAdmin = auth.User.IsInRole("Admin");

        var contentTask = SafeContentAsync();
        var designsTask = SafeDesignsAsync();
        await Task.WhenAll(contentTask, designsTask);

        _c = await contentTask;
        allDesigns = await designsTask;

        ApplyFilters();
        isLoading = false;
    }

    private async Task<Dictionary<string, string>> SafeContentAsync()
    {
        try { return await Api.GetContentAsync() ?? new(); }
        catch { return new(); }
    }

    private async Task<List<DesignItem>> SafeDesignsAsync()
    {
        try
        {
            var items = await Api.GetDesignsAsync() ?? [];
            return items.Select(ToItem).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            return new();
        }
    }

    private void SubmitSearch()
    {
        searchText = searchDraft.Trim();
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchDraft = "";
        searchText = "";
        ApplyFilters();
    }

    private void SelectFilter(string filter)
    {
        selectedFilter = filter;
        ApplyFilters();
    }

    private void LoadMore() => visibleCount += PageSize;

    private void ApplyFilters()
    {
        visibleCount = PageSize;
        IEnumerable<DesignItem> query = allDesigns;

        query = selectedFilter switch
        {
            "Deportivos" => query.Where(d => d.IsSport),
            "Gratis" => query.Where(d => d.IsFreeDaily),
            "Recientes" => query.OrderByDescending(d => d.CreatedAt).Take(24),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(searchText))
            query = query.Where(MatchesSearch);

        filteredDesigns = selectedFilter == "Recientes"
            ? query.ToList()
            : query.OrderByDescending(d => d.CreatedAt).ToList();
    }

    private bool MatchesSearch(DesignItem d)
    {
        var haystack = Normalize($"{d.Title} {d.Slug} {d.Category} {d.DisplayCategory}");
        var tokens = searchText.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (tokens.Length == 0) return true;

        // Cada palabra debe matchear (AND). Dentro de cada palabra se expanden sinónimos (OR).
        foreach (var token in tokens)
        {
            var variants = ExpandToken(token);
            if (!variants.Any(v => haystack.Contains(Normalize(v), StringComparison.Ordinal)))
                return false;
        }

        return true;
    }

    private static IEnumerable<string> ExpandToken(string token)
    {
        var n = Normalize(token);
        yield return token;
        yield return n;
        foreach (var (key, vals) in Synonyms)
        {
            if (Normalize(key) == n || vals.Any(v => Normalize(v) == n))
            {
                foreach (var v in vals) yield return v;
                yield return key;
            }
        }
    }

    private static string Normalize(string value)
    {
        var form = value.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(form.Length);
        foreach (var c in form)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }

        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    private void ResetFilters()
    {
        selectedFilter = "Todos";
        searchDraft = "";
        searchText = "";
        ApplyFilters();
    }

    private async Task TriggerDownload(DesignItem design)
    {
        errorMessage = null;
        try
        {
            if (!isAdmin && !design.IsFreeDaily)
            {
                try
                {
                    await Api.UnlockAsync(design.Id);
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("ya está desbloqueado", StringComparison.OrdinalIgnoreCase))
                {
                }
            }

            var response = await Api.DownloadAsync(design.Id);
            if (!string.IsNullOrWhiteSpace(response?.DownloadUrl))
                await JS.InvokeVoidAsync("open", response.DownloadUrl, "_blank");
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("créditos", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "No tienes créditos. Recarga en Mi cuenta.";
            Nav.NavigateTo("/cuenta");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static DesignItem ToItem(DesignDto dto) => new(
        dto.Id,
        dto.Title,
        dto.Slug,
        dto.PreviewUrl,
        ToSportCategory(dto.Category),
        (double)dto.PriceUsd,
        (double)dto.CreditsCost,
        dto.CreatedAt,
        FormatCdrVersion(dto.Description),
        dto.IsFreeDaily);

    private static string FormatCdrVersion(string? description)
    {
        var value = (description ?? "").Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length > 16 || value.Contains(' '))
            return "—";
        return value;
    }

    private static string ToSportCategory(string? category)
    {
        var value = (category ?? "").Trim();
        if (value.Equals("Voleibol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Voley", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Vóley", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Volleyball", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Jersey", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Fútbol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Futbol", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Football", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Soccer", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Concept Kits", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Deportivos", StringComparison.OrdinalIgnoreCase))
        {
            return "Deportivos";
        }

        return string.IsNullOrWhiteSpace(value) ? "Deportivos" : value;
    }

    public sealed class DesignItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string Category { get; set; } = "";
        public double PriceUsd { get; set; }
        public double CreditsCost { get; set; }
        public DateTime CreatedAt { get; set; }
        public string CdrVersion { get; set; } = "—";
        public bool IsFreeDaily { get; set; }
        public bool IsSport => Category.Equals("Deportivos", StringComparison.OrdinalIgnoreCase)
            || Category.Equals("Fútbol", StringComparison.OrdinalIgnoreCase)
            || Category.Equals("Vóley", StringComparison.OrdinalIgnoreCase);
        public string DisplayCategory => IsSport ? "Deportivos" : Category;

        public DesignItem(Guid id, string title, string slug, string previewUrl, string category, double priceUsd, double creditsCost, DateTime createdAt, string cdrVersion, bool isFreeDaily)
        {
            Id = id;
            Title = title;
            Slug = slug;
            PreviewUrl = previewUrl;
            Category = category;
            PriceUsd = priceUsd;
            CreditsCost = creditsCost;
            CreatedAt = createdAt;
            CdrVersion = cdrVersion;
            IsFreeDaily = isFreeDaily;
        }
    }
}
