@page "/"
@inject SimberApi Api

<PageTitle>Simber Designs</PageTitle>
<HeroBanner />

<section class="mx-auto max-w-6xl px-6 py-16">
    <p class="text-xs uppercase tracking-[0.28em] text-cyan">Cómo funciona</p>
    <h2 class="mt-2 font-serif text-3xl text-white">De la lista al corte, en cuatro pasos</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var step in Steps)
        {
            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
                <p class="text-xs uppercase tracking-[0.2em] text-gold">@step.Num</p>
                <h3 class="mt-3 font-serif text-xl text-white">@step.Title</h3>
                <p class="mt-2 text-sm text-cream/80">@step.Text</p>
            </article>
        }
    </div>
</section>

@if (Preview.Count > 0)
{
    <section class="mx-auto max-w-6xl px-6 pb-8">
        <div class="flex items-end justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-[0.28em] text-gold">Catálogo</p>
                <h2 class="mt-2 font-serif text-3xl text-white">Vectores listos para sublimar</h2>
            </div>
            <a href="/catalog" class="text-sm text-gold hover:underline">Ver todo</a>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var d in Preview)
            {
                <a href="/catalog" class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
                    <div class="aspect-[4/5] overflow-hidden bg-ink">
                        <img src="@d.PreviewUrl" alt="@d.Title" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                    </div>
                    <p class="truncate px-3 py-2 text-xs text-cream/80">@d.Title</p>
                </a>
            }
        </div>
    </section>
}

<section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2">
        <a href="/catalog" class="rounded-3xl border border-white/10 bg-white/5 p-8 hover:border-gold/40">
            <p class="text-xs uppercase tracking-[0.2em] text-cyan">01 · Catálogo</p>
            <h2 class="mt-3 font-serif text-2xl">Vectores con precio</h2>
            <p class="mt-3 text-sm text-cream/80">Fútbol y vóley en CorelDRAW e Illustrator. Precio visible; paga y descarga.</p>
        </a>
        <a href="/programas" class="rounded-3xl border border-white/10 bg-white/5 p-8 hover:border-gold/40">
            <p class="text-xs uppercase tracking-[0.2em] text-gold">02 · El programa</p>
            <h2 class="mt-3 font-serif text-2xl">Arma en Corel e Illustrator</h2>
            <p class="mt-3 text-sm text-cream/80">CorelDRAW e Illustrator.</p>
        </a>
    </div>

    <div class="mt-10 grid gap-6 rounded-3xl border border-white/10 bg-white/[0.03] p-8 sm:grid-cols-3">
        <div>
            <p class="font-serif text-2xl text-white">Hecho en Perú</p>
            <p class="mt-2 text-sm text-cream/80">Para talleres de sublimación que trabajan uniformes deportivos.</p>
        </div>
        <div>
            <p class="font-serif text-2xl text-white">@(CatalogCount > 0 ? $"{CatalogCount} diseños" : "Catálogo CDR")</p>
            <p class="mt-2 text-sm text-cream/80">Vectores de fútbol y vóley listos para descargar con créditos.</p>
        </div>
        <div>
            <p class="font-serif text-2xl text-white">IA ilimitada</p>
            <p class="mt-2 text-sm text-cream/80">Con el mes activo, leer listas no gasta créditos. Los créditos son solo para descargar CDR.</p>
        </div>
    </div>
</section>

@code {
    private List<DesignDto> Preview = [];
    private int CatalogCount;

    private static readonly (string Num, string Title, string Text)[] Steps =
    [
        ("01", "Lista", "Pegas o subes los jugadores."),
        ("02", "Molde", "Tomas el molde por talla."),
        ("03", "Armado", "El programa duplica y pone nombre y dorsal."),
        ("04", "Corte", "Exportas e imprimes.")
    ];

    protected override async Task OnInitializedAsync()
    {
        var designs = await Api.GetDesignsAsync() ?? [];
        CatalogCount = designs.Count;
        Preview = designs.Take(6).ToList();
    }
}
