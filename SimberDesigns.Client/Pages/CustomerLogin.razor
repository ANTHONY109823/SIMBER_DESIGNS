@page "/login"
@page "/entrar"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Entrar · Simber Designs</PageTitle>

<section class="w-full max-w-sm">
    <h1 class="text-center font-serif text-3xl text-white">Simber <span class="text-gold">Designs</span></h1>
    <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
        <InputText class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white" placeholder="Email" @bind-Value="Email" />
        <InputText type="password" class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white" placeholder="Contraseña" @bind-Value="Password" />
        <button class="w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink" type="submit">Entrar</button>
    </EditForm>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mt-4 text-center text-sm text-rose-400">@Error</p>
    }
    <p class="mt-6 text-center text-sm text-cream/60">
        ¿No tienes cuenta? <a href="/register" class="text-gold hover:underline">Crear cuenta</a>
    </p>
    <p class="mt-3 text-center text-sm">
        <a href="/" class="text-cream/50 hover:text-white">Ir a la web</a>
    </p>
</section>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string? Error;

    private async Task Submit()
    {
        var result = await Api.LoginAsync(Email, Password);
        if (result is null)
        {
            Error = "Correo o contraseña incorrectos.";
            return;
        }

        await Auth.SignInAsync(result.Token);
        Nav.NavigateTo(string.Equals(result.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "/admin" : "/cuenta");
    }
}
