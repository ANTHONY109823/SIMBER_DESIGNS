@page "/login"
@page "/entrar"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Entrar · Simber Designs</PageTitle>

<div class="grid min-h-screen w-full lg:grid-cols-2">
    <section class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-sm">
            <a href="/" class="mb-8 flex items-center gap-2 font-serif text-2xl uppercase tracking-wide">
                <img src="favicon.png" alt="" class="h-8 w-8 rounded-md object-cover" />
                Simber <span class="text-gold">Designs</span>
            </a>
            <h1 class="font-serif text-3xl text-white">Entrar</h1>
            <p class="mt-2 text-sm text-cream/60">Tu cuenta para pagar el mes, bajar el programa y descargar CDR.</p>
            <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
                <InputText class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white" placeholder="Email" @bind-Value="Email" />
                <div class="relative">
                    <InputText type="@(ShowPassword ? "text" : "password")" class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 pr-24 text-white" placeholder="Contraseña" @bind-Value="Password" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-cream/55 hover:text-white" @onclick="() => ShowPassword = !ShowPassword">
                        @(ShowPassword ? "Ocultar" : "Mostrar")
                    </button>
                </div>
                <button class="w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink" type="submit">Entrar</button>
            </EditForm>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="mt-4 text-center text-sm text-rose-400">@Error</p>
            }
            <p class="mt-6 text-center text-sm text-cream/60">
                ¿No tienes cuenta? <a href="/register" class="text-gold hover:underline">Crear cuenta</a>
            </p>
            <p class="mt-3 text-center text-sm">
                <a href="/" class="text-cream/50 hover:text-white">Ir a la web</a>
            </p>
        </div>
    </section>
    <aside class="hidden items-center bg-gradient-to-br from-ink via-ink to-orange-950/40 px-12 lg:flex">
        <div class="max-w-md">
            <p class="text-xs uppercase tracking-[0.28em] text-gold">Tu mes incluye</p>
            <ul class="mt-6 space-y-4 text-sm text-cream/80">
                <li>Armado ilimitado en CorelDRAW e Illustrator</li>
                <li>Lectura de listas con IA ilimitada (no gasta créditos)</li>
                <li>Activación al instante en 1 PC</li>
                <li>Catálogo de vectores con créditos aparte</li>
            </ul>
        </div>
    </aside>
</div>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ShowPassword;
    private string? Error;

    private async Task Submit()
    {
        var result = await Api.LoginAsync(Email, Password);
        if (result is null)
        {
            Error = "Correo o contraseña incorrectos.";
            return;
        }

        await Auth.SignInAsync(result.Token);
        Nav.NavigateTo(string.Equals(result.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "/admin" : "/cuenta");
    }
}
