@page "/login"
@page "/entrar"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Entrar · Simber Designs</PageTitle>

<div class="grid min-h-screen w-full lg:grid-cols-2">
    <section class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-sm">
            <a href="/" class="mb-8 flex items-center gap-2 font-serif text-2xl uppercase tracking-wide">
                <img src="/favicon.png?v=4" alt="" class="h-8 w-8 rounded-md object-cover" />
                Simber <span class="text-gold">Designs</span>
            </a>
            <h1 class="font-serif text-3xl text-white">Entrar</h1>
            <p class="mt-2 text-sm text-cream/80">Tu cuenta para pagar el mes, bajar el programa y descargar CDR.</p>
            <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
                <label class="block text-sm">
                    <span class="text-cream/85">Correo</span>
                    <InputText autocomplete="username" class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" placeholder="tucorreo@email.com" @bind-Value="Email" />
                </label>
                <label class="block text-sm">
                    <span class="text-cream/85">Contraseña</span>
                    <div class="relative mt-2">
                        <InputText type="@(ShowPassword ? "text" : "password")" autocomplete="current-password" class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 pr-24 text-white outline-none focus:border-gold/60" @bind-Value="Password" />
                        <button type="button" class="absolute right-3 top-1/2 min-h-11 -translate-y-1/2 text-xs text-cream/80 hover:text-white" @onclick="() => ShowPassword = !ShowPassword">
                            @(ShowPassword ? "Ocultar" : "Mostrar")
                        </button>
                    </div>
                </label>
                <button class="min-h-11 w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink disabled:opacity-60" type="submit" disabled="@Busy">
                    @(Busy ? "Entrando…" : "Entrar")
                </button>
            </EditForm>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="mt-4 text-center text-sm text-rose-400" role="alert">@Error</p>
            }
            <p class="mt-6 text-center text-sm text-cream/80">
                ¿No tienes cuenta? <a href="/register" class="text-gold hover:underline">Crear cuenta</a>
            </p>
            <p class="mt-3 text-center text-sm">
                <a href="/" class="text-cream/75 hover:text-white">Ir a la web</a>
            </p>
        </div>
    </section>
    <aside class="hidden items-center bg-gradient-to-br from-ink via-ink to-orange-950/40 px-12 lg:flex">
        <div class="max-w-md">
            <p class="text-xs uppercase tracking-[0.28em] text-gold">Tu mes incluye</p>
            <ul class="mt-6 space-y-4 text-sm text-cream/85">
                <li>Un .exe para CorelDRAW y otro para Illustrator (gratis)</li>
                <li>El mes se activa desde tu cuenta, en 1 PC</li>
                <li>Lectura de listas con IA mientras el mes esté vigente</li>
                <li>Catálogo de vectores con créditos aparte</li>
            </ul>
        </div>
    </aside>
</div>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ShowPassword;
    private bool Busy;
    private string? Error;

    private async Task Submit()
    {
        Error = null;
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            Error = "Escribe tu correo y contraseña.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Api.LoginAsync(Email, Password);
            if (result is null)
            {
                Error = "Correo o contraseña incorrectos.";
                return;
            }

            await Auth.SignInAsync(result.Token);
            Nav.NavigateTo(string.Equals(result.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "/admin" : "/cuenta");
        }
        finally
        {
            Busy = false;
        }
    }
}
