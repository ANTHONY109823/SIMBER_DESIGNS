@page "/admin/catalog"
@attribute [Authorize(Roles = "Admin")]
@inject SimberApi Api

<PageTitle>Cargar catálogo · Admin</PageTitle>

<div class="relative mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Admin</p>
    <h1 class="mt-2 font-serif text-4xl text-white sm:text-5xl">Cargar catálogo</h1>
    <p class="mt-3 max-w-xl text-sm text-cream/60">
        Solo foto del diseño, archivo CDR, nombre, versión y precio. Sin PDF.
    </p>

    <form class="mt-10 space-y-6 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8" @onsubmit="Submit" @onsubmit:preventDefault>
        <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm">
                <span class="text-cream/70">Nombre del diseño</span>
                <InputText @bind-Value="Title" class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" placeholder="Jersey local 2026" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Deporte</span>
                <InputSelect @bind-Value="Category" class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60">
                    <option value="Fútbol">Fútbol</option>
                    <option value="Vóley">Vóley</option>
                </InputSelect>
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Precio (USD)</span>
                <InputNumber @bind-Value="Price" class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Versión CDR</span>
                <InputText @bind-Value="CdrVersion" class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" placeholder="X8 / 2021 / 24" />
            </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm">
                <span class="text-cream/70">Foto del diseño</span>
                <InputFile OnChange="OnPreviewSelected" accept=".jpg,.jpeg,.png,.webp,image/*" class="mt-2 w-full rounded-2xl border border-dashed border-white/20 bg-ink px-4 py-3 text-sm text-cream/70" />
                @if (!string.IsNullOrWhiteSpace(PreviewDataUrl))
                {
                    <img src="@PreviewDataUrl" alt="Vista previa" class="mt-3 h-40 w-full rounded-2xl object-cover" />
                }
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Archivo descargable (CDR)</span>
                <InputFile OnChange="OnFileSelected" accept=".cdr,.zip,.rar,.7z,.ai,.eps" class="mt-2 w-full rounded-2xl border border-dashed border-white/20 bg-ink px-4 py-3 text-sm text-cream/70" />
                @if (!string.IsNullOrWhiteSpace(FileName))
                {
                    <p class="mt-3 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 text-xs text-emerald-400">@FileName</p>
                }
            </label>
        </div>

        <button type="submit" disabled="@Saving" class="rounded-full bg-gold px-7 py-3 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
            @(Saving ? "Publicando..." : "Publicar en el catálogo")
        </button>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="text-sm @(Message.StartsWith("Listo") ? "text-emerald-400" : "text-rose-400")">@Message</p>
        }
    </form>

    <h2 class="mt-14 font-serif text-3xl text-white">Publicados</h2>
    @if (Designs.Count == 0)
    {
        <p class="mt-4 text-sm text-cream/45">Aún no hay diseños. Sube el primero con el formulario de arriba.</p>
    }
    else
    {
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
            @foreach (var design in Designs)
            {
                <article class="flex gap-4 rounded-3xl border border-white/10 bg-white/[0.03] p-4">
                    <img src="@design.PreviewUrl" alt="@design.Title" class="h-28 w-24 rounded-2xl object-cover" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs uppercase tracking-wider text-cyan">@design.Category</p>
                        <h3 class="truncate font-semibold text-white">@design.Title</h3>
                        <p class="mt-1 font-serif text-xl text-gold">$@design.PriceUsd.ToString("0.00")</p>
                        <p class="text-xs text-cream/45">CDR @(string.IsNullOrWhiteSpace(design.Description) ? "—" : design.Description)</p>
                        <button type="button" class="mt-3 text-xs text-rose-400 hover:text-rose-300" @onclick="() => Remove(design)">Quitar</button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private string Title { get; set; } = "";
    private string Category { get; set; } = "Fútbol";
    private decimal Price { get; set; } = 2;
    private string CdrVersion { get; set; } = "";
    private string? PreviewDataUrl;
    private string? FileName;
    private string? Message;
    private bool Saving;
    private IBrowserFile? PreviewFile;
    private IBrowserFile? DownloadFile;
    private byte[]? PreviewBytes;
    private List<DesignDto> Designs { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        Designs = await Api.GetDesignsAsync() ?? [];
    }

    private async Task OnPreviewSelected(InputFileChangeEventArgs e)
    {
        PreviewFile = e.File;
        if (PreviewFile is null)
        {
            PreviewBytes = null;
            PreviewDataUrl = null;
            return;
        }

        await using var stream = PreviewFile.OpenReadStream(8 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        PreviewBytes = memory.ToArray();
        var mime = string.IsNullOrWhiteSpace(PreviewFile.ContentType) ? "image/jpeg" : PreviewFile.ContentType;
        PreviewDataUrl = $"data:{mime};base64,{Convert.ToBase64String(PreviewBytes)}";
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        DownloadFile = e.File;
        FileName = e.File?.Name;
    }

    private async Task Submit()
    {
        Message = null;
        if (PreviewFile is null || DownloadFile is null || string.IsNullOrWhiteSpace(Title))
        {
            Message = "Completa nombre, foto y archivo CDR.";
            return;
        }

        var ext = Path.GetExtension(DownloadFile.Name).ToLowerInvariant();
        if (ext is ".pdf" or "")
        {
            Message = "El descargable debe ser CDR (o ZIP/RAR). No se acepta PDF.";
            return;
        }

        Saving = true;
        try
        {
            await using var preview = new MemoryStream(PreviewBytes ?? []);
            await using var file = DownloadFile.OpenReadStream(100 * 1024 * 1024);
            await Api.CreateDesignAsync(
                Title.Trim(),
                Category,
                Price,
                CdrVersion.Trim(),
                preview,
                PreviewFile.Name,
                PreviewFile.ContentType,
                file,
                DownloadFile.Name,
                DownloadFile.ContentType);
            Title = "";
            CdrVersion = "";
            PreviewFile = null;
            DownloadFile = null;
            PreviewBytes = null;
            PreviewDataUrl = null;
            FileName = null;
            Message = "Listo. El diseño ya está en el catálogo.";
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task Remove(DesignDto design)
    {
        try
        {
            await Api.DeleteDesignAsync(design.Id);
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }
}
