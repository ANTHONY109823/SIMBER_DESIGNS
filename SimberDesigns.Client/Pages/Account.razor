@page "/cuenta"
@attribute [Authorize]
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Cuenta</p>
    <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
    <p class="mt-1 text-sm text-cream/80">@Email</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Créditos CDR</p>
            <p class="mt-2 font-serif text-4xl text-gold">@Credits.ToString("0")</p>
            <a href="/catalog#creditos" class="mt-4 inline-block text-sm text-gold hover:underline">Recargar en el catálogo</a>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Programa</p>
            <p class="mt-2 text-sm text-cream/80">El mes se paga aquí, 1 PC.</p>
        </article>
    </div>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Activar o renovar</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <article class="rounded-3xl border border-emerald-500/25 bg-emerald-500/[0.05] p-6">
                <p class="text-xs uppercase tracking-wider text-emerald-300">CorelDRAW · 1 PC</p>
                <p class="mt-2 font-serif text-3xl text-gold">S/ @PluginPrice.ToString("0") <span class="text-base text-cream/70">/ 30 días</span></p>
                @if (LicenseFor("Corel") is { } corel)
                {
                    <p class="mt-2 text-sm @(corel.IsActive ? "text-white" : "text-cream/70")">
                        @(corel.IsActive ? $"Activo hasta {corel.ExpiresAt.ToLocalTime():dd/MM/yyyy}" : "Mes vencido")
                    </p>
                    <p class="mt-2 font-mono text-sm text-cyan">@corel.ActivationCode</p>
                }
                <button type="button" disabled="@Busy" @onclick='() => StartCheckout("plugin-corel")'
                        class="mt-5 w-full rounded-full bg-emerald-500 py-3 text-sm font-semibold text-ink hover:bg-emerald-400 disabled:opacity-60">
                    @(LicenseFor("Corel")?.IsActive == true ? "Renovar Corel" : "Activar Corel")
                </button>
            </article>
            <article class="rounded-3xl border border-cyan/25 bg-cyan/5 p-6">
                <p class="text-xs uppercase tracking-wider text-cyan">Illustrator · 1 PC</p>
                <p class="mt-2 font-serif text-3xl text-gold">S/ @PluginPrice.ToString("0") <span class="text-base text-cream/70">/ 30 días</span></p>
                @if (LicenseFor("Illustrator") is { } ilus)
                {
                    <p class="mt-2 text-sm @(ilus.IsActive ? "text-white" : "text-cream/70")">
                        @(ilus.IsActive ? $"Activo hasta {ilus.ExpiresAt.ToLocalTime():dd/MM/yyyy}" : "Mes vencido")
                    </p>
                    <p class="mt-2 font-mono text-sm text-cyan">@ilus.ActivationCode</p>
                }
                <button type="button" disabled="@Busy" @onclick='() => StartCheckout("plugin-illustrator")'
                        class="mt-5 w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                    @(LicenseFor("Illustrator")?.IsActive == true ? "Renovar Illustrator" : "Activar Illustrator")
                </button>
            </article>
        </div>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="mt-4 text-sm text-rose-400" role="alert">@Error</p>
        }
    </section>

    <div class="mt-8 flex flex-wrap gap-3">
        @if (HasCorel)
        {
            <a href="/api/plugin/download/corel" data-enhance-nav="false" class="rounded-full bg-emerald-500 px-6 py-3 text-sm font-semibold text-ink hover:bg-emerald-400">Descargar CorelDRAW</a>
        }
        @if (HasIllustrator)
        {
            <a href="/api/plugin/download/illustrator" data-enhance-nav="false" class="rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink hover:bg-orange-400">Descargar Illustrator</a>
        }
        <a href="/programas" class="rounded-full border border-white/20 px-6 py-3 text-sm text-cream hover:border-gold/50">Programas</a>
    </div>

    @if (CreditLogs.Count > 0 || Transactions.Count > 0)
    {
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            @if (CreditLogs.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="@(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Transactions.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Pagos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private decimal PluginPrice = 56;
    private List<PluginLicenseDto> Licenses = [];
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private bool HasCorel;
    private bool HasIllustrator;
    private bool Busy;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Transactions = dash.Transactions ?? [];
        }

        Licenses = await Api.GetPluginLicensesAsync() ?? [];
        var store = await Api.GetStorefrontAsync();
        HasCorel = store?.HasCorelDownload == true;
        HasIllustrator = store?.HasIllustratorDownload == true;
        if (store is not null && store.PluginMonthPricePen > 0)
            PluginPrice = store.PluginMonthPricePen;
    }

    private PluginLicenseDto? LicenseFor(string edition)
        => Licenses.FirstOrDefault(l => string.Equals(l.Edition, edition, StringComparison.OrdinalIgnoreCase));

    private async Task StartCheckout(string kind)
    {
        Error = null;
        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, null, null);
            if (string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                Error = "No se pudo abrir Mercado Pago.";
                return;
            }

            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
