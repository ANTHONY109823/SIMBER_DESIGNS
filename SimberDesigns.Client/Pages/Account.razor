@page "/cuenta"
@attribute [Authorize(Roles = "Customer")]
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Mi cuenta</p>
    <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
    <p class="mt-1 text-sm text-cream/80">@Email</p>

    <div class="mt-6">
        <a href="/recargar" class="inline-flex rounded-full bg-gold px-5 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400">
            Recargar créditos
        </a>
    </div>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Tus servicios</h2>
        <p class="mt-1 text-sm text-cream/70">Solo lo que tienes. Los créditos son para diseños; el mes de programa es aparte.</p>
        <div class="mt-5 space-y-3">
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs uppercase tracking-wider text-cream/45">Catálogo CDR</p>
                        <p class="mt-1 text-white">Créditos para descargar vectores</p>
                    </div>
                    <p class="font-serif text-3xl text-gold">@Credits.ToString("0")</p>
                </div>
            </article>

            @if (Licenses.Count == 0)
            {
                <article class="rounded-2xl border border-white/10 bg-white/[0.02] px-5 py-4">
                    <p class="text-xs uppercase tracking-wider text-cream/45">Programas</p>
                    <p class="mt-1 text-sm text-cream/60">Sin mes activo de Corel ni Illustrator.</p>
                </article>
            }
            else
            {
                @foreach (var lic in Licenses)
                {
                    <article class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-cream/45">Programa</p>
                                <p class="mt-1 text-white">@lic.Edition</p>
                            </div>
                            <span class="text-sm @(lic.IsActive ? "text-emerald-300" : "text-cream/50")">
                                @(lic.IsActive ? $"activo · {lic.ExpiresAt.ToLocalTime():dd/MM/yyyy}" : "vencido")
                            </span>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Diseños desbloqueados</h2>
        <p class="mt-1 text-sm text-cream/70">Si ya lo pagaste o canjeaste, puedes volver a descargarlo.</p>
        @if (Unlocked.Count == 0)
        {
            <p class="mt-4 text-sm text-cream/50">Aún no tienes diseños desbloqueados.</p>
        }
        else
        {
            <ul class="mt-4 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                @foreach (var d in Unlocked)
                {
                    <li class="flex items-center gap-3 px-4 py-3">
                        <img src="@d.PreviewUrl" alt="" class="h-12 w-10 shrink-0 rounded object-cover" />
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm text-white">@d.Title</p>
                            <p class="text-xs text-cream/45">@(d.UnlockedViaSubscription ? "Por membresía" : "Canjeado / pagado")</p>
                        </div>
                        <button type="button" disabled="@Busy" @onclick="() => Redownload(d)"
                                class="shrink-0 rounded-full border border-gold/40 px-3 py-1.5 text-xs font-semibold text-gold hover:bg-gold/10 disabled:opacity-50">
                            Descargar
                        </button>
                    </li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(DownloadMsg))
        {
            <p class="mt-3 text-sm @(DownloadOk ? "text-emerald-300" : "text-rose-400")">@DownloadMsg</p>
        }
    </section>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Datos de la cuenta</h2>
        <div class="mt-4 space-y-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm">
            <div class="flex justify-between gap-4"><span class="text-cream/50">Nombre</span><span class="text-white">@Name</span></div>
            <div class="flex justify-between gap-4"><span class="text-cream/50">Correo</span><span class="text-white">@Email</span></div>
            <div class="flex justify-between gap-4"><span class="text-cream/50">Créditos</span><span class="text-gold">@Credits.ToString("0")</span></div>
        </div>

        <h3 class="mt-8 font-serif text-xl text-white">Cambiar contraseña</h3>
        <div class="mt-4 space-y-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <label class="block text-sm">
                <span class="text-cream/70">Contraseña actual</span>
                <input type="password" @bind="_currentPassword" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Nueva contraseña</span>
                <input type="password" @bind="_newPassword" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Repetir nueva</span>
                <input type="password" @bind="_newPassword2" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <button type="button" disabled="@Busy" @onclick="ChangePassword"
                    class="rounded-full bg-gold px-5 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                Guardar contraseña
            </button>
            @if (!string.IsNullOrWhiteSpace(PasswordMsg))
            {
                <p class="text-sm @(PasswordOk ? "text-emerald-300" : "text-rose-400")">@PasswordMsg</p>
            }
        </div>
    </section>

    @if (CreditLogs.Count > 0 || Transactions.Count > 0)
    {
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            @if (CreditLogs.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="@(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Transactions.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Historial de pagos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private List<PluginLicenseDto> Licenses = [];
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private List<UnlockedDesignDto> Unlocked = [];
    private bool Busy;
    private string? DownloadMsg;
    private bool DownloadOk;
    private string? PasswordMsg;
    private bool PasswordOk;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _newPassword2 = "";

    protected override async Task OnInitializedAsync()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Unlocked = dash.UnlockedDesigns ?? [];
            Transactions = dash.Transactions ?? [];
        }

        try { Licenses = await Api.GetPluginLicensesAsync() ?? []; }
        catch { Licenses = []; }
    }

    private async Task Redownload(UnlockedDesignDto design)
    {
        DownloadMsg = null;
        Busy = true;
        try
        {
            var dl = await Api.DownloadAsync(design.Id);
            if (string.IsNullOrWhiteSpace(dl?.DownloadUrl))
            {
                DownloadOk = false;
                DownloadMsg = "No se pudo obtener el archivo.";
                return;
            }

            Nav.NavigateTo(dl.DownloadUrl, forceLoad: true);
            DownloadOk = true;
            DownloadMsg = "Descarga iniciada.";
        }
        catch (Exception ex)
        {
            DownloadOk = false;
            DownloadMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ChangePassword()
    {
        PasswordMsg = null;
        if (_newPassword != _newPassword2)
        {
            PasswordOk = false;
            PasswordMsg = "Las contraseñas nuevas no coinciden.";
            return;
        }

        Busy = true;
        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            PasswordOk = true;
            PasswordMsg = "Contraseña actualizada.";
            _currentPassword = _newPassword = _newPassword2 = "";
        }
        catch (Exception ex)
        {
            PasswordOk = false;
            PasswordMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private static string CleanError(string raw)
    {
        var t = raw.Trim();
        if (t.Length >= 2 && t[0] == '"' && t[^1] == '"')
            t = t[1..^1];
        return string.IsNullOrWhiteSpace(t) ? "Error." : t;
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
