@page "/cuenta"
@attribute [Authorize(Roles = "Customer")]
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Mi cuenta</p>
    <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
    <p class="mt-1 text-sm text-cream/80">@Email</p>

    <div class="mt-6 flex flex-wrap gap-3">
        <a href="#comprar" class="inline-flex rounded-full bg-gold px-5 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400">
            Comprar / activar
        </a>
    </div>

    @if (_forcePwd)
    {
        <div class="mt-8 rounded-2xl border border-amber-400/40 bg-amber-500/10 px-5 py-4 text-sm text-amber-100">
            Debes cambiar la contraseña temporal antes de seguir. Usa el formulario de abajo.
        </div>
    }

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Tus servicios</h2>
        <p class="mt-1 text-sm text-cream/70">Solo lo que tienes. Los créditos son para diseños; el periodo del programa es aparte.</p>
        <div class="mt-5 space-y-3">
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs uppercase tracking-wider text-cream/45">Catálogo CDR</p>
                        <p class="mt-1 text-white">Créditos para descargar vectores</p>
                    </div>
                    <p class="font-serif text-3xl text-gold">@Credits.ToString("0")</p>
                </div>
            </article>

            @if (Licenses.Count == 0)
            {
                <article class="rounded-2xl border border-white/10 bg-white/[0.02] px-5 py-4">
                    <p class="text-xs uppercase tracking-wider text-cream/45">Programas</p>
                    <p class="mt-1 text-sm text-cream/60">Sin periodo activo de Corel ni Illustrator.</p>
                </article>
            }
            else
            {
                @foreach (var lic in Licenses)
                {
                    <article class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-cream/45">Programa</p>
                                <p class="mt-1 text-white">@lic.Edition</p>
                            </div>
                            <span class="text-sm @(lic.IsActive ? "text-emerald-300" : "text-cream/50")">
                                @(lic.IsActive ? $"activo · {lic.ExpiresAt.ToLocalTime():dd/MM/yyyy}" : "vencido")
                            </span>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <section id="comprar" class="mt-10 scroll-mt-24">
        <h2 class="font-serif text-2xl text-white">Comprar y activar</h2>
        <p class="mt-1 text-sm text-cream/70">Paga con tarjeta aquí mismo, sin salir de la web. El periodo del programa y los créditos del catálogo son cosas aparte.</p>

        <div class="mt-4 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <div class="inline-flex flex-wrap gap-1 rounded-full border border-white/10 bg-ink p-1 text-sm">
                <button type="button" @onclick='() => _buyTab = "programa"' class="@TabClass("programa")">Programa (Corel / Illustrator)</button>
                <button type="button" @onclick='() => _buyTab = "creditos"' class="@TabClass("creditos")">Créditos del catálogo</button>
            </div>

            @if (_buyTab == "programa")
            {
                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                    <div>
                        <h3 class="text-sm font-semibold text-white">CorelDRAW</h3>
                        <div class="mt-3 space-y-2">
                            @foreach (var plan in Plans)
                            {
                                var m = plan.Months;
                                <button type="button" disabled="@Busy" @onclick='() => BuyPlan("plugin-corel", m)'
                                        class="flex w-full items-center justify-between rounded-xl border border-emerald-500/30 bg-emerald-500/5 px-4 py-2.5 text-left text-sm hover:bg-emerald-500/15 disabled:opacity-50">
                                    <span class="text-white">@plan.Label</span>
                                    <span class="font-semibold text-emerald-300">S/ @plan.PricePen.ToString("0.00")</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div>
                        <h3 class="text-sm font-semibold text-white">Illustrator</h3>
                        <div class="mt-3 space-y-2">
                            @foreach (var plan in Plans)
                            {
                                var m = plan.Months;
                                <button type="button" disabled="@Busy" @onclick='() => BuyPlan("plugin-illustrator", m)'
                                        class="flex w-full items-center justify-between rounded-xl border border-orange-500/30 bg-orange-500/5 px-4 py-2.5 text-left text-sm hover:bg-orange-500/15 disabled:opacity-50">
                                    <span class="text-white">@plan.Label</span>
                                    <span class="font-semibold text-orange-300">S/ @plan.PricePen.ToString("0.00")</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                @if (Packages.Count == 0)
                {
                    <p class="mt-5 text-sm text-cream/50">No hay paquetes de créditos cargados aún.</p>
                }
                else
                {
                    <div class="mt-5 grid gap-3 sm:grid-cols-3">
                        @foreach (var pack in Packages)
                        {
                            <button type="button" disabled="@Busy" @onclick="() => BuyCredits(pack)"
                                    class="rounded-2xl border border-gold/25 bg-gold/5 p-4 text-left hover:bg-gold/10 disabled:opacity-50">
                                <p class="font-serif text-2xl text-gold">S/ @pack.PriceUsd.ToString("0")</p>
                                <p class="mt-1 text-sm text-cream/70">@(pack.CreditsAmount + pack.BonusAmount) créditos</p>
                            </button>
                        }
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(BuyMsg))
            {
                <p class="mt-3 text-sm text-rose-400">@BuyMsg</p>
            }
        </div>
    </section>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Claves de activación</h2>
        <p class="mt-1 text-sm text-cream/70">Tras pagar (Mercado Pago o directo), canjea aquí tu serial de 16 caracteres. Luego abre el .exe e inicia sesión para activar en tu PC.</p>
        <div class="mt-4 flex flex-wrap gap-2">
            <input @bind="_redeemCode" placeholder="Tu clave de 16 caracteres" class="min-w-[16rem] flex-1 rounded-xl border border-white/10 bg-ink px-3 py-2 font-mono text-sm text-white" />
            <button type="button" disabled="@Busy" @onclick="RedeemKey"
                    class="rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-ink hover:bg-emerald-400 disabled:opacity-60">
                Canjear
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(RedeemMsg))
        {
            <p class="mt-2 text-sm @(RedeemOk ? "text-emerald-300" : "text-rose-400")">@RedeemMsg</p>
        }
        @if (PeriodKeys.Count > 0)
        {
            <ul class="mt-4 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                @foreach (var k in PeriodKeys)
                {
                    <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                        <div>
                            <p class="font-mono text-emerald-300">@k.Code</p>
                            <p class="text-xs text-cream/45">@k.Edition · @k.Days días · @k.Status</p>
                        </div>
                        @if (k.Status == "Pending")
                        {
                            <button type="button" disabled="@Busy" @onclick="() => RedeemExisting(k.Code)"
                                    class="rounded-full border border-emerald-400/40 px-3 py-1.5 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/10 disabled:opacity-50">
                                Canjear ahora
                            </button>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Diseños desbloqueados</h2>
        <p class="mt-1 text-sm text-cream/70">Si ya lo pagaste o canjeaste, puedes volver a descargarlo.</p>
        @if (Unlocked.Count == 0)
        {
            <p class="mt-4 text-sm text-cream/50">Aún no tienes diseños desbloqueados.</p>
        }
        else
        {
            <ul class="mt-4 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                @foreach (var d in Unlocked)
                {
                    <li class="flex items-center gap-3 px-4 py-3">
                        <img src="@d.PreviewUrl" alt="" class="h-12 w-10 shrink-0 rounded object-cover" />
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm text-white">@d.Title</p>
                            <p class="text-xs text-cream/45">@(d.UnlockedViaSubscription ? "Por membresía" : "Canjeado / pagado")</p>
                        </div>
                        <button type="button" disabled="@Busy" @onclick="() => Redownload(d)"
                                class="shrink-0 rounded-full border border-gold/40 px-3 py-1.5 text-xs font-semibold text-gold hover:bg-gold/10 disabled:opacity-50">
                            Descargar
                        </button>
                    </li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(DownloadMsg))
        {
            <p class="mt-3 text-sm @(DownloadOk ? "text-emerald-300" : "text-rose-400")">@DownloadMsg</p>
        }
    </section>

    <section class="mt-10">
        <h2 class="font-serif text-2xl text-white">Datos de la cuenta</h2>
        <div class="mt-4 space-y-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm">
            <div class="flex justify-between gap-4"><span class="text-cream/50">Nombre</span><span class="text-white">@Name</span></div>
            <div class="flex justify-between gap-4"><span class="text-cream/50">Correo</span><span class="text-white">@Email</span></div>
            <div class="flex justify-between gap-4"><span class="text-cream/50">Créditos</span><span class="text-gold">@Credits.ToString("0")</span></div>
        </div>

        <h3 class="mt-8 font-serif text-xl text-white">Cambiar contraseña</h3>
        <div class="mt-4 space-y-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <label class="block text-sm">
                <span class="text-cream/70">Contraseña actual</span>
                <input type="password" @bind="_currentPassword" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Nueva contraseña</span>
                <input type="password" @bind="_newPassword" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <label class="block text-sm">
                <span class="text-cream/70">Repetir nueva</span>
                <input type="password" @bind="_newPassword2" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2 text-white" />
            </label>
            <button type="button" disabled="@Busy" @onclick="ChangePassword"
                    class="rounded-full bg-gold px-5 py-2.5 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                Guardar contraseña
            </button>
            @if (!string.IsNullOrWhiteSpace(PasswordMsg))
            {
                <p class="text-sm @(PasswordOk ? "text-emerald-300" : "text-rose-400")">@PasswordMsg</p>
            }
        </div>
    </section>

    @if (CreditLogs.Count > 0 || Transactions.Count > 0)
    {
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            @if (CreditLogs.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="@(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Transactions.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Historial de pagos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

<CardPayModal @ref="_payModal" OnApproved="OnPaid" />

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private List<PluginLicenseDto> Licenses = [];
    private List<PluginPeriodKeyDto> PeriodKeys = [];
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private List<UnlockedDesignDto> Unlocked = [];
    private decimal MonthPricePen;
    private List<PluginPlanOptionDto> Plans = [];
    private List<CreditPackageDto> Packages = [];
    private CardPayModal? _payModal;
    private string _buyTab = "programa";
    private string? BuyMsg;
    private bool Busy;
    private string? DownloadMsg;
    private bool DownloadOk;
    private string? PasswordMsg;
    private bool PasswordOk;
    private string? RedeemMsg;
    private bool RedeemOk;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _newPassword2 = "";
    private string _redeemCode = "";
    private bool _forcePwd;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _forcePwd = uri.Query.Contains("cambiar=1", StringComparison.OrdinalIgnoreCase);

        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Unlocked = dash.UnlockedDesigns ?? [];
            Transactions = dash.Transactions ?? [];
        }

        try { Licenses = await Api.GetPluginLicensesAsync() ?? []; }
        catch { Licenses = []; }

        try { PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? []; }
        catch { PeriodKeys = []; }

        var store = await Api.GetStorefrontAsync();
        MonthPricePen = store?.PluginMonthPricePen ?? 0;
        Packages = store?.Packages ?? [];
        Plans = store?.PluginPlans ??
        [
            new(1, 30, MonthPricePen, "1 mes (30 días)"),
            new(3, 90, MonthPricePen * 3, "3 meses (90 días)"),
            new(6, 180, MonthPricePen * 6, "6 meses (180 días)"),
            new(12, 365, MonthPricePen * 12, "12 meses (365 días)")
        ];
    }

    private string TabClass(string tab) => _buyTab == tab
        ? "rounded-full bg-gold px-4 py-1.5 font-semibold text-ink"
        : "rounded-full px-4 py-1.5 text-cream/70 hover:text-white";

    private async Task BuyPlan(string kind, int months)
    {
        BuyMsg = null;
        if (_payModal is { CardEnabled: true })
        {
            var plan = Plans.FirstOrDefault(p => p.Months == months);
            var amount = plan?.PricePen ?? MonthPricePen * months;
            var label = (kind.Contains("corel") ? "CorelDRAW · " : "Illustrator · ") + (plan?.Label ?? $"{months} mes(es)");
            _payModal.Open(kind, months, null, amount, label);
            return;
        }
        await RedirectCheckout(kind, null, months);
    }

    private async Task BuyCredits(CreditPackageDto pack)
    {
        BuyMsg = null;
        if (_payModal is { CardEnabled: true })
        {
            var creditos = pack.CreditsAmount + pack.BonusAmount;
            _payModal.Open("credits", null, pack.Id, pack.PriceUsd, $"Créditos Simber · {creditos:0}");
            return;
        }
        await RedirectCheckout("credits", pack.Id, null);
    }

    private async Task RedirectCheckout(string kind, Guid? packageId, int? months)
    {
        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, packageId, null, months);
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
                Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
            else
                BuyMsg = "No se pudo iniciar el pago.";
        }
        catch (Exception ex) { BuyMsg = CleanError(ex.Message); }
        finally { Busy = false; }
    }

    // Tras un pago aprobado con tarjeta: refresca saldo, licencias y claves.
    private async Task OnPaid()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Transactions = dash.Transactions ?? [];
        }
        try { Licenses = await Api.GetPluginLicensesAsync() ?? []; } catch { }
        try { PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? []; } catch { }
        StateHasChanged();
    }

    private Task RedeemKey() => RedeemExisting(_redeemCode);

    private async Task RedeemExisting(string code)
    {
        RedeemMsg = null;
        Busy = true;
        try
        {
            await Api.RedeemPeriodKeyAsync(code);
            RedeemOk = true;
            RedeemMsg = "Clave canjeada. Ya puedes activar el .exe con tu cuenta.";
            _redeemCode = "";
            Licenses = await Api.GetPluginLicensesAsync() ?? [];
            PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? [];
        }
        catch (Exception ex)
        {
            RedeemOk = false;
            RedeemMsg = CleanError(ex.Message);
        }
        finally { Busy = false; }
    }

    private async Task Redownload(UnlockedDesignDto design)
    {
        DownloadMsg = null;
        Busy = true;
        try
        {
            var dl = await Api.DownloadAsync(design.Id);
            if (string.IsNullOrWhiteSpace(dl?.DownloadUrl))
            {
                DownloadOk = false;
                DownloadMsg = "No se pudo obtener el archivo.";
                return;
            }

            Nav.NavigateTo(dl.DownloadUrl, forceLoad: true);
            DownloadOk = true;
            DownloadMsg = "Descarga iniciada.";
        }
        catch (Exception ex)
        {
            DownloadOk = false;
            DownloadMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ChangePassword()
    {
        PasswordMsg = null;
        if (_newPassword != _newPassword2)
        {
            PasswordOk = false;
            PasswordMsg = "Las contraseñas nuevas no coinciden.";
            return;
        }

        Busy = true;
        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            PasswordOk = true;
            PasswordMsg = "Contraseña actualizada.";
            _currentPassword = _newPassword = _newPassword2 = "";
            _forcePwd = false;
            if (Nav.Uri.Contains("cambiar=", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/cuenta");
            }
        }
        catch (Exception ex)
        {
            PasswordOk = false;
            PasswordMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private static string CleanError(string raw)
    {
        var t = raw.Trim();
        if (t.Length >= 2 && t[0] == '"' && t[^1] == '"')
            t = t[1..^1];
        return string.IsNullOrWhiteSpace(t) ? "Error." : t;
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
