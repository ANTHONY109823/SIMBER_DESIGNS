@page "/cuenta"
@attribute [Authorize]
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Cuenta</p>
    <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
    <p class="mt-1 text-sm text-cream/80">@Email</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Créditos CDR</p>
            <p class="mt-2 font-serif text-4xl text-gold">@Credits.ToString("0")</p>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Programas</p>
            <p class="mt-2 text-sm text-cream/80">Descarga y activa el mes en Programas.</p>
            <a href="/programas#activar" class="mt-4 inline-flex rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-ink hover:bg-emerald-400">Ir a Programas</a>
        </article>
    </div>

    <section id="creditos" class="mt-10 scroll-mt-24">
        <h2 class="font-serif text-2xl text-white">Recarga créditos</h2>
        <p class="mt-1 text-sm text-cream/70">Solo para descargar vectores del catálogo.</p>
        @if (Packages.Count == 0)
        {
            <p class="mt-4 text-sm text-cream/50">No hay paquetes cargados aún.</p>
        }
        else
        {
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                @foreach (var pack in Packages)
                {
                    <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                        <p class="font-serif text-3xl text-gold">S/ @pack.PriceUsd.ToString("0")</p>
                        <p class="mt-1 text-sm text-cream/70">@(pack.CreditsAmount + pack.BonusAmount) créditos</p>
                        <button type="button" disabled="@Busy" @onclick="() => PayCredits(pack)"
                                class="mt-4 w-full rounded-full bg-gold py-2.5 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                            Comprar
                        </button>
                    </article>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="mt-4 text-sm text-rose-400" role="alert">@Error</p>
        }
    </section>

    @if (Licenses.Count > 0)
    {
        <section class="mt-10">
            <h2 class="font-serif text-xl text-white">Tus activaciones</h2>
            <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                @foreach (var lic in Licenses)
                {
                    <li class="px-4 py-3 text-sm">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-white">@lic.Edition</span>
                            <span class="@(lic.IsActive ? "text-emerald-300" : "text-cream/50")">
                                @(lic.IsActive ? $"activo · {lic.ExpiresAt.ToLocalTime():dd/MM/yyyy}" : "vencido")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(lic.ActivationCode))
                        {
                            <p class="mt-1 font-mono text-xs text-cyan">@lic.ActivationCode</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (CreditLogs.Count > 0 || Transactions.Count > 0)
    {
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            @if (CreditLogs.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="@(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Transactions.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Pagos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private List<PluginLicenseDto> Licenses = [];
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private bool Busy;
    private string? Error;
    private List<CreditPackageDto> Packages = [];

    protected override async Task OnInitializedAsync()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Transactions = dash.Transactions ?? [];
        }

        Licenses = await Api.GetPluginLicensesAsync() ?? [];
        var store = await Api.GetStorefrontAsync();
        Packages = store?.Packages ?? [];
    }

    private async Task PayCredits(CreditPackageDto pack)
    {
        Error = null;
        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync("credits", pack.Id, null);
            if (string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                Error = "No se pudo abrir Mercado Pago.";
                return;
            }

            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Error = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private static string CleanError(string raw)
    {
        var t = raw.Trim();
        if (t.Length >= 2 && t[0] == '"' && t[^1] == '"')
            t = t[1..^1];
        return string.IsNullOrWhiteSpace(t) ? "No se pudo iniciar el pago." : t;
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
