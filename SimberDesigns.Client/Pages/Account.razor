@page "/cuenta"
@attribute [Authorize(Roles = "Customer")]
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
            <p class="text-xs uppercase tracking-[0.28em] text-gold">Mi cuenta</p>
            <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
            <p class="mt-1 text-sm text-cream/80">@Email</p>
        </div>
        <div class="min-w-[13rem] rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-right">
            <p class="text-xs uppercase tracking-wider text-cream/45">Créditos</p>
            <p class="font-serif text-4xl text-gold">@Credits.ToString("0")</p>
            @if (Licenses.Any(l => l.IsActive))
            {
                <div class="mt-3 space-y-1 border-t border-white/10 pt-3 text-xs">
                    @foreach (var lic in Licenses.Where(l => l.IsActive))
                    {
                        <p class="text-emerald-300">@lic.Edition · hasta @lic.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    }
                </div>
            }
        </div>
    </div>

    @if (_forcePwd)
    {
        <div class="mt-8 rounded-2xl border border-amber-400/40 bg-amber-500/10 px-5 py-4 text-sm text-amber-100">
            Debes cambiar la contraseña temporal antes de seguir. Usa el botón “Cambiar contraseña”.
        </div>
    }

    <div class="mt-10 grid items-start gap-6 lg:grid-cols-3">

        <!-- Columna 1: historial -->
        <div class="space-y-6">
            <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                <h2 class="font-serif text-xl text-white">Historial de pagos</h2>
                @if (Transactions.Count == 0)
                {
                    <p class="mt-4 text-sm text-cream/50">Aún no tienes pagos.</p>
                }
                else
                {
                    <ul class="mt-4 divide-y divide-white/5">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between gap-3 py-3 text-sm">
                                <span class="min-w-0 flex-1 truncate text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="shrink-0 text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (CreditLogs.Count > 0)
            {
                <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-4 divide-y divide-white/5">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between gap-3 py-3 text-sm">
                                <span class="min-w-0 flex-1 truncate text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="shrink-0 @(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <!-- Columna 2: planes, créditos, claves y contraseña -->
        <div class="space-y-6">
            <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                <h2 class="font-serif text-2xl text-white">Planes</h2>
                <p class="mt-1 text-sm text-cream/70">US$15 por mes. Elige el programa y la duración; el serial llega abajo para canjearlo.</p>

                <div class="mt-4 grid grid-cols-2 gap-2">
                    <button type="button" @onclick='() => _edition = "plugin-corel"' class="@EditionClass("plugin-corel")">CorelDRAW</button>
                    <button type="button" @onclick='() => _edition = "plugin-illustrator"' class="@EditionClass("plugin-illustrator")">Illustrator</button>
                </div>

                <div class="mt-4 space-y-2">
                    @foreach (var plan in ThreePlans)
                    {
                        var m = plan.Months;
                        <button type="button" disabled="@Busy" @onclick="() => BuyPlan(m)"
                                class="flex w-full items-center justify-between rounded-xl border border-gold/25 bg-gold/5 px-4 py-3 text-left hover:bg-gold/10 disabled:opacity-50">
                            <span>
                                <span class="block text-sm text-white">@plan.Label</span>
                                <span class="block text-xs text-cream/45">S/ @plan.PricePen.ToString("0.00")</span>
                            </span>
                            <span class="font-serif text-2xl text-gold">$@Usd(m).ToString("0")</span>
                        </button>
                    }
                </div>
            </section>

            <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                <h2 class="font-serif text-xl text-white">Créditos del catálogo</h2>
                <p class="mt-1 text-sm text-cream/70">Solo para comprar diseños del catálogo.</p>
                @if (Packages.Count == 0)
                {
                    <p class="mt-4 text-sm text-cream/50">No hay paquetes cargados aún.</p>
                }
                else
                {
                    <div class="mt-4 space-y-2">
                        @foreach (var pack in Packages)
                        {
                            <button type="button" disabled="@Busy" @onclick="() => BuyCredits(pack)"
                                    class="flex w-full items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-left hover:bg-white/[0.06] disabled:opacity-50">
                                <span class="text-sm text-cream/80">@(pack.CreditsAmount + pack.BonusAmount) créditos</span>
                                <span class="font-serif text-xl text-gold">S/ @pack.PriceUsd.ToString("0")</span>
                            </button>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(BuyMsg))
                {
                    <p class="mt-3 text-sm text-rose-400">@BuyMsg</p>
                }
            </section>

            <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                <h2 class="font-serif text-xl text-white">Claves de activación</h2>
                <p class="mt-1 text-sm text-cream/70">Tras pagar, canjea aquí tu serial de 16 caracteres. Luego abre el .exe e inicia sesión para activar en tu PC.</p>
                <div class="mt-4 flex flex-wrap gap-2">
                    <input @bind="_redeemCode" placeholder="Clave de 16 caracteres" class="min-w-[12rem] flex-1 rounded-xl border border-white/10 bg-ink px-3 py-2 font-mono text-sm text-white" />
                    <button type="button" disabled="@Busy" @onclick="RedeemKey"
                            class="rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-ink hover:bg-emerald-400 disabled:opacity-60">
                        Canjear
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(RedeemMsg))
                {
                    <p class="mt-2 text-sm @(RedeemOk ? "text-emerald-300" : "text-rose-400")">@RedeemMsg</p>
                }
                @if (PeriodKeys.Count > 0)
                {
                    <ul class="mt-4 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var k in PeriodKeys)
                        {
                            <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                                <div>
                                    <p class="font-mono text-emerald-300">@k.Code</p>
                                    <p class="text-xs text-cream/45">@k.Edition · @k.Days días · @k.Status</p>
                                </div>
                                @if (k.Status == "Pending")
                                {
                                    <button type="button" disabled="@Busy" @onclick="() => RedeemExisting(k.Code)"
                                            class="rounded-full border border-emerald-400/40 px-3 py-1.5 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/10 disabled:opacity-50">
                                        Canjear ahora
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <button type="button" @onclick="() => _showPwd = true"
                    class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-left text-sm text-cream/80 hover:bg-white/[0.06]">
                🔒 Cambiar contraseña
            </button>
        </div>

        <!-- Columna 3: descargas -->
        <div class="space-y-6">
            <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                <h2 class="font-serif text-xl text-white">Diseños desbloqueados</h2>
                <p class="mt-1 text-sm text-cream/70">Si ya lo pagaste o canjeaste, puedes volver a descargarlo.</p>
                @if (Unlocked.Count == 0)
                {
                    <p class="mt-4 text-sm text-cream/50">Aún no tienes diseños desbloqueados.</p>
                }
                else
                {
                    <ul class="mt-4 divide-y divide-white/5">
                        @foreach (var d in Unlocked)
                        {
                            <li class="flex items-center gap-3 py-3">
                                <img src="@d.PreviewUrl" alt="" class="h-12 w-10 shrink-0 rounded object-cover" />
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm text-white">@d.Title</p>
                                    <p class="text-xs text-cream/45">@(d.UnlockedViaSubscription ? "Por membresía" : "Canjeado / pagado")</p>
                                </div>
                                <button type="button" disabled="@Busy" @onclick="() => Redownload(d)"
                                        class="shrink-0 rounded-full border border-gold/40 px-3 py-1.5 text-xs font-semibold text-gold hover:bg-gold/10 disabled:opacity-50">
                                    Descargar
                                </button>
                            </li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(DownloadMsg))
                {
                    <p class="mt-3 text-sm @(DownloadOk ? "text-emerald-300" : "text-rose-400")">@DownloadMsg</p>
                }
            </section>
        </div>
    </div>
</div>

@if (_showPwd)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/70 p-4 backdrop-blur-sm" @onclick="() => _showPwd = false">
        <div class="mt-16 w-full max-w-md rounded-3xl border border-white/10 bg-ink p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-wider text-gold">Seguridad</p>
                    <h3 class="mt-1 font-serif text-xl text-white">Cambiar contraseña</h3>
                </div>
                <button type="button" @onclick="() => _showPwd = false" class="rounded-full p-2 text-cream/60 hover:bg-white/10 hover:text-white">✕</button>
            </div>
            <div class="mt-5 space-y-3">
                <input type="password" @bind="_currentPassword" placeholder="Contraseña actual" class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-white outline-none focus:border-gold/60" />
                <input type="password" @bind="_newPassword" placeholder="Nueva contraseña" class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-white outline-none focus:border-gold/60" />
                <input type="password" @bind="_newPassword2" placeholder="Repetir nueva" class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-white outline-none focus:border-gold/60" />
                <button type="button" disabled="@Busy" @onclick="ChangePassword"
                        class="w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                    Guardar contraseña
                </button>
                @if (!string.IsNullOrWhiteSpace(PasswordMsg))
                {
                    <p class="text-center text-sm @(PasswordOk ? "text-emerald-300" : "text-rose-400")">@PasswordMsg</p>
                }
            </div>
        </div>
    </div>
}

<CardPayModal @ref="_payModal" OnApproved="OnPaid" />

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private List<PluginLicenseDto> Licenses = [];
    private List<PluginPeriodKeyDto> PeriodKeys = [];
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private List<UnlockedDesignDto> Unlocked = [];
    private decimal MonthPricePen;
    private List<PluginPlanOptionDto> Plans = [];
    private List<CreditPackageDto> Packages = [];
    private CardPayModal? _payModal;
    private string _edition = "plugin-corel";
    private string? BuyMsg;
    private bool Busy;
    private bool _showPwd;
    private string? DownloadMsg;
    private bool DownloadOk;
    private string? PasswordMsg;
    private bool PasswordOk;
    private string? RedeemMsg;
    private bool RedeemOk;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _newPassword2 = "";
    private string _redeemCode = "";
    private bool _forcePwd;

    // Tres planes (1, 3 y 6 meses). US$15 por mes.
    private IEnumerable<PluginPlanOptionDto> ThreePlans =>
        Plans.Where(p => p.Months is 1 or 3 or 6).OrderBy(p => p.Months);

    private static decimal Usd(int months) => 15m * months;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _forcePwd = uri.Query.Contains("cambiar=1", StringComparison.OrdinalIgnoreCase);
        if (_forcePwd) _showPwd = true;

        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Unlocked = dash.UnlockedDesigns ?? [];
            Transactions = dash.Transactions ?? [];
        }

        try { Licenses = await Api.GetPluginLicensesAsync() ?? []; }
        catch { Licenses = []; }

        try { PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? []; }
        catch { PeriodKeys = []; }

        var store = await Api.GetStorefrontAsync();
        MonthPricePen = store?.PluginMonthPricePen ?? 0;
        Packages = store?.Packages ?? [];
        Plans = store?.PluginPlans ??
        [
            new(1, 30, MonthPricePen, "1 mes (30 días)"),
            new(3, 90, MonthPricePen * 3, "3 meses (90 días)"),
            new(6, 180, MonthPricePen * 6, "6 meses (180 días)"),
            new(12, 365, MonthPricePen * 12, "12 meses (365 días)")
        ];
    }

    private string EditionClass(string ed) => _edition == ed
        ? "rounded-xl border border-gold bg-gold/15 py-2.5 text-sm font-semibold text-white"
        : "rounded-xl border border-white/10 bg-white/[0.02] py-2.5 text-sm text-cream/70 hover:bg-white/[0.06]";

    private async Task BuyPlan(int months)
    {
        BuyMsg = null;
        var plan = Plans.FirstOrDefault(p => p.Months == months);
        var pen = plan?.PricePen ?? MonthPricePen * months;
        var progLabel = _edition.Contains("corel") ? "CorelDRAW" : "Illustrator";
        var label = $"{progLabel} · {plan?.Label ?? $"{months} mes(es)"}";
        if (_payModal is { CardEnabled: true })
        {
            _payModal.Open(_edition, months, null, pen, label);
            return;
        }
        await RedirectCheckout(_edition, null, months);
    }

    private async Task BuyCredits(CreditPackageDto pack)
    {
        BuyMsg = null;
        if (_payModal is { CardEnabled: true })
        {
            var creditos = pack.CreditsAmount + pack.BonusAmount;
            _payModal.Open("credits", null, pack.Id, pack.PriceUsd, $"Créditos Simber · {creditos:0}");
            return;
        }
        await RedirectCheckout("credits", pack.Id, null);
    }

    private async Task RedirectCheckout(string kind, Guid? packageId, int? months)
    {
        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, packageId, null, months);
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
                Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
            else
                BuyMsg = "No se pudo iniciar el pago.";
        }
        catch (Exception ex) { BuyMsg = CleanError(ex.Message); }
        finally { Busy = false; }
    }

    // Tras un pago aprobado con tarjeta/Yape: refresca saldo, licencias y claves.
    private async Task OnPaid()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Transactions = dash.Transactions ?? [];
        }
        try { Licenses = await Api.GetPluginLicensesAsync() ?? []; } catch { }
        try { PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? []; } catch { }
        StateHasChanged();
    }

    private Task RedeemKey() => RedeemExisting(_redeemCode);

    private async Task RedeemExisting(string code)
    {
        RedeemMsg = null;
        Busy = true;
        try
        {
            await Api.RedeemPeriodKeyAsync(code);
            RedeemOk = true;
            RedeemMsg = "Clave canjeada. Ya puedes activar el .exe con tu cuenta.";
            _redeemCode = "";
            Licenses = await Api.GetPluginLicensesAsync() ?? [];
            PeriodKeys = await Api.GetPluginPeriodKeysAsync() ?? [];
        }
        catch (Exception ex)
        {
            RedeemOk = false;
            RedeemMsg = CleanError(ex.Message);
        }
        finally { Busy = false; }
    }

    private async Task Redownload(UnlockedDesignDto design)
    {
        DownloadMsg = null;
        Busy = true;
        try
        {
            var dl = await Api.DownloadAsync(design.Id);
            if (string.IsNullOrWhiteSpace(dl?.DownloadUrl))
            {
                DownloadOk = false;
                DownloadMsg = "No se pudo obtener el archivo.";
                return;
            }

            Nav.NavigateTo(dl.DownloadUrl, forceLoad: true);
            DownloadOk = true;
            DownloadMsg = "Descarga iniciada.";
        }
        catch (Exception ex)
        {
            DownloadOk = false;
            DownloadMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ChangePassword()
    {
        PasswordMsg = null;
        if (_newPassword != _newPassword2)
        {
            PasswordOk = false;
            PasswordMsg = "Las contraseñas nuevas no coinciden.";
            return;
        }

        Busy = true;
        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            PasswordOk = true;
            PasswordMsg = "Contraseña actualizada.";
            _currentPassword = _newPassword = _newPassword2 = "";
            _forcePwd = false;
            _showPwd = false;
            if (Nav.Uri.Contains("cambiar=", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/cuenta");
            }
        }
        catch (Exception ex)
        {
            PasswordOk = false;
            PasswordMsg = CleanError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private static string CleanError(string raw)
    {
        var t = raw.Trim();
        if (t.Length >= 2 && t[0] == '"' && t[^1] == '"')
            t = t[1..^1];
        return string.IsNullOrWhiteSpace(t) ? "Error." : t;
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
