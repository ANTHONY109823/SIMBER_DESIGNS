@page "/cuenta"
@attribute [Authorize]
@inject SimberApi Api

<PageTitle>Mi cuenta · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Cuenta</p>
    <h1 class="mt-2 font-serif text-4xl text-white">@Name</h1>
    <p class="mt-1 text-sm text-cream/50">@Email</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Créditos CDR</p>
            <p class="mt-2 font-serif text-4xl text-gold">@Credits.ToString("0")</p>
            <a href="/recargar" class="mt-4 inline-block text-sm text-gold hover:underline">Recargar</a>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <p class="text-xs uppercase tracking-wider text-cream/45">Suscripción del programa · 1 PC</p>
            @if (License is { IsActive: true })
            {
                <p class="mt-2 text-lg text-white">Activa hasta @License.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                <p class="mt-1 text-xs @DaysColor">@DaysLabel</p>
                <p class="mt-1 text-xs text-emerald-300">✓ Incluye lectura de listas con IA ilimitada</p>
                <p class="mt-3 font-mono text-sm text-cyan">@License.ActivationCode</p>
                <p class="mt-2 text-xs text-cream/55">Pégalo una vez en el programa. El programa valida tu mes por internet al abrir.</p>
                @if (DaysLeft <= 10)
                {
                    <a href="/recargar" class="mt-4 inline-block rounded-full bg-gold px-5 py-2 text-sm font-semibold text-ink">Renovar mes</a>
                }
            }
            else
            {
                <p class="mt-2 text-sm text-cream/55">Sin mes activo.</p>
                <a href="/recargar" class="mt-4 inline-block rounded-full bg-gold px-5 py-2 text-sm font-semibold text-ink">Pagar el mes (≈ US$15)</a>
            }
        </article>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
        <a href="/api/plugin/download" class="rounded-full bg-emerald-500 px-6 py-3 text-sm font-semibold text-ink hover:bg-emerald-400">Descargar programa</a>
        <a href="/programas" class="rounded-full border border-white/20 px-6 py-3 text-sm text-cream hover:border-gold/50">Cómo se instala</a>
    </div>

    @if (CreditLogs.Count > 0 || Transactions.Count > 0)
    {
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            @if (CreditLogs.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Movimientos de créditos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var log in CreditLogs)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@log.Description<span class="ml-2 text-xs text-cream/35">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="@(log.CreditsChanged >= 0 ? "text-emerald-300" : "text-rose-300")">@(log.CreditsChanged >= 0 ? "+" : "")@log.CreditsChanged.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Transactions.Count > 0)
            {
                <section>
                    <h2 class="font-serif text-xl text-white">Pagos</h2>
                    <ul class="mt-3 divide-y divide-white/5 rounded-2xl border border-white/10 bg-white/[0.02]">
                        @foreach (var tx in Transactions)
                        {
                            <li class="flex items-center justify-between px-4 py-3 text-sm">
                                <span class="text-cream/70">@tx.DetailName<span class="ml-2 text-xs text-cream/35">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></span>
                                <span class="text-cream/60">@tx.Currency @tx.Amount.ToString("0.##") · <span class="@StatusColor(tx.Status)">@StatusText(tx.Status)</span></span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

@code {
    private string Name = "";
    private string Email = "";
    private decimal Credits;
    private PluginLicenseDto? License;
    private List<CreditLogDto> CreditLogs = [];
    private List<TransactionDto> Transactions = [];
    private int DaysLeft => License is null ? 0 : Math.Max(0, (License.ExpiresAt.ToLocalTime().Date - DateTime.Now.Date).Days);
    private string DaysLabel => DaysLeft == 1 ? "Queda 1 día" : $"Quedan {DaysLeft} días";
    private string DaysColor => DaysLeft <= 2 ? "text-rose-300" : DaysLeft <= 7 ? "text-amber-300" : "text-cream/55";

    protected override async Task OnInitializedAsync()
    {
        var dash = await Api.GetDashboardAsync();
        if (dash is not null)
        {
            Name = dash.FullName;
            Email = dash.Email;
            Credits = dash.CreditsBalance;
            CreditLogs = dash.CreditLogs ?? [];
            Transactions = dash.Transactions ?? [];
        }

        License = await Api.GetPluginLicenseAsync();
    }

    private static string StatusText(string s) => s switch
    {
        "Completed" => "acreditado",
        "Pending" => "en proceso",
        "Rejected" => "rechazado",
        _ => s.ToLowerInvariant()
    };

    private static string StatusColor(string s) => s switch
    {
        "Completed" => "text-emerald-300",
        "Rejected" => "text-rose-300",
        _ => "text-cream/50"
    };
}
