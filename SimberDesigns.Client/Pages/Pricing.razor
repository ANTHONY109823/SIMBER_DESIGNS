@page "/pricing"
@inject NavigationManager Navigation
@inject SimberApi Api
@inject AuthenticationStateProvider AuthState

<div class="min-h-screen bg-slate-950 text-slate-100 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl x-auto mx-auto">
        
        <!-- Encabezado Principal -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="px-3 py-1 text-xs font-semibold tracking-wider text-orange-500 uppercase bg-orange-500/10 rounded-full border border-orange-500/20">
                Planes y Recargas
            </span>
            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent">
                Acceso Ilimitado a Vectores Deportivos
            </h1>
            <p class="mt-4 text-lg text-slate-400">
                Elige el modelo que mejor se adapte a tu taller de sublimación. Suscríbete para descargas diarias recurrentes o compra paquetes de créditos prepago sin vencimiento.
            </p>

            <!-- Selector de Modelo de Negocio (Toggle) -->
            <div class="mt-10 inline-flex p-1 bg-slate-900 border border-slate-800 rounded-xl">
                <button @onclick="() => showSubscriptions = true" 
                        class="px-6 py-2.5 rounded-lg font-medium text-sm transition-all duration-300 @(showSubscriptions ? "bg-orange-600 text-white shadow-lg shadow-orange-600/20" : "text-slate-400 hover:text-slate-200")">
                    ⚡ Membresías Mensuales (Descargas Diarias)
                </button>
                <button @onclick="() => showSubscriptions = false" 
                        class="px-6 py-2.5 rounded-lg font-medium text-sm transition-all duration-300 @(!showSubscriptions ? "bg-orange-600 text-white shadow-lg shadow-orange-600/20" : "text-slate-400 hover:text-slate-200")">
                    💎 Paquetes de Créditos (Prepago)
                </button>
            </div>
        </div>

        @if (showSubscriptions)
        {
            <!-- SECCIÓN A: MEMBRESÍAS RECURRENTES (Inspirado en VectorSport) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-6 lg:items-stretch">
                
                <!-- Plan Básico -->
                <div class="flex flex-col p-8 bg-slate-900/60 border border-slate-800 rounded-2xl relative overflow-hidden transition-all duration-300 hover:border-slate-700 hover:shadow-xl hover:shadow-slate-950/50">
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-white">Membresía Básica</h3>
                        <p class="mt-2 text-sm text-slate-400">Ideal para diseñadores independientes y talleres pequeños.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$11</span>
                            <span class="ml-1 text-xl font-semibold text-slate-500">/mes</span>
                        </div>
                    </div>
                    
                    <ul class="space-y-4 mb-8 flex-1">
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Acceso completo a la biblioteca de vectores</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-white">15 descargas diarias</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>1 diseño personalizado mensual</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Historial de descargas inmutable</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300 text-slate-500">
                            <svg class="h-5 w-5 text-slate-700 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            <span>Soporte técnico prioritario (Estándar)</span>
                        </li>
                    </ul>

                    <button @onclick='() => SelectPlan("Basic_Monthly", 11.00)' class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl transition-all duration-200">
                        Suscribirse con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("Basic_Monthly", 11.00, "S/ 41.00")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/40 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-medium rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>

                <!-- Plan VIP (Recomendado) -->
                <div class="flex flex-col p-8 bg-gradient-to-b from-slate-900 via-slate-900 to-orange-950/20 border-2 border-orange-500 rounded-2xl relative overflow-hidden shadow-2xl shadow-orange-950/30">
                    <div class="absolute top-0 right-0 bg-orange-500 text-black font-extrabold text-2xs uppercase tracking-widest px-4 py-1.5 rounded-bl-xl">
                        Popular
                    </div>
                    
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-white">Membresía VIP</h3>
                        <p class="mt-2 text-sm text-slate-300">Para talleres con producción activa y clientes exigentes.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$16</span>
                            <span class="ml-1 text-xl font-semibold text-slate-400">/mes</span>
                        </div>
                    </div>
                    
                    <ul class="space-y-4 mb-8 flex-1">
                        <li class="flex items-start text-sm text-slate-200">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Acceso completo a la biblioteca de vectores</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-200">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-orange-400">25 descargas diarias</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-200">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-white">3 diseños personalizados mensuales</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-200">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Historial de descargas inmutable</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-200">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-white">Soporte técnico prioritario avanzado</span>
                        </li>
                    </ul>

                    <button @onclick='() => SelectPlan("VIP_Monthly", 16.00)' class="w-full py-3.5 px-4 bg-orange-600 hover:bg-orange-500 text-white font-bold rounded-xl shadow-lg shadow-orange-600/30 hover:shadow-orange-500/40 transition-all duration-200 transform hover:-translate-y-0.5">
                        Suscribirse con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("VIP_Monthly", 16.00, "S/ 59.00")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/80 hover:bg-slate-800 border border-orange-500/30 text-orange-400 text-xs font-semibold rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>

                <!-- Plan Semestral Elite -->
                <div class="flex flex-col p-8 bg-slate-900/60 border border-slate-800 rounded-2xl relative overflow-hidden transition-all duration-300 hover:border-slate-700 hover:shadow-xl hover:shadow-slate-950/50">
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-white">Membresía Semestral</h3>
                        <p class="mt-2 text-sm text-slate-400">Mejor costo-beneficio para grandes talleres y marcas.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$65</span>
                            <span class="ml-1 text-xl font-semibold text-slate-500">/6 meses</span>
                        </div>
                        <div class="text-xs text-orange-400 mt-1 font-semibold">Equivale a solo $10.83/mes</div>
                    </div>
                    
                    <ul class="space-y-4 mb-8 flex-1">
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Acceso completo a la biblioteca de vectores</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-white">30 descargas diarias</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="font-semibold text-white">4 diseños personalizados mensuales</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Historial de descargas inmutable</span>
                        </li>
                        <li class="flex items-start text-sm text-slate-300">
                            <svg class="h-5 w-5 text-orange-500 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Soporte técnico prioritario 24/7</span>
                        </li>
                    </ul>

                    <button @onclick='() => SelectPlan("Elite_Semestral", 65.00)' class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl transition-all duration-200">
                        Suscribirse con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("Elite_Semestral", 65.00, "S/ 240.00")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/40 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-medium rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- SECCIÓN B: PAQUETES DE CRÉDITOS (Inspirado en Foraes) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-6 lg:items-stretch">
                
                <!-- Paquete Basic -->
                <div class="flex flex-col p-8 bg-slate-900/60 border border-slate-800 rounded-2xl relative overflow-hidden transition-all duration-300 hover:border-slate-700 hover:shadow-xl hover:shadow-slate-950/50">
                    <div class="mb-6">
                        <span class="px-2.5 py-1 text-2xs font-bold tracking-wider text-slate-400 uppercase bg-slate-800 rounded-full">
                            Recarga Inicial
                        </span>
                        <h3 class="mt-4 text-2xl font-black text-white">Paquete Basic</h3>
                        <p class="mt-2 text-sm text-slate-400">Excelente para comprar diseños específicos sin suscripción.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$10</span>
                            <span class="ml-1 text-lg font-semibold text-slate-500">USD</span>
                        </div>
                    </div>
                    
                    <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800/80 mb-8 flex-1 flex flex-col justify-center text-center">
                        <span class="text-xs text-slate-400 uppercase tracking-widest font-semibold">Recibes en tu Cuenta</span>
                        <span class="text-3xl font-black text-orange-500 mt-1">10.00 Créditos</span>
                        <span class="text-xs text-slate-500 mt-2">Canjeable por 5 diseños premium de $2.00 c/u</span>
                    </div>

                    <button @onclick='() => SelectCredits("Pack_Basic", 10.00)' class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl transition-all duration-200">
                        Comprar con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("Pack_Basic", 10.00, "S/ 37.00")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/40 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-medium rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>

                <!-- Paquete VIP (Bono Regalo) -->
                <div class="flex flex-col p-8 bg-gradient-to-b from-slate-900 via-slate-900 to-orange-950/10 border-2 border-orange-500 rounded-2xl relative overflow-hidden shadow-2xl shadow-orange-950/20">
                    <div class="absolute top-0 right-0 bg-orange-500 text-black font-extrabold text-2xs uppercase tracking-widest px-4 py-1.5 rounded-bl-xl">
                        Ahorra 20%
                    </div>
                    
                    <div class="mb-6">
                        <span class="px-2.5 py-1 text-2xs font-bold tracking-wider text-orange-400 uppercase bg-orange-500/10 rounded-full border border-orange-500/20">
                            Más Vendido
                        </span>
                        <h3 class="mt-4 text-2xl font-black text-white">Paquete VIP</h3>
                        <p class="mt-2 text-sm text-slate-300">Te regalamos saldo extra para tus diseños de sublimación.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$25</span>
                            <span class="ml-1 text-lg font-semibold text-slate-400">USD</span>
                        </div>
                    </div>
                    
                    <div class="p-5 bg-slate-950/80 rounded-xl border border-orange-500/20 mb-8 flex-1 flex flex-col justify-center text-center">
                        <span class="text-xs text-orange-400 uppercase tracking-widest font-bold">Recibes en tu Cuenta</span>
                        <span class="text-4xl font-black text-orange-500 mt-1">30.00 Créditos</span>
                        <span class="text-xs text-slate-400 mt-2 font-medium">¡Incluye $5.00 USD de Bono Gratis!</span>
                    </div>

                    <button @onclick='() => SelectCredits("Pack_VIP", 25.00)' class="w-full py-3.5 px-4 bg-orange-600 hover:bg-orange-500 text-white font-bold rounded-xl shadow-lg shadow-orange-600/30 hover:shadow-orange-500/40 transition-all duration-200 transform hover:-translate-y-0.5">
                        Comprar con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("Pack_VIP", 25.00, "S/ 92.50")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/80 hover:bg-slate-800 border border-orange-500/30 text-orange-400 text-xs font-semibold rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>

                <!-- Paquete Elite (Bono Super Ahorro) -->
                <div class="flex flex-col p-8 bg-slate-900/60 border border-slate-800 rounded-2xl relative overflow-hidden transition-all duration-300 hover:border-slate-700 hover:shadow-xl hover:shadow-slate-950/50">
                    <div class="mb-6">
                        <span class="px-2.5 py-1 text-2xs font-bold tracking-wider text-slate-400 uppercase bg-slate-800 rounded-full">
                            Taller de Sublimación
                        </span>
                        <h3 class="mt-4 text-2xl font-black text-white">Paquete Elite</h3>
                        <p class="mt-2 text-sm text-slate-400">Máximo rendimiento. Diseñado para imprentas industriales.</p>
                        <div class="mt-6 flex items-baseline">
                            <span class="text-4xl font-extrabold text-white">$50</span>
                            <span class="ml-1 text-lg font-semibold text-slate-500">USD</span>
                        </div>
                    </div>
                    
                    <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800/80 mb-8 flex-1 flex flex-col justify-center text-center">
                        <span class="text-xs text-slate-400 uppercase tracking-widest font-semibold">Recibes en tu Cuenta</span>
                        <span class="text-3xl font-black text-emerald-400 mt-1">65.00 Créditos</span>
                        <span class="text-xs text-emerald-500 mt-2 font-semibold">¡Regalo masivo de $15.00 USD!</span>
                    </div>

                    <button @onclick='() => SelectCredits("Pack_Elite", 50.00)' class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl transition-all duration-200">
                        Comprar con Tarjeta / PayPal
                    </button>
                    <button @onclick='() => SelectManualPayment("Pack_Elite", 50.00, "S/ 185.00")' class="mt-2 w-full py-2.5 px-4 bg-slate-900/40 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-medium rounded-xl transition-all duration-200">
                        Pagar con QR Local (Yape/Transferencia)
                    </button>
                </div>
            </div>
        }

        <!-- SECCIÓN COMPLEMENTARIA: CÓMO FUNCIONA EL PAGO MANUAL LOCAL (YAPE/QR) -->
        <div class="mt-20 bg-slate-900/40 border border-slate-800 rounded-3xl p-8 sm:p-10 relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-orange-600/5 rounded-full blur-3xl"></div>
            <div class="absolute -left-10 -top-10 w-64 h-64 bg-blue-600/5 rounded-full blur-3xl"></div>

            <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
                <div class="max-w-xl">
                    <h2 class="text-2xl font-bold text-white mb-4">¿Prefieres pagar de forma local?</h2>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Habilitamos el sistema semiautomatizado más rápido para América Latina. Escanea nuestro código QR local (ej. Yape, Plin o cuenta bancaria), sube tu captura de pantalla de confirmación desde tu cuenta, y un administrador validará la operación en un tiempo estimado de 5 a 30 minutos.
                    </p>
                    <div class="mt-6 flex flex-wrap gap-4 text-xs font-semibold text-slate-300">
                        <span class="flex items-center"><span class="h-2 w-2 rounded-full bg-orange-500 mr-2"></span>Soporte Yape Perú</span>
                        <span class="flex items-center"><span class="h-2 w-2 rounded-full bg-blue-500 mr-2"></span>Transferencia Bancaria Directa</span>
                        <span class="flex items-center"><span class="h-2 w-2 rounded-full bg-emerald-500 mr-2"></span>Validación Rápida (5-30m)</span>
                    </div>
                </div>
                <div class="flex items-center gap-6 bg-slate-950 p-6 rounded-2xl border border-slate-800 shrink-0 w-full lg:w-auto">
                    <div class="bg-white p-2.5 rounded-lg">
                        <!-- Código QR ficticio de la pasarela local de Simber designs -->
                        <div class="w-24 h-24 bg-slate-200 flex items-center justify-center text-black font-mono text-center text-3xs">
                            [ QR YAPE ]<br/>[ SIMBER ]
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-orange-500 font-extrabold uppercase tracking-wider">Pago Seguro Directo</div>
                        <h4 class="text-base font-bold text-white mt-1">Yape Perú / QR Único</h4>
                        <p class="text-xs text-slate-500 mt-1 max-w-2xs">Escribe tu correo registrado en el mensaje del pago para una validación más veloz.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal de Pago Manual (Yape / Transferencia QR) -->
@if (isManualPaymentModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 relative animate-in fade-in duration-200">
            <button @onclick="CloseManualPaymentModal" class="absolute top-4 right-4 text-slate-400 hover:text-slate-200">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            <div class="text-center">
                <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-orange-500/10 text-orange-500 mb-4">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m0 11v3m0-12h.01M12 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </span>
                <h3 class="text-xl font-bold text-white">Pago Local Manual (QR)</h3>
                <p class="text-xs text-slate-400 mt-1">Sigue los pasos para acreditar tu cuenta de Simber designs</p>
            </div>

            <div class="mt-6 space-y-4">
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-sm">
                    <div class="flex justify-between mb-2">
                        <span class="text-slate-500">Item Seleccionado:</span>
                        <span class="font-semibold text-white">@selectedItemName</span>
                    </div>
                    <div class="flex justify-between mb-2">
                        <span class="text-slate-500">Monto en USD:</span>
                        <span class="font-semibold text-white">$@selectedAmountUsd.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between pt-2 border-t border-slate-800">
                        <span class="text-orange-400 font-semibold">Total a Pagar local:</span>
                        <span class="font-extrabold text-orange-400">@selectedLocalAmountFormatted</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Paso 1: Escanea y Paga</label>
                    <p class="text-2xs text-slate-500">Abre tu app Yape o banca móvil, escanea el código de arriba y transfiere exactamente @selectedLocalAmountFormatted. Coloca tu correo registrado en el mensaje de la operación.</p>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Paso 2: Sube tu Comprobante</label>
                    <div class="border-2 border-dashed border-slate-800 hover:border-slate-700 rounded-xl p-4 text-center cursor-pointer relative">
                        <InputFile OnChange="HandleFileSelected" class="absolute inset-0 opacity-0 cursor-pointer" />
                        <svg class="mx-auto h-8 w-8 text-slate-600 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span class="text-xs text-slate-400 block">
                            @(selectedFile != null ? selectedFile.Name : "Seleccionar Captura de Pantalla")
                        </span>
                        <span class="text-3xs text-slate-600 block mt-1">Formatos permitidos: JPG, PNG, WEBP (Máx 5MB)</span>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex gap-3">
                <button @onclick="CloseManualPaymentModal" class="w-1/2 py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold rounded-xl transition-all">
                    Cancelar
                </button>
                <button @onclick="SubmitManualPayment" 
                        disabled="@(selectedFile == null)" 
                        class="w-1/2 py-2.5 px-4 bg-orange-600 hover:bg-orange-500 disabled:bg-slate-800 disabled:text-slate-600 text-white text-sm font-bold rounded-xl shadow-lg transition-all">
                    Enviar Registro
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showSubscriptions = true;

    // Estados del Modal de Pago Manual
    private bool isManualPaymentModalOpen = false;
    private string selectedItemName = "";
    private string selectedItemKey = "";
    private double selectedAmountUsd = 0.00;
    private string selectedLocalAmountFormatted = "";
    private IBrowserFile? selectedFile;

    private async Task SelectPlan(string planKey, double price)
    {
        if (!await EnsureAuthenticatedAsync())
        {
            return;
        }

        var checkout = await Api.CheckoutAsync(planKey, null);
        if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
        {
            Navigation.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
    }

    private async Task SelectCredits(string packKey, double price)
    {
        if (!await EnsureAuthenticatedAsync())
        {
            return;
        }

        var checkout = await Api.CheckoutAsync(null, packKey);
        if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
        {
            Navigation.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
    }

    private async Task<bool> EnsureAuthenticatedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            return true;
        }

        Navigation.NavigateTo("/login");
        return false;
    }

    private void SelectManualPayment(string itemKey, double usdAmount, string localFormatted)
    {
        selectedItemKey = itemKey;
        selectedItemName = itemKey.Contains("Monthly") ? $"Suscripción {itemKey.Replace("_Monthly", "")}" : $"Paquete {itemKey.Replace("Pack_", "")}";
        selectedAmountUsd = usdAmount;
        selectedLocalAmountFormatted = localFormatted;
        isManualPaymentModalOpen = true;
    }

    private void CloseManualPaymentModal()
    {
        isManualPaymentModalOpen = false;
        selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task SubmitManualPayment()
    {
        if (selectedFile == null)
        {
            return;
        }

        if (!await EnsureAuthenticatedAsync())
        {
            return;
        }

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await Api.SubmitManualPaymentAsync(stream, selectedFile.Name, selectedItemKey);
            CloseManualPaymentModal();
            Navigation.NavigateTo("/orders");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al procesar el envío del pago QR: {ex.Message}");
        }
    }
}