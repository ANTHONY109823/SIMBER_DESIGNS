@page "/pricing"
@page "/recargar"
@inject SimberApi Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Precios · Simber Designs</PageTitle>

<div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Activación mensual · Mercado Pago</p>
    <h1 class="mt-3 font-serif text-4xl text-white sm:text-5xl">Activa el mes, no compras el programa</h1>
    <p class="mt-3 max-w-2xl text-sm text-cream/80">
        El .exe se descarga gratis. Pagas US$15 (S/ @(PluginPrice.ToString("0"))) para <strong class="text-white">activar 30 días en 1 PC</strong>.
        Hay un ejecutable para CorelDRAW y otro para Illustrator. Al abrir, el programa entra con tu usuario y verifica la licencia por internet.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="rounded-3xl border border-emerald-500/30 bg-emerald-500/[0.06] p-6 sm:p-8">
            <p class="text-xs uppercase tracking-[0.2em] text-emerald-300">CorelDRAW · 1 PC</p>
            <h2 class="mt-2 font-serif text-3xl text-white">Mes de CorelDRAW</h2>
            <p class="mt-2 font-serif text-4xl text-gold">S/ @PluginPrice.ToString("0") <span class="text-base text-cream/80">/ 30 días · ≈ US$15</span></p>
            <ul class="mt-5 space-y-2 text-sm text-cream/80">
                <li>Descarga el .exe de Corel (gratis)</li>
                <li>IA ilimitada mientras el mes esté activo</li>
                <li>Clave de este mes en Mi cuenta al pagar o renovar</li>
            </ul>
            <a href="/api/plugin/download/corel" data-enhance-nav="false"
               class="mt-5 block w-full rounded-full bg-emerald-500 py-3 text-center text-sm font-semibold text-ink hover:bg-emerald-400">
                Descargar CorelDRAW
            </a>
            <button type="button" disabled="@Busy" @onclick='() => StartCheckout("plugin-corel", null, null)'
                    class="mt-3 block w-full text-sm text-emerald-300 hover:underline disabled:opacity-60">
                Activar 30 días · S/ @PluginPrice.ToString("0")
            </button>
            @if (!HasCorel)
            {
                <p class="mt-2 text-xs text-cream/45">Si la descarga falla, el admin aún no subió este .exe.</p>
            }
        </article>
        <article class="rounded-3xl border border-cyan/30 bg-cyan/5 p-6 sm:p-8">
            <p class="text-xs uppercase tracking-[0.2em] text-cyan">Illustrator · 1 PC</p>
            <h2 class="mt-2 font-serif text-3xl text-white">Mes de Illustrator</h2>
            <p class="mt-2 font-serif text-4xl text-gold">S/ @PluginPrice.ToString("0") <span class="text-base text-cream/80">/ 30 días · ≈ US$15</span></p>
            <ul class="mt-5 space-y-2 text-sm text-cream/80">
                <li>Descarga el .exe de Illustrator (gratis)</li>
                <li>IA ilimitada mientras el mes esté activo</li>
                <li>Clave de este mes en Mi cuenta al pagar o renovar</li>
            </ul>
            <a href="/api/plugin/download/illustrator" data-enhance-nav="false"
               class="mt-5 block w-full rounded-full bg-gold py-3 text-center text-sm font-semibold text-ink hover:bg-orange-400">
                Descargar Illustrator
            </a>
            <button type="button" disabled="@Busy" @onclick='() => StartCheckout("plugin-illustrator", null, null)'
                    class="mt-3 block w-full text-sm text-cyan hover:underline disabled:opacity-60">
                Activar 30 días · S/ @PluginPrice.ToString("0")
            </button>
            @if (!HasIllustrator)
            {
                <p class="mt-2 text-xs text-cream/45">Si la descarga falla, el admin aún no subió este .exe.</p>
            }
        </article>
    </div>

    <!-- Créditos: SOLO para descargar diseños del catálogo -->
    <div class="mt-12">
        <h2 class="font-serif text-2xl text-white">Créditos para descargar diseños (CDR)</h2>
        <p class="mt-1 text-sm text-cream/55">Solo para descargar los diseños del catálogo. La IA del programa NO gasta créditos.</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
            @foreach (var pack in Packages)
            {
                <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-6">
                    <p class="text-sm text-cream/50">@pack.Name créditos</p>
                    <p class="mt-2 font-serif text-4xl text-gold">S/ @pack.PriceUsd.ToString("0")</p>
                    <p class="mt-2 text-sm text-cream/55">@(pack.CreditsAmount + pack.BonusAmount) créditos@(pack.BonusAmount > 0 ? $" · +{pack.BonusAmount} de regalo" : "")</p>
                    <button type="button" disabled="@Busy" @onclick="() => PayCredits(pack)"
                            class="mt-6 rounded-full bg-gold py-3 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                        Pagar ahora
                    </button>
                </article>
            }
        </div>
    </div>

    <section class="mt-14 max-w-2xl">
        <h2 class="font-serif text-2xl text-white">Preguntas frecuentes</h2>
        <dl class="mt-6 space-y-5 text-sm">
            <div>
                <dt class="font-semibold text-white">¿La IA gasta créditos?</dt>
                <dd class="mt-1 text-cream/65">No. Con el mes activo la lectura de listas es ilimitada. Los créditos son solo para descargar diseños del catálogo.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿Cuánto sale el mes?</dt>
                <dd class="mt-1 text-cream/65">S/ @PluginPrice.ToString("0") al mes (≈ US$15) por programa, 1 PC. El .exe no se vende: solo se activa el mes.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿Puedo cancelar?</dt>
                <dd class="mt-1 text-cream/65">Sí. El mes corre hasta la fecha de vencimiento; si no renovas, el programa deja de activarse.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿El programa es gratis para bajar?</dt>
                <dd class="mt-1 text-cream/65">Sí. Corel e Illustrator se bajan aparte desde Programas. El cobro es al activar ese mes en esa PC.</dd>
            </div>
        </dl>
        <p class="mt-6 text-xs text-cream/50">Activación al instante · Yape o tarjeta · Cancela cuando quieras.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mt-6 text-sm text-rose-400">@Error</p>
    }
</div>

@code {
    private List<CreditPackageDto> Packages { get; set; } = [];
    private decimal PluginPrice { get; set; } = 56;
    private bool HasCorel;
    private bool HasIllustrator;
    private bool Busy;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var store = await Api.GetStorefrontAsync();
        if (store is not null)
        {
            Packages = store.Packages;
            PluginPrice = store.PluginMonthPricePen;
            HasCorel = store.HasCorelDownload;
            HasIllustrator = store.HasIllustratorDownload;
        }
    }

    private async Task PayCredits(CreditPackageDto pack)
    {
        await StartCheckout("credits", pack.Id, null);
    }

    private async Task StartCheckout(string kind, Guid? packageId, string? planKey)
    {
        Error = null;
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, packageId, planKey);
            if (string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                Error = "No se pudo abrir Mercado Pago.";
                return;
            }

            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
