@page "/pricing"
@page "/recargar"
@inject SimberApi Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Precios · Simber Designs</PageTitle>

<div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Suscripción · Mercado Pago</p>
    <h1 class="mt-3 font-serif text-4xl text-white sm:text-5xl">Activa SIMBER DESIGNS</h1>
    <p class="mt-3 max-w-xl text-sm text-cream/60">
        Paga el mes con Yape o tarjeta y actívalo en tu PC en segundos. Incluye lectura de listas con IA ilimitada.
    </p>

    <!-- HERO: suscripción mensual del programa (producto principal, estilo Adobe) -->
    <div class="mt-10 rounded-3xl border border-emerald-500/30 bg-emerald-500/[0.06] p-6 sm:p-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-[0.2em] text-emerald-300">Programa · CorelDRAW e Illustrator · 1 PC</p>
                <h2 class="mt-2 font-serif text-3xl text-white">@PluginName</h2>
            </div>
            <p class="font-serif text-4xl text-gold">S/ @PluginPrice.ToString("0") <span class="text-base text-cream/50">/ mes</span></p>
        </div>
        <ul class="mt-5 grid gap-2 text-sm text-cream/70 sm:grid-cols-2">
            <li>✓ Armado y acomodo ilimitado en CorelDRAW e Illustrator</li>
            <li>✓ <strong class="text-white">Lectura de listas con IA ilimitada</strong> (incluida)</li>
            <li>✓ Nombres y dorsales automáticos desde tu lista</li>
            <li>✓ Se activa en tu PC (1 licencia por PC)</li>
        </ul>
        <button type="button" disabled="@Busy" @onclick="PayPlugin"
                class="mt-6 rounded-full bg-emerald-500 px-7 py-3 text-sm font-semibold text-ink hover:bg-emerald-400 disabled:opacity-60">
            Pagar el mes
        </button>
        <p class="mt-3 text-xs text-cream/45">En tu cuenta aparece el código de activación para pegarlo una vez en el programa.</p>
    </div>

    <!-- Créditos: SOLO para descargar diseños del catálogo -->
    <div class="mt-12">
        <h2 class="font-serif text-2xl text-white">Créditos para descargar diseños (CDR)</h2>
        <p class="mt-1 text-sm text-cream/55">Solo para descargar los diseños del catálogo. La IA del programa NO gasta créditos.</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
            @foreach (var pack in Packages)
            {
                <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-6">
                    <p class="text-sm text-cream/50">@pack.Name créditos</p>
                    <p class="mt-2 font-serif text-4xl text-gold">S/ @pack.PriceUsd.ToString("0")</p>
                    <p class="mt-2 text-sm text-cream/55">@(pack.CreditsAmount + pack.BonusAmount) créditos@(pack.BonusAmount > 0 ? $" · +{pack.BonusAmount} de regalo" : "")</p>
                    <button type="button" disabled="@Busy" @onclick="() => PayCredits(pack)"
                            class="mt-6 rounded-full bg-gold py-3 text-sm font-semibold text-ink hover:bg-orange-400 disabled:opacity-60">
                        Pagar ahora
                    </button>
                </article>
            }
        </div>
    </div>

    <section class="mt-14 max-w-2xl">
        <h2 class="font-serif text-2xl text-white">Preguntas frecuentes</h2>
        <dl class="mt-6 space-y-5 text-sm">
            <div>
                <dt class="font-semibold text-white">¿La IA gasta créditos?</dt>
                <dd class="mt-1 text-cream/65">No. Con el mes activo la lectura de listas es ilimitada. Los créditos son solo para descargar diseños del catálogo.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿Cuánto sale el mes?</dt>
                <dd class="mt-1 text-cream/65">S/ @PluginPrice.ToString("0") al mes (≈ US$15), 1 PC. Activación al instante en tu cuenta.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿Puedo cancelar?</dt>
                <dd class="mt-1 text-cream/65">Sí. El mes corre hasta la fecha de vencimiento; si no renovas, el programa deja de activarse.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">¿El programa es gratis para bajar?</dt>
                <dd class="mt-1 text-cream/65">Sí. Lo descargas desde Programas; el cobro es al activar el mes.</dd>
            </div>
        </dl>
        <p class="mt-6 text-xs text-cream/50">Activación al instante · Yape o tarjeta · Cancela cuando quieras.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mt-6 text-sm text-rose-400">@Error</p>
    }
</div>

@code {
    private List<CreditPackageDto> Packages { get; set; } = [];
    private decimal PluginPrice { get; set; } = 56;
    private string PluginName { get; set; } = "Plugin Premium · 1 PC · 30 días";
    private bool Busy;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var store = await Api.GetStorefrontAsync();
        if (store is not null)
        {
            Packages = store.Packages;
            PluginPrice = store.PluginMonthPricePen;
            PluginName = store.PluginPlanName;
        }
    }

    private async Task PayCredits(CreditPackageDto pack)
    {
        await StartCheckout("credits", pack.Id, null);
    }

    private async Task PayPlugin()
    {
        await StartCheckout("plugin", null, "month-1pc");
    }

    private async Task StartCheckout(string kind, Guid? packageId, string? planKey)
    {
        Error = null;
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        Busy = true;
        try
        {
            var checkout = await Api.CheckoutAsync(kind, packageId, planKey);
            if (string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                Error = "No se pudo abrir Mercado Pago.";
                return;
            }

            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
