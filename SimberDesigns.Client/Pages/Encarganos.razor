@page "/encarganos"
@page "/encarganos-a-nosotros"
@inject SimberApi Api
@inject NavigationManager Nav

<PageTitle>Encárganos a nosotros · Simber Designs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Cotización</p>
    <h1 class="mt-2 font-serif text-4xl text-white">Encárganos a nosotros</h1>

    <EditForm Model="this" OnValidSubmit="EnviarWhatsApp" class="mt-10 space-y-6">
        <div>
            <p class="text-sm text-cream/80">Modelo</p>
            @if (Designs.Count == 0)
            {
                <p class="mt-3 text-sm text-cream/55">No hay modelos en el catálogo todavía.</p>
            }
            else
            {
                <div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4">
                    @foreach (var d in Designs)
                    {
                        <button type="button" @onclick="() => Selected = d"
                                class="overflow-hidden rounded-2xl border text-left @(Selected?.Id == d.Id ? "border-gold" : "border-white/10 hover:border-white/30")">
                            <img src="@d.PreviewUrl" alt="@d.Title" class="aspect-[4/5] w-full object-cover" />
                            <span class="block truncate px-2 py-1.5 text-[11px] text-cream/80">@d.Title</span>
                        </button>
                    }
                </div>
            }
        </div>

        <label class="block text-sm">
            <span class="text-cream/85">Nombre</span>
            <InputText class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" @bind-Value="Nombre" />
        </label>

        <label class="block text-sm">
            <span class="text-cream/85">Teléfono</span>
            <InputText class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" inputmode="tel" maxlength="9" placeholder="9 dígitos" @bind-Value="Telefono" />
        </label>

        <div class="text-sm">
            <span class="text-cream/85">Pedido</span>
            <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" @onclick='() => Tipo = "conjuntos"'
                        class="rounded-full px-4 py-2 @(Tipo == "conjuntos" ? "bg-gold font-semibold text-ink" : "border border-white/15 text-cream/80")">
                    Conjuntos
                </button>
                <button type="button" @onclick='() => Tipo = "polos"'
                        class="rounded-full px-4 py-2 @(Tipo == "polos" ? "bg-gold font-semibold text-ink" : "border border-white/15 text-cream/80")">
                    Polos
                </button>
            </div>
            <InputNumber class="mt-3 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" min="1" @bind-Value="Cantidad" />
        </div>

        <label class="block text-sm">
            <span class="text-cream/85">Fecha estimada de entrega</span>
            <InputDate class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" @bind-Value="Fecha" />
        </label>

        <label class="block text-sm">
            <span class="text-cream/85">Descripción breve</span>
            <InputTextArea class="mt-2 min-h-24 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" @bind-Value="Descripcion" />
        </label>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="text-sm text-rose-400" role="alert">@Error</p>
        }

        <button class="min-h-11 w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink hover:bg-orange-400" type="submit">
            Enviar por WhatsApp
        </button>
    </EditForm>
</div>

@code {
    private const string WhatsAppDestino = "51927577686";

    private List<DesignDto> Designs = [];
    private DesignDto? Selected;
    private string Nombre = "";
    private string Telefono = "";
    private string Tipo = "conjuntos";
    private int Cantidad = 1;
    private DateTime Fecha = DateTime.Today.AddDays(10);
    private string Descripcion = "";
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        Designs = (await Api.GetDesignsAsync() ?? [])
            .OrderByDescending(d => d.CreatedAt)
            .Take(24)
            .ToList();
    }

    private void EnviarWhatsApp()
    {
        Error = null;
        var tel = new string(Telefono.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(Nombre) || tel.Length != 9)
        {
            Error = "Nombre y un teléfono de 9 dígitos.";
            return;
        }

        if (Selected is null)
        {
            Error = "Elige un modelo del catálogo.";
            return;
        }

        if (Cantidad < 1)
        {
            Error = "Indica la cantidad.";
            return;
        }

        var tipoLabel = Tipo == "polos" ? "polos" : "conjuntos";
        var texto =
            "Hola, quiero una cotización de Simber Designs.\n\n" +
            $"Nombre: {Nombre.Trim()}\n" +
            $"Teléfono: {tel}\n" +
            $"Modelo: {Selected.Title}\n" +
            $"Pedido: {Cantidad} {tipoLabel}\n" +
            $"Fecha estimada: {Fecha:dd/MM/yyyy}\n" +
            $"Descripción: {(string.IsNullOrWhiteSpace(Descripcion) ? "-" : Descripcion.Trim())}";

        Nav.NavigateTo($"https://wa.me/{WhatsAppDestino}?text={Uri.EscapeDataString(texto)}", forceLoad: true);
    }
}
