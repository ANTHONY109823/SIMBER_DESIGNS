@page "/admin/content"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SimberApi Api

<PageTitle>Contenido de la web · Simber Admin</PageTitle>

<div class="p-6 md:p-8 max-w-5xl">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-extrabold text-white md:text-3xl">Contenido de la web</h1>
            <p class="mt-1 text-sm text-slate-400">Textos e imágenes de Inicio, Catálogo, Programas y Encárganos.</p>
            <p class="mt-2 max-w-2xl text-xs text-emerald-400/90">
                En Canva: tamaño personalizado con los px de cada foto → PNG o JPG → subir aquí.
                El asunto importante va al centro (se recorta con object-cover). Vista previa aquí (R2 o local); no hace falta ir a la web pública.
            </p>
        </div>
        <button @onclick="GuardarTextos" disabled="@_saving"
                class="rounded-lg bg-emerald-500 px-5 py-2 font-bold text-slate-950 hover:bg-emerald-400 disabled:opacity-50">
            @(_saving ? "Guardando…" : "Grabar textos")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-300">@_msg</div>
    }

    <div class="mb-6 flex flex-wrap gap-2">
        @foreach (var tab in Tabs)
        {
            <button type="button" @onclick="() => _tab = tab.Id"
                    class="rounded-full px-4 py-2 text-sm @(_tab == tab.Id ? "bg-emerald-500 font-semibold text-slate-950" : "border border-slate-700 text-slate-300")">
                @tab.Label
            </button>
        }
    </div>

    @if (_tab == "home")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Inicio (hero)</h2>
            @foreach (var f in TextFields.Where(x => x.Section == "home"))
            {
                @Field(f.Key, f.Label, f.Multiline)
            }
        </section>
        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Foto de fondo del inicio</h2>
            <p class="text-xs text-slate-400">Se ve detrás del texto y el carrusel. Si no subes nada, se usa la imagen por defecto del sitio.</p>
            @ImageBlock("hero-banner", "Banner hero (fondo)", SizeGuide("hero-banner"))
        </section>
        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-1 font-bold text-white">Carrusel vertical (inicio)</h2>
            <p class="mb-4 text-xs text-slate-400">Imágenes propias del hero — no salen del catálogo. Sube hasta 6; el orden es 1 → 6 y rota en bucle. Todas usan el mismo tamaño Canva.</p>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @for (var i = 1; i <= 6; i++)
                {
                    var n = i;
                    @ImageBlock($"hero-carousel-{n}", $"Carrusel {n}", SizeGuide($"hero-carousel-{n}"))
                }
            </div>
        </section>
    }
    else if (_tab == "catalog")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Catálogo</h2>
            @foreach (var f in TextFields.Where(x => x.Section == "catalog"))
            {
                @Field(f.Key, f.Label, f.Multiline)
            }
            <p class="pt-2 text-xs text-slate-500">
                Las fotos de cada diseño se cambian en
                <a href="/admin/catalog" class="text-emerald-400 underline">Catálogo</a>
                (preview al subir el CDR).
                Canva recomendado ahí: <span class="font-semibold text-emerald-300">1080 × 1350 px (4:5 vertical)</span>.
            </p>
        </section>
    }
    else if (_tab == "programas")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Cabecera · Programas</h2>
            @Field("programas.badge", "Etiqueta superior", false)
            @Field("programas.desc", "Descripción principal", true)
            @Field("programas.flow.title", "Título sección flujo", false)
            @Field("programas.flow.desc", "Texto sección flujo", true)
        </section>

        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Imagen de armado</h2>
            <p class="text-xs text-slate-400">Sube la imagen y edita el texto que sale encima en la web.</p>
            @ImageBlock("prog-armado", "Vista previa armado", SizeGuide("prog-armado"))
            <div class="space-y-3 pt-2">
                @Field("programas.armado.title", "Título sobre la imagen", false)
                @Field("programas.armado.desc", "Texto sobre la imagen", true)
                @Field("programas.video.caption", "Pie del video (al lado en la web)", false)
            </div>
            <div class="pt-2">
                <p class="mb-2 text-xs uppercase tracking-wider text-slate-400">Poster del video</p>
                @ImageBlock("prog-video-poster", "Poster del video demo", SizeGuide("prog-video-poster"))
            </div>
            <div class="pt-2">
                <p class="mb-2 text-xs uppercase tracking-wider text-slate-400">Video demo (MP4)</p>
                @VideoBlock("prog-video")
            </div>
        </section>

        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-1 font-bold text-white">Pasos (1 imagen = 1 texto)</h2>
            <p class="mb-4 text-xs text-slate-400">El texto se edita debajo de cada foto. Las 4 usan el mismo tamaño Canva.</p>
            <div class="grid gap-5 sm:grid-cols-2">
                @StepCard("prog-1", "programas.step1.caption", "Paso 1")
                @StepCard("prog-2", "programas.step2.caption", "Paso 2")
                @StepCard("prog-3", "programas.step3.caption", "Paso 3")
                @StepCard("prog-4", "programas.step4.caption", "Paso 4")
            </div>
        </section>

        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Funciones (solo texto)</h2>
            @Field("programas.features.title", "Título de la sección", false)
            @for (var i = 1; i <= 6; i++)
            {
                var n = i;
                <div class="rounded-lg border border-slate-800 bg-slate-950 p-4">
                    <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-emerald-400">Función @n</p>
                    @Field($"programas.feature{n}.title", "Título", false)
                    @Field($"programas.feature{n}.desc", "Texto", true)
                </div>
            }
        </section>
    }
    else if (_tab == "encarganos")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Encárganos</h2>
            @Field("encarganos.eyebrow", "Etiqueta", false)
            @Field("encarganos.title", "Título", false)
            @Field("encarganos.gallery.title", "Título galería trabajos", false)
        </section>
        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-1 font-bold text-white">Trabajos (imagen + subir)</h2>
            <p class="mb-4 text-xs text-slate-400">Trabajo 1 es horizontal (grande). Trabajos 2 y 3 son verticales 4:5.</p>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var img in ImageFields.Where(x => x.Section == "encarganos"))
                {
                    <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
                        @ImageBlock(img.Key, img.Label, SizeGuide(img.Key))
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private string _tab = "home";
    private readonly Dictionary<string, string> _texts = new();
    private readonly Dictionary<string, string> _localSrc = new();
    private readonly Dictionary<string, string> _serverSrc = new();
    private bool _saving;
    private string? _uploading;
    private string _msg = "";
    private string _bust = DateTime.UtcNow.Ticks.ToString();

    private sealed record Tab(string Id, string Label);
    private sealed record TextField(string Section, string Key, string Label, bool Multiline);
    private sealed record ImageField(string Section, string Key, string Label);
    private sealed record SizeHint(string Px, string Ratio, string Tip);

    private static SizeHint SizeGuide(string assetKey) => assetKey switch
    {
        "hero-banner" => new("1920 × 1080 px", "16:9 horizontal", "Fondo fullscreen. Deja el centro libre (texto a la izquierda)."),
        var k when k.StartsWith("hero-carousel-", StringComparison.Ordinal) =>
            new("900 × 1200 px", "3:4 vertical", "Carrusel alto del hero (solo desktop)."),
        "prog-armado" => new("1920 × 1080 px", "16:9 horizontal", "Bloque grande de armado."),
        "prog-video-poster" => new("1920 × 1080 px", "16:9 horizontal", "Miniatura del video (mismo formato)."),
        "prog-1" or "prog-2" or "prog-3" or "prog-4" =>
            new("1200 × 900 px", "4:3 horizontal", "Tarjetas de los 4 pasos."),
        "encarganos-1" => new("1600 × 900 px", "16:9 horizontal", "Foto principal grande."),
        "encarganos-2" or "encarganos-3" =>
            new("1080 × 1350 px", "4:5 vertical", "Miniaturas laterales."),
        _ => new("1080 × 1080 px", "1:1", "Cuadrado genérico.")
    };

    private static readonly Tab[] Tabs =
    [
        new("home", "Inicio"),
        new("catalog", "Catálogo"),
        new("programas", "Programas"),
        new("encarganos", "Encárganos")
    ];

    private static readonly TextField[] TextFields =
    [
        new("home", "home.hero.eyebrow", "Etiqueta del hero", false),
        new("home", "home.hero.title", "Título del hero", true),
        new("home", "home.hero.desc", "Texto del hero", true),
        new("catalog", "catalog.eyebrow", "Etiqueta", false),
        new("catalog", "catalog.title", "Título (usa | para partir, ej. Fútbol|Vóley)", false),
        new("catalog", "catalog.desc", "Subtítulo", true),
        new("programas", "programas.badge", "Etiqueta superior", false),
        new("programas", "programas.desc", "Descripción principal", true),
        new("programas", "programas.flow.title", "Título sección flujo", false),
        new("programas", "programas.flow.desc", "Texto sección flujo", true),
        new("programas", "programas.armado.title", "Título imagen armado", false),
        new("programas", "programas.armado.desc", "Texto imagen armado", true),
        new("programas", "programas.video.caption", "Pie del video", false),
        new("programas", "programas.step1.caption", "Paso 1 · texto", false),
        new("programas", "programas.step2.caption", "Paso 2 · texto", false),
        new("programas", "programas.step3.caption", "Paso 3 · texto", false),
        new("programas", "programas.step4.caption", "Paso 4 · texto", false),
        new("programas", "programas.features.title", "Título Funciones", false),
        new("programas", "programas.feature1.title", "Función 1 · título", false),
        new("programas", "programas.feature1.desc", "Función 1 · texto", true),
        new("programas", "programas.feature2.title", "Función 2 · título", false),
        new("programas", "programas.feature2.desc", "Función 2 · texto", true),
        new("programas", "programas.feature3.title", "Función 3 · título", false),
        new("programas", "programas.feature3.desc", "Función 3 · texto", true),
        new("programas", "programas.feature4.title", "Función 4 · título", false),
        new("programas", "programas.feature4.desc", "Función 4 · texto", true),
        new("programas", "programas.feature5.title", "Función 5 · título", false),
