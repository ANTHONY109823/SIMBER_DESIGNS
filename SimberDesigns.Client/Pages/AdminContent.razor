    private async Task GuardarTextos()
    {
        _saving = true; _msg = "";
        try { await Api.SaveContentAsync(_texts); _msg = "Textos guardados."; }
        catch { _msg = "No se pudieron guardar los textos."; }
        finally { _saving = false; }
    }

    private async Task Subir(string key, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _uploading = key; _msg = "";
        try
        {
            await using var stream = file.OpenReadStream(15_000_000);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            // Vista previa inmediata (gratis): se queda aunque falle R2 al refrescar.
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _localSrc[key] = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            StateHasChanged();

            ms.Position = 0;
            var (url, bust, preview, err) = await Api.UploadAssetWithBustAsync(key, ms, file.Name, mime);
            if (url is null)
            {
                _msg = err ?? "No se pudo subir la imagen.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(bust))
                _bust = bust!;

            if (!string.IsNullOrWhiteSpace(preview))
                _serverSrc[key] = preview!;
            else
                _serverSrc[key] = $"/api/content/asset/{Uri.EscapeDataString(key)}?v={Uri.EscapeDataString(_bust)}";

            // Mantiene data URL local (siempre se ve en el panel).
            _msg = "Imagen subida. Vista previa lista.";
        }
        catch (Exception ex)
        {
            _msg = "Error al subir: " + ex.Message;
        }
        finally { _uploading = null; }
    }
}
