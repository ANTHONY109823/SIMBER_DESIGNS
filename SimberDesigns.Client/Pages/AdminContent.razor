@page "/admin/content"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SimberApi Api

<PageTitle>Contenido de la web · Simber Admin</PageTitle>

<div class="p-6 md:p-8 max-w-5xl">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-extrabold text-white md:text-3xl">Contenido de la web</h1>
            <p class="mt-1 text-sm text-slate-400">Textos e imágenes de Inicio, Catálogo, Programas y Encárganos.</p>
        </div>
        <button @onclick="GuardarTextos" disabled="@_saving"
                class="rounded-lg bg-emerald-500 px-5 py-2 font-bold text-slate-950 hover:bg-emerald-400 disabled:opacity-50">
            @(_saving ? "Guardando…" : "Grabar textos")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-300">@_msg</div>
    }

    <div class="mb-6 flex flex-wrap gap-2">
        @foreach (var tab in Tabs)
        {
            <button type="button" @onclick="() => _tab = tab.Id"
                    class="rounded-full px-4 py-2 text-sm @(_tab == tab.Id ? "bg-emerald-500 font-semibold text-slate-950" : "border border-slate-700 text-slate-300")">
                @tab.Label
            </button>
        }
    </div>

    @if (_tab == "home")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Inicio (hero)</h2>
            @foreach (var f in TextFields.Where(x => x.Section == "home"))
            {
                @Field(f.Key, f.Label, f.Multiline)
            }
        </section>
        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Foto de fondo del inicio</h2>
            <p class="text-xs text-slate-400">Se ve detrás del texto y el carrusel. Si no subes nada, se usa la imagen por defecto del sitio.</p>
            @ImageBlock("hero-banner", "Banner hero (fondo)")
        </section>
        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-1 font-bold text-white">Carrusel vertical (inicio)</h2>
            <p class="mb-4 text-xs text-slate-400">Imágenes propias del hero — no salen del catálogo. Sube hasta 6; el orden es 1 → 6 y rota en bucle.</p>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @for (var i = 1; i <= 6; i++)
                {
                    var n = i;
                    @ImageBlock($"hero-carousel-{n}", $"Carrusel {n}")
                }
            </div>
        </section>
    }
    else if (_tab == "catalog")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Catálogo</h2>
            @foreach (var f in TextFields.Where(x => x.Section == "catalog"))
            {
                @Field(f.Key, f.Label, f.Multiline)
            }
            <p class="pt-2 text-xs text-slate-500">Las fotos de cada diseño se cambian en <a href="/admin/catalog" class="text-emerald-400 underline">Catálogo</a> (preview al subir el CDR).</p>
        </section>
    }
    else if (_tab == "programas")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Cabecera · Programas</h2>
            @Field("programas.badge", "Etiqueta superior", false)
            @Field("programas.desc", "Descripción principal", true)
            @Field("programas.flow.title", "Título sección flujo", false)
            @Field("programas.flow.desc", "Texto sección flujo", true)
        </section>

        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Imagen de armado</h2>
            <p class="text-xs text-slate-400">Sube la imagen y edita el texto que sale encima en la web.</p>
            @ImageBlock("prog-armado", "Vista previa armado")
            <div class="space-y-3 pt-2">
                @Field("programas.armado.title", "Título sobre la imagen", false)
                @Field("programas.armado.desc", "Texto sobre la imagen", true)
                @Field("programas.video.caption", "Pie del video (al lado en la web)", false)
            </div>
            <div class="pt-2">
                <p class="mb-2 text-xs uppercase tracking-wider text-slate-400">Poster del video</p>
                @ImageBlock("prog-video-poster", "Poster del video demo")
            </div>
        </section>

        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-1 font-bold text-white">Pasos (1 imagen = 1 texto)</h2>
            <p class="mb-4 text-xs text-slate-400">El texto se edita debajo de cada foto.</p>
            <div class="grid gap-5 sm:grid-cols-2">
                @StepCard("prog-1", "programas.step1.caption", "Paso 1")
                @StepCard("prog-2", "programas.step2.caption", "Paso 2")
                @StepCard("prog-3", "programas.step3.caption", "Paso 3")
                @StepCard("prog-4", "programas.step4.caption", "Paso 4")
            </div>
        </section>

        <section class="mt-6 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Funciones (solo texto)</h2>
            @Field("programas.features.title", "Título de la sección", false)
            @for (var i = 1; i <= 6; i++)
            {
                var n = i;
                <div class="rounded-lg border border-slate-800 bg-slate-950 p-4">
                    <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-emerald-400">Función @n</p>
                    @Field($"programas.feature{n}.title", "Título", false)
                    @Field($"programas.feature{n}.desc", "Texto", true)
                </div>
            }
        </section>
    }
    else if (_tab == "encarganos")
    {
        <section class="space-y-5 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="font-bold text-white">Textos · Encárganos</h2>
            @Field("encarganos.eyebrow", "Etiqueta", false)
            @Field("encarganos.title", "Título", false)
            @Field("encarganos.gallery.title", "Título galería trabajos", false)
        </section>
        <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6">
            <h2 class="mb-4 font-bold text-white">Trabajos (imagen + subir)</h2>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var img in ImageFields.Where(x => x.Section == "encarganos"))
                {
                    <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
                        @ImageBlock(img.Key, img.Label)
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private string _tab = "home";
    private readonly Dictionary<string, string> _texts = new();
    private bool _saving;
    private string? _uploading;
    private string _msg = "";
    private long _bust = DateTime.UtcNow.Ticks;

    private sealed record Tab(string Id, string Label);
    private sealed record TextField(string Section, string Key, string Label, bool Multiline);
    private sealed record ImageField(string Section, string Key, string Label);

    private static readonly Tab[] Tabs =
    [
        new("home", "Inicio"),
        new("catalog", "Catálogo"),
        new("programas", "Programas"),
        new("encarganos", "Encárganos")
    ];

    private static readonly TextField[] TextFields =
    [
        new("home", "home.hero.eyebrow", "Etiqueta del hero", false),
        new("home", "home.hero.title", "Título del hero", true),
        new("home", "home.hero.desc", "Texto del hero", true),
        new("catalog", "catalog.eyebrow", "Etiqueta", false),
        new("catalog", "catalog.title", "Título (usa | para partir, ej. Fútbol|Vóley)", false),
        new("catalog", "catalog.desc", "Subtítulo", true),
        new("programas", "programas.badge", "Etiqueta superior", false),
        new("programas", "programas.desc", "Descripción principal", true),
        new("programas", "programas.flow.title", "Título sección flujo", false),
        new("programas", "programas.flow.desc", "Texto sección flujo", true),
        new("programas", "programas.armado.title", "Título imagen armado", false),
        new("programas", "programas.armado.desc", "Texto imagen armado", true),
        new("programas", "programas.video.caption", "Pie del video", false),
        new("programas", "programas.step1.caption", "Paso 1 · texto", false),
        new("programas", "programas.step2.caption", "Paso 2 · texto", false),
        new("programas", "programas.step3.caption", "Paso 3 · texto", false),
        new("programas", "programas.step4.caption", "Paso 4 · texto", false),
        new("programas", "programas.features.title", "Título Funciones", false),
        new("programas", "programas.feature1.title", "Función 1 · título", false),
        new("programas", "programas.feature1.desc", "Función 1 · texto", true),
        new("programas", "programas.feature2.title", "Función 2 · título", false),
        new("programas", "programas.feature2.desc", "Función 2 · texto", true),
        new("programas", "programas.feature3.title", "Función 3 · título", false),
        new("programas", "programas.feature3.desc", "Función 3 · texto", true),
        new("programas", "programas.feature4.title", "Función 4 · título", false),
        new("programas", "programas.feature4.desc", "Función 4 · texto", true),
        new("programas", "programas.feature5.title", "Función 5 · título", false),
        new("programas", "programas.feature5.desc", "Función 5 · texto", true),
        new("programas", "programas.feature6.title", "Función 6 · título", false),
        new("programas", "programas.feature6.desc", "Función 6 · texto", true),
        new("encarganos", "encarganos.eyebrow", "Etiqueta", false),
        new("encarganos", "encarganos.title", "Título", false),
        new("encarganos", "encarganos.gallery.title", "Título galería trabajos", false)
    ];

    private static readonly ImageField[] ImageFields =
    [
        new("home", "hero-banner", "Banner hero (fondo)"),
        new("home", "hero-carousel-1", "Carrusel 1"),
        new("home", "hero-carousel-2", "Carrusel 2"),
        new("home", "hero-carousel-3", "Carrusel 3"),
        new("home", "hero-carousel-4", "Carrusel 4"),
        new("home", "hero-carousel-5", "Carrusel 5"),
        new("home", "hero-carousel-6", "Carrusel 6"),
        new("programas", "prog-armado", "Imagen principal (armado)"),
        new("programas", "prog-video-poster", "Poster del video"),
        new("programas", "prog-1", "Paso 1 · lista"),
        new("programas", "prog-2", "Paso 2 · molde"),
        new("programas", "prog-3", "Paso 3 · armado"),
        new("programas", "prog-4", "Paso 4 · resultado"),
        new("encarganos", "encarganos-1", "Trabajo principal"),
        new("encarganos", "encarganos-2", "Trabajo 2"),
        new("encarganos", "encarganos-3", "Trabajo 3")
    ];

    private RenderFragment Field(string key, string label, bool multiline) => __builder =>
    {
        if (!_texts.ContainsKey(key)) _texts[key] = Defaults.GetValueOrDefault(key, "");
        <div>
            <label class="mb-1 block text-xs uppercase tracking-wider text-slate-400">@label</label>
            @if (multiline)
            {
                <textarea @bind="_texts[key]" rows="2" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"></textarea>
            }
            else
            {
                <input @bind="_texts[key]" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100" />
            }
        </div>
    };

    private RenderFragment ImageBlock(string assetKey, string label) => __builder =>
    {
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
            <div class="relative h-40 bg-gradient-to-br from-slate-800 to-slate-950">
                <img src="@($"/api/content/asset/{assetKey}?v={_bust}")" alt="@label" onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-cover" />
                <span class="absolute bottom-1 left-2 rounded bg-slate-950/70 px-1.5 text-[11px] text-slate-300">@label</span>
            </div>
            <div class="flex items-center gap-2 p-3">
                <InputFile OnChange="@(e => Subir(assetKey, e))" accept="image/*" class="text-xs text-slate-400" />
                @if (_uploading == assetKey) { <span class="text-xs text-emerald-400">subiendo…</span> }
            </div>
        </div>
    };

    private RenderFragment StepCard(string assetKey, string textKey, string label) => __builder =>
    {
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
            <div class="relative h-40 bg-gradient-to-br from-slate-800 to-slate-950">
                <img src="@($"/api/content/asset/{assetKey}?v={_bust}")" alt="@label" onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-cover" />
                <span class="absolute bottom-1 left-2 rounded bg-slate-950/70 px-1.5 text-[11px] text-slate-300">@label</span>
            </div>
            <div class="space-y-2 p-3">
                <InputFile OnChange="@(e => Subir(assetKey, e))" accept="image/*" class="text-xs text-slate-400" />
                @if (_uploading == assetKey) { <span class="text-xs text-emerald-400">subiendo…</span> }
                @Field(textKey, "Texto debajo de esta imagen", false)
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        foreach (var f in TextFields) _texts[f.Key] = Defaults.TryGetValue(f.Key, out var d) ? d : "";
        try
        {
            var c = await Api.GetContentAsync();
            foreach (var f in TextFields)
            {
                if (c.TryGetValue(f.Key, out var v) && !string.IsNullOrWhiteSpace(v))
                    _texts[f.Key] = v;
            }
        }
        catch { }
    }

    private static readonly Dictionary<string, string> Defaults = new()
    {
        ["home.hero.eyebrow"] = "Vectores · Sublimación · Wireframe",
        ["home.hero.title"] = "Del patrón a la camiseta en menos de tres clics.",
        ["home.hero.desc"] = "Catálogo CDR y programas para CorelDRAW e Illustrator.",
        ["catalog.eyebrow"] = "Catálogo CDR",
        ["catalog.title"] = "Fútbol|Vóley",
        ["programas.badge"] = "Herramienta · CorelDRAW e Illustrator",
        ["programas.desc"] = "Arma mockups, nombres y dorsales en CorelDRAW e Illustrator.",
        ["programas.flow.title"] = "Cómo se ve trabajando",
        ["programas.flow.desc"] = "El flujo real: lees la lista, tomas los moldes y el programa arma y acomoda solo en CorelDRAW o Illustrator, con nombres y dorsales.",
        ["programas.armado.title"] = "Armado automático en CorelDRAW / Illustrator",
        ["programas.armado.desc"] = "Duplica el molde por jugador, pone nombre y dorsal y acomoda en bloques.",
        ["programas.video.caption"] = "Video del flujo (si está subido en Programas).",
        ["programas.step1.caption"] = "1 · Pegas o subes la lista (o foto con IA)",
        ["programas.step2.caption"] = "2 · Tomas el molde por género y talla",
        ["programas.step3.caption"] = "3 · Arma con nombres y dorsales, en bloques",
        ["programas.step4.caption"] = "4 · Listo para exportar e imprimir",
        ["programas.features.title"] = "Funciones",
        ["programas.feature1.title"] = "Armado automático",
        ["programas.feature1.desc"] = "Duplica el molde por jugador y acomoda las piezas en bloques, listo para producir.",
        ["programas.feature2.title"] = "Nombres y dorsales",
        ["programas.feature2.desc"] = "Toma la lista y rellena nombre y número conservando la tipografía del molde.",
        ["programas.feature3.title"] = "Corel e Illustrator",
        ["programas.feature3.desc"] = "Trabaja dentro de tu programa; tú solo exportas e imprimes como siempre.",
        ["programas.feature4.title"] = "Lectura con IA",
        ["programas.feature4.desc"] = "Lee la lista de jugadores desde una foto o un archivo, sin teclear.",
        ["programas.feature5.title"] = "Aprovecha la tela",
        ["programas.feature5.desc"] = "Acomoda las piezas al ancho de tu rollo y en bloques para desperdiciar menos.",
        ["programas.feature6.title"] = "Login + pago",
        ["programas.feature6.desc"] = "Descargas gratis; al abrir el programa inicias sesión y pagas el mes en dólares (al tipo de cambio).",
        ["encarganos.eyebrow"] = "Cotización",
        ["encarganos.title"] = "Encárganos a nosotros",
        ["encarganos.gallery.title"] = "Así queda en cancha"
    };

    private async Task GuardarTextos()
    {
        _saving = true; _msg = "";
        try { await Api.SaveContentAsync(_texts); _msg = "Textos guardados."; }
        catch { _msg = "No se pudieron guardar los textos."; }
        finally { _saving = false; }
    }

    private async Task Subir(string key, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _uploading = key; _msg = "";
        try
        {
            await using var stream = file.OpenReadStream(15_000_000);
            var url = await Api.UploadAssetAsync(key, stream, file.Name, file.ContentType);
            _bust = DateTime.UtcNow.Ticks;
            _msg = url is null ? "No se pudo subir la imagen." : "Imagen subida.";
        }
        catch { _msg = "Error al subir la imagen."; }
        finally { _uploading = null; }
    }
}
