        new("encarganos", "encarganos.gallery.title", "Título galería trabajos", false)
    ];

    private static readonly ImageField[] ImageFields =
    [
        new("home", "hero-banner", "Banner hero (fondo)"),
        new("home", "hero-carousel-1", "Carrusel 1"),
        new("home", "hero-carousel-2", "Carrusel 2"),
        new("home", "hero-carousel-3", "Carrusel 3"),
        new("home", "hero-carousel-4", "Carrusel 4"),
        new("home", "hero-carousel-5", "Carrusel 5"),
        new("home", "hero-carousel-6", "Carrusel 6"),
        new("programas", "prog-armado", "Imagen principal (armado)"),
        new("programas", "prog-video-poster", "Poster del video"),
        new("programas", "prog-1", "Paso 1 · lista"),
        new("programas", "prog-2", "Paso 2 · molde"),
        new("programas", "prog-3", "Paso 3 · armado"),
        new("programas", "prog-4", "Paso 4 · resultado"),
        new("encarganos", "encarganos-1", "Trabajo principal"),
        new("encarganos", "encarganos-2", "Trabajo 2"),
        new("encarganos", "encarganos-3", "Trabajo 3")
    ];

    private RenderFragment Field(string key, string label, bool multiline) => __builder =>
    {
        if (!_texts.ContainsKey(key)) _texts[key] = Defaults.GetValueOrDefault(key, "");
        <div>
            <label class="mb-1 block text-xs uppercase tracking-wider text-slate-400">@label</label>
            @if (multiline)
            {
                <textarea @bind="_texts[key]" rows="2" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"></textarea>
            }
            else
            {
                <input @bind="_texts[key]" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100" />
            }
        </div>
    };

    private RenderFragment ImageBlock(string assetKey, string label, SizeHint size) => __builder =>
    {
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
            @PreviewBox(assetKey, label)
            <div class="space-y-2 p-3">
                <div class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-2">
                    <p class="text-sm font-bold text-emerald-300">Canva: @size.Px</p>
                    <p class="text-[11px] text-slate-300">@size.Ratio · @size.Tip</p>
                </div>
                <div class="flex items-center gap-2">
                    <InputFile OnChange="@(e => Subir(assetKey, e))" accept="image/*" class="text-xs text-slate-400" />
                    @if (_uploading == assetKey) { <span class="text-xs text-emerald-400">subiendo…</span> }
                </div>
            </div>
        </div>
    };

    private RenderFragment VideoBlock(string assetKey) => __builder =>
    {
        var subido = _serverSrc.ContainsKey(assetKey) || _localSrc.ContainsKey(assetKey);
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
            <div class="flex h-28 items-center justify-center bg-gradient-to-br from-slate-800 to-slate-950">
                @if (subido) { <span class="text-sm font-semibold text-emerald-300">✓ Video subido</span> }
                else { <span class="text-xs text-slate-500">Sin video</span> }
            </div>
            <div class="space-y-2 p-3">
                <div class="rounded-md border border-orange-500/25 bg-orange-500/10 px-2.5 py-2">
                    <p class="text-sm font-bold text-orange-300">MP4 · 720p · máx 80 MB</p>
                    <p class="text-[11px] text-slate-300">Comprímelo en CapCut. Se guarda en R2 (sin costo por vistas).</p>
                </div>
                <div class="flex items-center gap-2">
                    <InputFile OnChange="@(e => SubirVideo(assetKey, e))" accept="video/mp4,video/webm,.mp4,.webm" class="text-xs text-slate-400" />
                    @if (_uploading == assetKey) { <span class="text-xs text-emerald-400">subiendo…</span> }
                </div>
            </div>
        </div>
    };

    private async Task SubirVideo(string key, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _uploading = key; _msg = "";
        try
        {
            await using var stream = file.OpenReadStream(80_000_000);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "video/mp4" : file.ContentType;
            var (url, bust, _, err) = await Api.UploadAssetWithBustAsync(key, ms, file.Name, mime);
            if (url is null) { _msg = err ?? "No se pudo subir el video."; return; }
            if (!string.IsNullOrWhiteSpace(bust)) _bust = bust!;
            _serverSrc[key] = $"/api/content/asset/{Uri.EscapeDataString(key)}?v={Uri.EscapeDataString(_bust)}";
            _msg = "Video subido a R2. Ya aparece en Programas.";
        }
        catch (Exception ex)
        {
            _msg = "Error al subir el video: " + ex.Message;
        }
        finally
        {
            _uploading = null;
            StateHasChanged();
        }
    }

    private RenderFragment StepCard(string assetKey, string textKey, string label) => __builder =>
    {
        var size = SizeGuide(assetKey);
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">
            @PreviewBox(assetKey, label)
            <div class="space-y-2 p-3">
                <div class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-2">
                    <p class="text-sm font-bold text-emerald-300">Canva: @size.Px</p>
                    <p class="text-[11px] text-slate-300">@size.Ratio · @size.Tip</p>
                </div>
                <InputFile OnChange="@(e => Subir(assetKey, e))" accept="image/*" class="text-xs text-slate-400" />
                @if (_uploading == assetKey) { <span class="text-xs text-emerald-400">subiendo…</span> }
                @Field(textKey, "Texto debajo de esta imagen", false)
            </div>
        </div>
    };

    private RenderFragment PreviewBox(string assetKey, string label) => __builder =>
    {
        var src = PreviewSrc(assetKey);
        <div class="relative h-40 bg-gradient-to-br from-slate-800 to-slate-950">
            @if (!string.IsNullOrWhiteSpace(src))
            {
                <img @key="src" src="@src" alt="@label"
                     class="absolute inset-0 h-full w-full object-cover"
                     @onerror="() => OnPreviewError(assetKey)" />
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center px-3 text-center text-xs text-slate-500">
                    Sin imagen aún — selecciona un archivo
                </div>
            }
            <span class="absolute bottom-1 left-2 rounded bg-slate-950/70 px-1.5 text-[11px] text-slate-300">@label</span>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        foreach (var f in TextFields) _texts[f.Key] = Defaults.TryGetValue(f.Key, out var d) ? d : "";
        try
        {
            var c = await Api.GetContentAsync();
            foreach (var f in TextFields)
            {
                if (c.TryGetValue(f.Key, out var v) && !string.IsNullOrWhiteSpace(v))
                    _texts[f.Key] = v;
            }

            if (c.TryGetValue("cms.bust", out var bust) && !string.IsNullOrWhiteSpace(bust))
                _bust = bust;
        }
        catch { }

        try
        {
            // Solo keys que existen en BD/R2 (si no hay fila → "Sin imagen", no error falso).
            var assets = await Api.GetContentAssetsAsync();
            foreach (var (key, preview) in assets)
            {
                if (!string.IsNullOrWhiteSpace(preview))
                    _serverSrc[key] = preview;
            }
        }
        catch { }
    }

    private string? PreviewSrc(string key)
    {
        if (_localSrc.TryGetValue(key, out var local) && !string.IsNullOrWhiteSpace(local))
            return local;
        if (_serverSrc.TryGetValue(key, out var server) && !string.IsNullOrWhiteSpace(server))
            return server;
        return null; // no inventar URL 404
    }

    private void OnPreviewError(string key)
    {
        // Quita URL rota; muestra "Sin imagen" (no el mensaje de error eterno).
        if (_localSrc.ContainsKey(key))
            return;
        _serverSrc.Remove(key);
        StateHasChanged();
    }

