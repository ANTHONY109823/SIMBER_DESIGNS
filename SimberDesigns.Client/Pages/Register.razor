@page "/register"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Crear cuenta · Simber Designs</PageTitle>

<div class="grid min-h-screen w-full lg:grid-cols-2">
    <section class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-sm">
            <a href="/" class="mb-8 flex items-center gap-2 font-serif text-2xl uppercase tracking-wide">
                <img src="favicon.png" alt="" class="h-8 w-8 rounded-md object-cover" />
                Simber <span class="text-gold">Designs</span>
            </a>
            <h1 class="font-serif text-3xl text-white">Crear cuenta</h1>
            <p class="mt-2 text-sm text-cream/60">Así pagas el mes o créditos al instante, con Mercado Pago.</p>
            <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
                <InputText class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white" placeholder="Nombre" @bind-Value="FullName" />
                <InputText class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white" placeholder="Email" @bind-Value="Email" />
                <div class="relative">
                    <InputText type="@(ShowPassword ? "text" : "password")" class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 pr-24 text-white" placeholder="Contraseña (mín. 6)" @bind-Value="Password" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-cream/55 hover:text-white" @onclick="() => ShowPassword = !ShowPassword">
                        @(ShowPassword ? "Ocultar" : "Mostrar")
                    </button>
                </div>
                <button class="w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink" type="submit">Crear y entrar</button>
            </EditForm>
            <p class="mt-6 text-sm text-cream/50">
                ¿Ya tienes cuenta? <a href="/login" class="text-gold hover:underline">Entrar</a>
            </p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="mt-4 text-sm text-rose-400">@Error</p>
            }
        </div>
    </section>
    <aside class="hidden items-center bg-gradient-to-br from-ink via-ink to-orange-950/40 px-12 lg:flex">
        <div class="max-w-md">
            <p class="text-xs uppercase tracking-[0.28em] text-gold">Después de crear la cuenta</p>
            <p class="mt-4 font-serif text-3xl text-white">Paga el mes y activa el programa en tu PC.</p>
            <p class="mt-3 text-sm text-cream/70">S/56 ≈ US$15 · IA incluida · 1 PC.</p>
        </div>
    </aside>
</div>

@code {
    private string FullName { get; set; } = "";
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ShowPassword;
    private string? Error;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(Email) || Password.Length < 6)
        {
            Error = "Correo y una contraseña de al menos 6 caracteres.";
            return;
        }

        var result = await Api.RegisterAsync(Email, Password, FullName);
        if (result is null)
        {
            Error = "No se pudo crear la cuenta. ¿Ese correo ya está registrado?";
            return;
        }

        await Auth.SignInAsync(result.Token);
        Nav.NavigateTo("/recargar");
    }
}
