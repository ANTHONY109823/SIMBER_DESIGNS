@page "/register"
@layout BlankLayout
@inject SimberApi Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Crear cuenta · Simber Designs</PageTitle>

<div class="grid min-h-screen w-full lg:grid-cols-2">
    <section class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-sm">
            <a href="/" class="mb-8 flex items-center gap-2 font-serif text-2xl uppercase tracking-wide">
                <img src="/favicon.png?v=4" alt="" class="h-8 w-8 rounded-md object-cover" />
                Simber <span class="text-gold">Designs</span>
            </a>
            <h1 class="font-serif text-3xl text-white">Crear cuenta</h1>
            <p class="mt-2 text-sm text-cream/80">La misma cuenta sirve en la web y al abrir el programa en tu PC.</p>
            <EditForm Model="this" OnValidSubmit="Submit" class="mt-8 space-y-4">
                <label class="block text-sm">
                    <span class="text-cream/85">Nombre</span>
                    <InputText class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" autocomplete="name" @bind-Value="FullName" />
                </label>
                <label class="block text-sm">
                    <span class="text-cream/85">Correo</span>
                    <InputText class="mt-2 w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 text-white outline-none focus:border-gold/60" autocomplete="username" placeholder="tucorreo@email.com" @bind-Value="Email" />
                </label>
                <label class="block text-sm">
                    <span class="text-cream/85">Contraseña (mín. 6)</span>
                    <div class="relative mt-2">
                        <InputText type="@(ShowPassword ? "text" : "password")" autocomplete="new-password" class="w-full rounded-2xl border border-white/10 bg-ink px-4 py-3 pr-24 text-white outline-none focus:border-gold/60" @bind-Value="Password" />
                        <button type="button" class="absolute right-3 top-1/2 min-h-11 -translate-y-1/2 text-xs text-cream/80 hover:text-white" @onclick="() => ShowPassword = !ShowPassword">
                            @(ShowPassword ? "Ocultar" : "Mostrar")
                        </button>
                    </div>
                </label>
                <button class="min-h-11 w-full rounded-full bg-gold py-3 text-sm font-semibold text-ink disabled:opacity-60" type="submit" disabled="@Busy">
                    @(Busy ? "Creando…" : "Crear y entrar")
                </button>
            </EditForm>
            <p class="mt-6 text-sm text-cream/80">
                ¿Ya tienes cuenta? <a href="/login" class="text-gold hover:underline">Entrar</a>
            </p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="mt-4 text-sm text-rose-400" role="alert">@Error</p>
            }
        </div>
    </section>
    <aside class="hidden items-center bg-gradient-to-br from-ink via-ink to-orange-950/40 px-12 lg:flex">
        <div class="max-w-md">
            <p class="text-xs uppercase tracking-[0.28em] text-gold">Después de crear la cuenta</p>
            <p class="mt-4 font-serif text-3xl text-white">El .exe es gratis. El mes se activa en tu cuenta.</p>
            <p class="mt-3 text-sm text-cream/80">Corel e Illustrator por separado · 1 PC · IA incluida mientras el mes esté vigente.</p>
        </div>
    </aside>
</div>

@code {
    private string FullName { get; set; } = "";
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ShowPassword;
    private bool Busy;
    private string? Error;

    private async Task Submit()
    {
        Error = null;
        if (string.IsNullOrWhiteSpace(Email) || Password.Length < 6)
        {
            Error = "Correo y una contraseña de al menos 6 caracteres.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Api.RegisterAsync(Email, Password, FullName);
            if (result is null)
            {
                Error = "No se pudo crear la cuenta. ¿Ese correo ya está registrado?";
                return;
            }

            await Auth.SignInAsync(result.Token);
            Nav.NavigateTo("/cuenta");
        }
        finally
        {
            Busy = false;
        }
    }
}
