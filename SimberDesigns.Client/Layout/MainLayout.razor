@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<div class="min-h-screen bg-ink text-cream">
    <header class="sticky top-0 z-30 border-b border-white/10 bg-ink/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <a href="/" class="font-serif text-2xl tracking-wide uppercase">Simber <span class="text-gold">Designs</span></a>
            <nav class="hidden items-center gap-6 text-sm md:flex">
                <NavLink href="/catalog">Catálogo</NavLink>
                <NavLink href="/programas">Programas</NavLink>
                <NavLink href="/recargar">Recargar</NavLink>
            </nav>
            <div class="hidden items-center gap-3 text-sm md:flex">
                <AuthorizeView>
                    <Authorized>
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="admin">
                                <NavLink href="/admin/catalog">Cargar</NavLink>
                                <NavLink href="/admin/payments">Pagos</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <NavLink href="/cuenta">Cuenta</NavLink>
                        <button class="rounded-full border border-white/20 px-4 py-2" @onclick="Logout">Salir</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="rounded-full bg-gold px-5 py-2 font-semibold text-ink">Entrar</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <nav class="flex gap-4 overflow-x-auto border-t border-white/10 px-4 py-3 text-sm md:hidden">
            <NavLink href="/catalog">Catálogo</NavLink>
            <NavLink href="/programas">Programas</NavLink>
            <NavLink href="/recargar">Recargar</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/cuenta">Cuenta</NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login">Entrar</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="mt-16 border-t border-white/10 px-6 py-10 text-center text-sm text-cream/50">
        Simber Designs · Herramienta de armado para CorelDRAW e Illustrator · Sublimación textil
    </footer>
</div>

@code {
    private async Task Logout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
