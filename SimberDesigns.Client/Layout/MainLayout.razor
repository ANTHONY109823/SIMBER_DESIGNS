@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<div class="min-h-screen bg-ink text-cream">
    <header class="sticky top-0 z-30 border-b border-white/10 bg-ink/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <a href="/" class="flex items-center gap-2 font-serif text-2xl tracking-wide uppercase">
                <img src="/favicon.png?v=4" alt="" class="h-8 w-8 rounded-md object-cover" />
                Simber <span class="text-gold">Designs</span>
            </a>
            <nav class="hidden items-center gap-6 text-sm md:flex">
                <NavLink href="/catalog" class="hover:text-gold" ActiveClass="text-gold">Catálogo</NavLink>
                <NavLink href="/programas" class="hover:text-gold" ActiveClass="text-gold">Programas</NavLink>
                <NavLink href="/encarganos" class="hover:text-gold" ActiveClass="text-gold">Encárganos a nosotros</NavLink>
            </nav>
            <div class="hidden items-center gap-3 text-sm md:flex">
                <AuthorizeView>
                    <Authorized>
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="admin">
                                <a href="/admin" class="rounded-full border border-white/20 px-4 py-2">Panel admin</a>
                            </Authorized>
                            <NotAuthorized Context="cliente">
                                <NavLink href="/cuenta">Mi cuenta</NavLink>
                            </NotAuthorized>
                        </AuthorizeView>
                        <button class="rounded-full border border-white/20 px-4 py-2" @onclick="Logout">Salir</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="rounded-full bg-gold px-5 py-2 font-semibold text-ink hover:bg-orange-400">Entrar</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <nav class="flex gap-4 overflow-x-auto border-t border-white/10 px-4 py-3 text-sm md:hidden">
            <NavLink href="/catalog">Catálogo</NavLink>
            <NavLink href="/programas">Programas</NavLink>
            <NavLink href="/encarganos">Encárganos a nosotros</NavLink>
            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="admin">
                            <a href="/admin">Panel admin</a>
                        </Authorized>
                        <NotAuthorized Context="cliente">
                            <NavLink href="/cuenta">Mi cuenta</NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login">Entrar</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>

</div>

@code {
    private async Task Logout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
