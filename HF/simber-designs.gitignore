# ==========================================
# Simber designs - .gitignore Oficial para C# & .NET
# Protege el repositorio contra archivos pesados (WinRAR/ZIP de 100 MB) e IA (ONNX)
# ==========================================

# ------------------------------------------
# 1. Reglas Críticas de Exclusión de Activos de Diseño (100 MB+)
# ------------------------------------------
# NUNCA subir archivos comprimidos, vectores pesados ni mockups al repositorio de Git.
# Estos archivos se gestionan a través de Cloudflare R2 / AWS S3.
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.dmg

# Excluir carpetas locales de almacenamiento de archivos temporales o descargas
[Uu]ploads/
[Aa]ssets/raw/
[Aa]ssets/designs/
[Aa]p_Data/

# ------------------------------------------
# 2. Exclusiones de Inteligencia Artificial & Modelos de Búsqueda Visual
# ------------------------------------------
# Los modelos de embeddings (como CLIP de OpenAI o ResNet) pesan cientos de MBs.
# Deben descargarse durante el despliegue de producción o aprovisionamiento, nunca en Git.
*.onnx
*.pb
*.onnx.meta
models/
/MachineLearning/Models/clip_vit_b32.onnx

# ------------------------------------------
# 3. Archivos de Configuración Sensibles (Secretos e Integración)
# ------------------------------------------
# Contienen credenciales de PostgreSQL, Cloudflare R2, Lemon Squeezy, etc.
appsettings.json
appsettings.Development.json
appsettings.Production.json
!appsettings.Template.json
*.pem
*.key
*.pfx
*.cert
secrets.json

# ------------------------------------------
# 4. Archivos Temporales y Compilación de .NET / C#
# ------------------------------------------
# Carpetas de salida de compilación
[Bb]in/
[Oo]bj/
[Oo]ut/

# Archivos de caché de MSBuild y Roslyn
.msbuild/
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates

# Archivos generados por pruebas y cobertura de código
TestResults/
*.clog
*.cobertura.xml
artifacts/

# ------------------------------------------
# 5. Dependencias del Cliente (Frontend Web / Blazor)
# ------------------------------------------
# Node.js (Si utilizas Next.js desacoplado o compiladores de Tailwind CSS)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Estilos compilados o archivos generados
wwwroot/css/tailwind.min.css
wwwroot/dist/

# ------------------------------------------
# 6. Base de Datos Local y Migraciones
# ------------------------------------------
# Respaldos de Postgres o bases de datos SQLite locales de prueba
*.db
*.db-journal
*.db-shm
*.db-wal
*.sql.bak
*.dump
