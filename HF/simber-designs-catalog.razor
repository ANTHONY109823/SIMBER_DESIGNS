@page "/catalog"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<div class="min-h-screen bg-slate-900 text-slate-100 font-sans">
    <!-- HERO & BUSCADOR VISUAL (Inspirado en Foraes) -->
    <div class="relative bg-gradient-to-b from-slate-950 to-slate-900 py-16 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto text-center">
            <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mb-4">
                SIMBER <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">DESIGNS</span>
            </h1>
            <p class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-8">
                Vectores deportivos y mockups de calidad premium para sublimación. Descarga instantánea de archivos editables de alta fidelidad.
            </p>

            <!-- Zona de Búsqueda Inteligente (Estilo Google Lens / Drag & Paste) -->
            <div @ref="dropZoneElement"
                 @onpointerenter="OnDragEnter"
                 @onpointerleave="OnDragLeave"
                 class="max-w-3xl mx-auto relative group">
                
                <div class="@(isDragging ? "border-cyan-400 bg-cyan-950/20 scale-[1.02]" : "border-slate-700 bg-slate-950/40 hover:border-slate-600") 
                            border-2 border-dashed rounded-2xl p-8 md:p-12 transition-all duration-300 backdrop-blur-sm cursor-pointer relative overflow-hidden">
                    
                    <InputFile OnChange="HandleFileSelected" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

                    <div class="flex flex-col items-center justify-center space-y-4 pointer-events-none">
                        <!-- Icono Buscador Visual -->
                        <div class="w-16 h-16 rounded-2xl bg-slate-800/80 border border-slate-700 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        
                        <div class="text-center">
                            <p class="text-white font-semibold text-lg">
                                Arrastra una imagen aquí o <span class="text-cyan-400 font-bold underline decoration-wavy">búscala en tu equipo</span>
                            </p>
                            <p class="text-slate-400 text-sm mt-1">
                                Soporta JPG, PNG, WEBP. También puedes presionar <kbd class="px-2 py-1 bg-slate-800 rounded text-xs text-slate-300 font-mono">Ctrl + V</kbd> para pegar captura.
                            </p>
                        </div>
                    </div>

                    @if (isAnalyzing)
                    {
                        <!-- Capa de Procesamiento Inteligente -->
                        <div class="absolute inset-0 bg-slate-950/90 flex flex-col items-center justify-center space-y-4 z-20 backdrop-blur-md">
                            <div class="relative w-20 h-20">
                                <div class="absolute inset-0 rounded-full border-4 border-slate-800"></div>
                                <div class="absolute inset-0 rounded-full border-4 border-t-cyan-400 animate-spin"></div>
                            </div>
                            <div class="text-center">
                                <p class="text-cyan-400 font-bold tracking-wider animate-pulse">EXTRAYENDO EMBEDDINGS VECTORIALES...</p>
                                <p class="text-slate-400 text-xs mt-1">ONNX Runtime está procesando los tensores de la imagen</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Indicador de Búsqueda por Imagen Activa -->
            @if (activeVisualSearchImage != null)
            {
                <div class="mt-6 inline-flex items-center space-x-3 bg-cyan-950/40 border border-cyan-800 px-4 py-2 rounded-full text-sm">
                    <img src="@activeVisualSearchImage" class="w-8 h-8 rounded object-cover border border-cyan-500" />
                    <span class="text-cyan-300">Búsqueda visual activa (Distancia Coseno pgvector)</span>
                    <button @onclick="ClearVisualSearch" class="text-slate-400 hover:text-white font-bold ml-2">×</button>
                </div>
            }
        </div>
    </div>

    <!-- CUERPO PRINCIPAL: FILTROS Y CATÁLOGO -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="flex flex-col lg:flex-row gap-8">
            
            <!-- PANEL LATERAL DE FILTROS (100% Responsivo colapsable en móvil) -->
            <div class="w-full lg:w-64 flex-shrink-0 space-y-6">
                <!-- Tarjeta de Saldo de Usuario (Estilo Foraes) -->
                <div class="bg-gradient-to-br from-slate-950 to-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Tu Cuenta</h3>
                    <div class="flex items-baseline justify-between mb-4">
                        <span class="text-3xl font-black text-white">$45.00</span>
                        <span class="text-xs text-cyan-400 font-mono">Créditos Simber</span>
                    </div>
                    <p class="text-slate-400 text-xs mb-4">Membresía activa: <span class="text-emerald-400 font-semibold">VIP ($16/mes)</span></p>
                    <div class="w-full bg-slate-800 rounded-full h-1.5 mb-2">
                        <div class="bg-cyan-400 h-1.5 rounded-full" style="width: 60%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 mb-4">
                        <span>Descargas de hoy</span>
                        <span class="text-white font-semibold">15 / 25 diarias</span>
                    </div>
                    <button class="w-full py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-sm font-bold rounded-xl transition-all shadow-lg shadow-cyan-900/30">
                        Recargar Saldo (QR / PayPal)
                    </button>
                </div>

                <!-- Categorías de Diseño (Inspirado en catálogos deportivos) -->
                <div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-6">
                    <h4 class="text-sm font-bold text-white mb-4 flex items-center">
                        <svg class="w-4 h-4 text-cyan-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
                        Categorías
                    </h4>
                    <div class="space-y-2">
                        @foreach (var cat in categories)
                        {
                            <button @onclick="() => SelectCategory(cat)"
                                    class="w-full text-left px-3 py-2 rounded-lg text-sm transition-colors flex justify-between items-center @(selectedCategory == cat ? "bg-cyan-950 text-cyan-300 font-semibold border-l-4 border-cyan-400" : "text-slate-400 hover:bg-slate-800/50 hover:text-white")">
                                <span>@cat</span>
                                <span class="text-xs bg-slate-800 px-2 py-0.5 rounded text-slate-500">@(GetCountForCategory(cat))</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Filtros por Formato e Impuestos / Moneda -->
                <div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-6">
                    <h4 class="text-sm font-bold text-white mb-4">Formato de Archivo</h4>
                    <div class="space-y-2 text-sm text-slate-400">
                        <label class="flex items-center space-x-2 cursor-pointer hover:text-white">
                            <input type="checkbox" checked class="rounded bg-slate-800 border-slate-700 text-cyan-500 focus:ring-0" />
                            <span>EPS (Vector Editable)</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer hover:text-white">
                            <input type="checkbox" checked class="rounded bg-slate-800 border-slate-700 text-cyan-500 focus:ring-0" />
                            <span>CDR (CorelDraw)</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer hover:text-white">
                            <input type="checkbox" checked class="rounded bg-slate-800 border-slate-700 text-cyan-500 focus:ring-0" />
                            <span>PDF (Listo para Impresión)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- GRILLA DE DISEÑOS (100% Responsive Grid) -->
            <div class="flex-1 space-y-6">
                <!-- Barra de control superior (Orden y conteo) -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-slate-950/40 border border-slate-800 p-4 rounded-xl">
                    <p class="text-slate-400 text-sm">
                        Mostrando <span class="text-white font-bold">@filteredDesigns.Count</span> diseños de sublimación
                    </p>
                    <div class="flex items-center space-x-4">
                        <select @onchange="SortChanged" class="bg-slate-900 border border-slate-800 rounded-lg text-sm text-slate-300 py-1.5 px-3 focus:outline-none focus:border-cyan-400">
                            <option value="recent">Más recientes</option>
                            <option value="popular">Más populares</option>
                            <option value="price-asc">Precio: menor a mayor</option>
                            <option value="price-desc">Precio: mayor a menor</option>
                        </select>
                    </div>
                </div>

                <!-- Layout de Grilla Multicolumna Responsiva -->
                @if (isLoading)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="bg-slate-950/30 border border-slate-800/80 rounded-2xl p-4 animate-pulse space-y-4">
                                <div class="bg-slate-800 aspect-[4/5] rounded-xl"></div>
                                <div class="h-4 bg-slate-800 rounded w-2/3"></div>
                                <div class="h-3 bg-slate-800 rounded w-1/2"></div>
                                <div class="flex justify-between items-center pt-2 border-t border-slate-800">
                                    <div class="h-5 bg-slate-800 rounded w-1/3"></div>
                                    <div class="h-8 bg-slate-800 rounded-lg w-1/4"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (filteredDesigns.Count == 0)
                {
                    <div class="text-center py-20 bg-slate-950/20 border border-slate-800 border-dashed rounded-3xl">
                        <svg class="w-16 h-16 text-slate-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <h3 class="text-xl font-bold text-white mb-2">No se encontraron diseños</h3>
                        <p class="text-slate-400 text-sm max-w-sm mx-auto">Prueba limpiando los filtros o buscando con otra imagen en la zona de búsqueda visual.</p>
                        <button @onclick="ResetFilters" class="mt-4 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm transition-colors">Limpiar Filtros</button>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                        @foreach (var design in filteredDesigns)
                        {
                            <div class="group bg-slate-950/40 hover:bg-slate-950 border border-slate-800 hover:border-cyan-500/30 rounded-2xl p-4 transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-900/10 flex flex-col relative overflow-hidden">
                                
                                <!-- Similitud de Búsqueda Visual (badge dinámico pgvector) -->
                                @if (design.Similarity.HasValue)
                                {
                                    <div class="absolute top-6 left-6 z-10 bg-cyan-500/90 backdrop-blur-md text-slate-950 text-xs font-bold px-2.5 py-1 rounded-full shadow-lg">
                                        @((design.Similarity.Value * 100).ToString("0.0"))% coincidencia
                                    </div>
                                }

                                <!-- Imagen con efecto de hover y escalado -->
                                <div class="aspect-[4/5] bg-slate-900 rounded-xl overflow-hidden relative border border-slate-800/80 mb-4 flex items-center justify-center">
                                    <img src="@design.PreviewUrl" alt="@design.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
                                    
                                    <!-- Capa interactiva rápida al pasar el cursor (Mockup Preview) -->
                                    <div class="absolute inset-0 bg-slate-950/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center space-x-3">
                                        <button class="p-3 bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 text-white rounded-full transition-all hover:scale-110" title="Previsualizar en Mockup">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </button>
                                        <button @onclick="() => TriggerDownload(design)" class="p-3 bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 text-white rounded-full transition-all hover:scale-110" title="Descargar Directo">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Detalles del Vector -->
                                <div class="flex-1 flex flex-col justify-between">
                                    <div>
                                        <span class="text-[10px] uppercase tracking-wider text-cyan-400 font-bold bg-cyan-950/50 px-2.5 py-0.5 rounded-full">
                                            @design.Category
                                        </span>
                                        <h3 class="text-base font-bold text-white mt-2 line-clamp-1 group-hover:text-cyan-300 transition-colors">
                                            @design.Title
                                        </h3>
                                        <p class="text-xs text-slate-400 mt-1 flex items-center">
                                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                            Vector Editable (.EPS) • 100 MB
                                        </p>
                                    </div>

                                    <!-- Compra o Canje (Sistema Dual Wiforth/Foraes) -->
                                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-800/80">
                                        <div>
                                            <div class="text-xs text-slate-500">Precio / Canje</div>
                                            <div class="flex items-baseline space-x-1.5">
                                                <span class="text-white font-black text-lg">$@design.PriceUsd.ToString("0.00")</span>
                                                <span class="text-[10px] text-slate-400">o</span>
                                                <span class="text-cyan-400 font-bold text-sm">@design.CreditsCost pts</span>
                                            </div>
                                        </div>
                                        
                                        <!-- Botón Comprar / Descargar dependiente de membresía -->
                                        <button @onclick="() => TriggerDownload(design)" 
                                                class="px-4 py-2 bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 font-bold text-xs rounded-xl transition-all shadow-lg">
                                            Descargar
                                        </button>
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code {
    private ElementReference dropZoneElement;
    private bool isDragging = false;
    private bool isAnalyzing = false;
    private bool isLoading = true;
    private string? activeVisualSearchImage;
    private string selectedCategory = "Todos";
    private string sortBy = "recent";

    private List<string> categories = new() { "Todos", "Jersey", "Motocross", "Basketball", "Voleibol", "Concept Kits" };
    private List<DesignItem> allDesigns = new();
    private List<DesignItem> filteredDesigns = new();

    protected override async Task OnInitializedAsync()
    {
        // Simulamos carga inicial de datos desde nuestra base de datos Postgres (Inspirado en nombres de Foraes/Wiforth)
        await Task.Delay(800); 

        allDesigns = new List<DesignItem>
        {
            new("1", "Jersey Argentina World Cup 2026 Special Edition", "jersey-argentina-3", "/img/previews/argentina.jpg", "Jersey", 2.00, 2, DateTime.UtcNow.AddDays(-1)),
            new("2", "Inter Milan Concept Snake Black & Gold", "inter-milan-snake", "/img/previews/inter.jpg", "Concept Kits", 2.00, 2, DateTime.UtcNow.AddDays(-3)),
            new("3", "Motocross Fox Racing Team Concept", "motocross-fox-3", "/img/previews/motocross.jpg", "Motocross", 2.00, 2, DateTime.UtcNow.AddDays(-5)),
            new("4", "Basketball Wolves Dark Grunge Pattern", "basketball-wolves-grunge", "/img/previews/basketball.jpg", "Basketball", 2.00, 2, DateTime.UtcNow.AddDays(-7)),
            new("5", "Voleibol Power Strike Neon Orange", "voleibol-power-strike", "/img/previews/voleibol.jpg", "Voleibol", 2.00, 2, DateTime.UtcNow.AddDays(-10)),
            new("6", "Panama Home Kit World Cup 26 Aero", "panama-homekit-2026", "/img/previews/panama.jpg", "Jersey", 2.00, 2, DateTime.UtcNow.AddDays(-12))
        };

        ApplyFilters();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Inicializar escuchas globales de teclado para pegar capturas (Ctrl+V) con JSInterop
            await JS.InvokeVoidAsync("initializeClipboardPaste", DotNetObjectReference.Create(this));
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        ApplyFilters();
    }

    private int GetCountForCategory(string cat)
    {
        if (cat == "Todos") return allDesigns.Count;
        return allDesigns.Count(d => d.Category == cat);
    }

    private void SortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "recent";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = allDesigns.AsQueryable();

        if (selectedCategory != "Todos")
        {
            query = query.Where(d => d.Category == selectedCategory);
        }

        if (sortBy == "recent") query = query.OrderByDescending(d => d.CreatedAt);
        else if (sortBy == "price-asc") query = query.OrderBy(d => d.PriceUsd);
        else if (sortBy == "price-desc") query = query.OrderByDescending(d => d.PriceUsd);

        filteredDesigns = query.ToList();
    }

    private void ResetFilters()
    {
        selectedCategory = "Todos";
        sortBy = "recent";
        activeVisualSearchImage = null;
        foreach (var d in allDesigns) d.Similarity = null;
        ApplyFilters();
    }

    // GESTIÓN DE CONTROLADORES DE EVENTOS DRAG & DROP
    private void OnDragEnter() => isDragging = true;
    private void OnDragLeave() => isDragging = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isDragging = false;
        var file = e.File;
        if (file == null) return;

        await ProcessVisualSearch(file);
    }

    // Invocado por JavaScript cuando el usuario presiona Ctrl + V
    [JSInvokable]
    public async Task OnPasteImage(string base64Image)
    {
        isAnalyzing = true;
        StateHasChanged();

        // Convertir la captura pegada a visualización en el cliente
        activeVisualSearchImage = base64Image;

        // Simular llamada al endpoint de C# (DesignsController.cs) que procesa ONNX y pgvector
        await Task.Delay(1500); 

        // Simulamos el resultado de similitud de pgvector ordenando nuestros diseños reales
        allDesigns[0].Similarity = 0.985; // Argentina muy parecida
        allDesigns[1].Similarity = 0.812; // Inter Milan
        allDesigns[5].Similarity = 0.650; // Panama

        filteredDesigns = allDesigns
            .Where(d => d.Similarity.HasValue)
            .OrderByDescending(d => d.Similarity)
            .ToList();

        isAnalyzing = false;
        StateHasChanged();
    }

    private async Task ProcessVisualSearch(IBrowserFile file)
    {
        isAnalyzing = true;
        StateHasChanged();

        // Crear una vista preliminar local para la interfaz
        var buffers = new byte[file.Size];
        await file.OpenReadStream().ReadAsync(buffers);
        activeVisualSearchImage = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffers)}";

        // Preparar MultipartFormDataContent para el endpoint C# real
        var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // Max 10MB imagen
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "image", file.Name);

        try
        {
            // Simular petición HTTP a la API C# (/api/designs/visual-search)
            await Task.Delay(1800); 

            // Simulamos asignación de similitud
            allDesigns[2].Similarity = 0.971; // Motocross
            allDesigns[3].Similarity = 0.745; // Basketball

            filteredDesigns = allDesigns
                .Where(d => d.Similarity.HasValue)
                .OrderByDescending(d => d.Similarity)
                .ToList();
        }
        catch (Exception)
        {
            // Manejar errores
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }

    private void ClearVisualSearch()
    {
        activeVisualSearchImage = null;
        foreach (var d in allDesigns) d.Similarity = null;
        ApplyFilters();
    }

    private async Task TriggerDownload(DesignItem design)
    {
        // Llama al endpoint de descarga segura (C# Controller)
        // El servidor validará la membresía del usuario o compras previas.
        // Si es exitoso, devolverá la URL firmada temporal de Cloudflare R2 para descargar el WinRAR de 100MB.
        try
        {
            // Simulamos llamada a /api/designs/{id}/download
            await Task.Delay(400);
            
            // Simulación de URL firmada temporal devuelta por Cloudflare R2
            var tempR2PresignedUrl = $"https://r2.simberdesigns.com/downloads/{design.Slug}.rar?token=8aFh3K9sWd4&expires=1789456200";
            
            await JS.InvokeVoidAsync("open", tempR2PresignedUrl, "_blank");
        }
        catch (Exception)
        {
            // Manejo de errores de suscripción o descargas excedidas
        }
    }

    // Modelo para visualización en el frontend
    public class DesignItem
    {
        public string Id { get; set; }
        public string Title { get; set; }
        public string Slug { get; set; }
        public string PreviewUrl { get; set; }
        public string Category { get; set; }
        public double PriceUsd { get; set; }
        public int CreditsCost { get; set; }
        public DateTime CreatedAt { get; set; }
        public double? Similarity { get; set; } // pgvector similarity output

        public DesignItem(string id, string title, string slug, string previewUrl, string category, double priceUsd, int creditsCost, DateTime createdAt)
        {
            Id = id;
            Title = title;
            Slug = slug;
            PreviewUrl = previewUrl;
            Category = category;
            PriceUsd = priceUsd;
            CreditsCost = creditsCost;
            CreatedAt = createdAt;
        }
    }
}
